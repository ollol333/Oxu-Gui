local function getCharacterData(target)
	local character = target and target.Character
	if not character then return nil, nil, nil end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Torso")
	return character, humanoid, root
end

local function healthColor(humanoid)
	if not humanoid or humanoid.Health <= 0 or humanoid.MaxHealth <= 0 then
		return CFG.HEALTH_BLACK
	end
	local percent = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
	if percent >= 0.5 then
		return CFG.HEALTH_YELLOW:Lerp(CFG.HEALTH_GREEN, (percent - 0.5) / 0.5)
	end
	return CFG.HEALTH_RED:Lerp(CFG.HEALTH_YELLOW, percent / 0.5)
end

local function displayName(target)
	return string.format("%s (@%s)", target.DisplayName, target.Name)
end

local function setMarcSelected(record, isSelected)
	record.selected = isSelected
	record.frame.BackgroundColor3 = isSelected and CFG.SELECTED_COLOR or CFG.NORMAL_COLOR
end

local function anySelection()
	for _, selection in pairs(selectedByList) do
		for target in pairs(selection) do
			if target.Parent then return target end
		end
	end
	return nil
end

local function updateRecord(record)
	local target = record.player
	if not target or not target.Parent then return end

	local nameLabel = record.frame:FindFirstChild("PlayerName", true)
	local avatar = record.frame:FindFirstChild("PlayerAvatar", true)
	local healthFrame = record.frame:FindFirstChild("StatusHealth", true)
	local _, humanoid = getCharacterData(target)

	if nameLabel and nameLabel:IsA("TextLabel") then
		nameLabel.Text = displayName(target)
	end
	if healthFrame and healthFrame:IsA("Frame") then
		healthFrame.BackgroundColor3 = healthColor(humanoid)
	end
	if avatar and avatar:IsA("ImageLabel") and not record.avatarLoaded then
		record.avatarLoaded = true
		task.spawn(function()
			local ok, image = pcall(function()
				return Players:GetUserThumbnailAsync(target.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
			end)
			if ok and avatar.Parent and target.Parent then avatar.Image = image end
		end)
	end
	setMarcSelected(record, selectedByList[record.list][target] == true)
end

local function updateViewport(target)
	if not target or target == LocalPlayer or not target.Parent then
		target = lastSelectedPlayer
	end
	if target == displayedPlayer and target and target.Character then return end
	displayedPlayer = target

	local world = Viewport:FindFirstChildOfClass("WorldModel")
	if not world then
		world = Instance.new("WorldModel")
		world.Name = "PlayerPreviewWorld"
		world.Parent = Viewport
	end
	for _, child in ipairs(world:GetChildren()) do child:Destroy() end

	if not target then return end
	local character = target.Character
	if not character then return end

	local oldArchivable = character.Archivable
	character.Archivable = true
	local ok, clone = pcall(function() return character:Clone() end)
	character.Archivable = oldArchivable
	if not ok or not clone then return end

	for _, descendant in ipairs(clone:GetDescendants()) do
		if descendant:IsA("BaseScript") then
			descendant:Destroy()
		elseif descendant:IsA("Tool") then
			descendant:Destroy()
		elseif descendant:IsA("BasePart") then
			descendant.Anchored = true
			descendant.CanCollide = false
		end
	end
	local humanoid = clone:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	end
	clone:PivotTo(CFrame.new(0, 0, 0))
	clone.Parent = world

	local camera = Viewport:FindFirstChild("PlayerPreviewCamera")
	if not camera then
		camera = Instance.new("Camera")
		camera.Name = "PlayerPreviewCamera"
		camera.FieldOfView = 38
		camera.Parent = Viewport
	end
	Viewport.CurrentCamera = camera

	local boundsCF, boundsSize = clone:GetBoundingBox()
	local center = boundsCF.Position
	local radius = math.max(boundsSize.Magnitude * 0.5, 2)
	camera.CFrame = CFrame.lookAt(center + Vector3.new(0, radius * 0.12, radius * 2.8), center)
end

local function getPreviewTarget()
	if hoveredPlayer and hoveredPlayer.Parent and hoveredPlayer ~= LocalPlayer then
		return hoveredPlayer
	end
	if selectedPlayer and selectedPlayer.Parent then return selectedPlayer end
	if lastSelectedPlayer and lastSelectedPlayer.Parent then return lastSelectedPlayer end
	return nil
end

local function refreshInfo(target)
	if not target or target == LocalPlayer or not target.Parent then
		InfoPlayer.Text = "Player Name: --\n\nWalkSpeed--: --       Status Life: --\n\nHealth-----: --       JumpStatus-: --\n\nJumpHeight-: --       AutoRotate-: --\n\nJumpPower--: --       Collition--: --\n\nPosition---: --\n\nRotation---: --\n\nInServer---: --"
		return
	end

	local _, humanoid, root = getCharacterData(target)
	local walkSpeed = humanoid and tostring(math.floor(humanoid.WalkSpeed * 100 + 0.5) / 100) or "--"
	local health = humanoid and (string.format("%.1f / %.1f", humanoid.Health, humanoid.MaxHealth)) or "--"
	local jumpHeight = humanoid and tostring(math.floor(humanoid.JumpHeight * 100 + 0.5) / 100) or "--"
	local jumpPower = humanoid and tostring(math.floor(humanoid.JumpPower * 100 + 0.5) / 100) or "--"
	local jumpStatus = humanoid and (humanoid:GetStateEnabled(Enum.HumanoidStateType.Jumping) and "Enabled" or "Disabled") or "--"
	local autoRotate = humanoid and tostring(humanoid.AutoRotate) or "--"
	local collidable = "--"
	local position = "--"
	local rotation = "--"
	if root then
		collidable = tostring(root.CanCollide)
		local p = root.Position
		position = string.format("%.1f, %.1f, %.1f", p.X, p.Y, p.Z)
		local _, y, _ = root.CFrame:ToOrientation()
		rotation = string.format("%.1f°", math.deg(y))
	end
	local lifeStatus = "No character"
	if humanoid then
		if humanoid.Health <= 0 then lifeStatus = "Dead"
		elseif humanoid.Health >= humanoid.MaxHealth then lifeStatus = "Full"
		else lifeStatus = "Alive" end
	end

	InfoPlayer.Text = string.format(
		"Player Name: %s (@%s)\n\nWalkSpeed--: %s       Status Life: %s\n\nHealth-----: %s       JumpStatus-: %s\n\nJumpHeight-: %s       AutoRotate-: %s\n\nJumpPower--: %s       Collition--: %s\n\nPosition---: %s\n\nRotation---: %s\n\nInServer---: %s",
		target.DisplayName, target.Name, walkSpeed, lifeStatus, health, jumpStatus, jumpHeight, autoRotate, jumpPower, collidable, position, rotation, target.Parent == Players and "Yes" or "No"
	)
end

local function choosePreview(target)
	hoveredPlayer = target
	local preview = getPreviewTarget()
	if preview ~= displayedPlayer then updateViewport(preview) end
	refreshInfo(preview)
end

local function clearHover(target)
	if hoveredPlayer == target then
		hoveredPlayer = nil
		local preview = getPreviewTarget()
		updateViewport(preview)
		refreshInfo(preview)
	end
end

local function createRecord(list, target)
	if target == LocalPlayer or records[list][target] then return false end
	local frame = templates[list]:Clone()
	frame.Name = "PlayerMarc_" .. target.UserId
	frame.Visible = true
	frame.Parent = list
	frame.BackgroundColor3 = CFG.NORMAL_COLOR
	frame:SetAttribute("OxusGeneratedPlayerMarc", true)

	local clickButton = frame:FindFirstChild("PlayerClick", true)
	if not clickButton or not clickButton:IsA("GuiButton") then
		warn("Falta PlayerClick (TextButton) dentro de " .. frame:GetFullName())
		frame:Destroy()
		return false
	end
	local record = { player = target, list = list, frame = frame, selected = false, avatarLoaded = false }
	records[list][target] = record
	updateRecord(record)

	clickButton.Activated:Connect(function()
		local selection = selectedByList[list]
		if selection[target] then
			selection[target] = nil
			if selectedPlayer == target then
				selectedPlayer = anySelection()
			end
		else
			selection[target] = true
			selectedPlayer = target
			lastSelectedPlayer = target
		end
		for other, otherRecord in pairs(records[list]) do
			setMarcSelected(otherRecord, selection[other] == true)
		end
		local preview = getPreviewTarget()
		updateViewport(preview)
		refreshInfo(preview)
	end)

	frame.MouseEnter:Connect(function() choosePreview(target) end)
	frame.MouseLeave:Connect(function() clearHover(target) end)
	clickButton.MouseEnter:Connect(function() choosePreview(target) end)
	clickButton.MouseLeave:Connect(function() clearHover(target) end)
	return true
end

local function removeRecord(list, target)
	local record = records[list][target]
	if record then
		if record.frame then record.frame:Destroy() end
		records[list][target] = nil
	end
end

local function filterList(list, text)
	local query = string.lower(string.match(text or "", "^%s*(.-)%s*$") or "")
	if query == "all" then query = "" end
	for target, record in pairs(records[list]) do
		local searchable = string.lower(target.Name .. " " .. target.DisplayName)
		record.frame.Visible = query == "" or string.find(searchable, query, 1, true) ~= nil
	end
end

local function rebuildLists()
	if not Seccion1.Visible then return end
	local currentPlayers = {}
	for _, target in ipairs(Players:GetPlayers()) do
		if target ~= LocalPlayer then currentPlayers[target] = true end
	end
	for _, list in ipairs({ PlayersListEffects, PlayersListTp }) do
		local created = false
		for target in pairs(records[list]) do
			if not currentPlayers[target] then removeRecord(list, target) end
		end
		for target in pairs(currentPlayers) do
			if createRecord(list, target) then created = true end
		end
		if created then filterList(list, listBoxes[list].Text) end
	end
	listDirty = false
end

local function isAllText(text)
	local query = string.lower(string.match(text or "", "^%s*(.-)%s*$") or "")
	return query == "all"
end

local function handleListText(list, box)
	filterList(list, box.Text)
	local nowAll = isAllText(box.Text)
	if nowAll == allMode[list] then return end

	local selection = selectedByList[list]
	allMode[list] = nowAll
	if nowAll then
		local snapshot = {}
		for target in pairs(selection) do snapshot[target] = true end
		allSnapshot[list] = snapshot
		for _, target in ipairs(Players:GetPlayers()) do
			if target ~= LocalPlayer then selection[target] = true end
		end
	else
		table.clear(selection)
		for target in pairs(allSnapshot[list]) do
			if target.Parent == Players then selection[target] = true end
		end
		allSnapshot[list] = {}
	end

	selectedPlayer = anySelection()
	if selectedPlayer then lastSelectedPlayer = selectedPlayer end
	for other, otherRecord in pairs(records[list]) do
		setMarcSelected(otherRecord, selection[other] == true)
	end
	local preview = getPreviewTarget()
	updateViewport(preview)
	refreshInfo(preview)
end

PlayerEffectsBox:GetPropertyChangedSignal("Text"):Connect(function()
	handleListText(PlayersListEffects, PlayerEffectsBox)
end)
PlayerTpBox:GetPropertyChangedSignal("Text"):Connect(function()
	handleListText(PlayersListTp, PlayerTpBox)
end)

Players.PlayerAdded:Connect(function(target)
	listDirty = true
	if target == LocalPlayer then return end
	for list, enabled in pairs(allMode) do
		if enabled then selectedByList[list][target] = true end
	end
end)
Players.PlayerRemoving:Connect(function(target)
	listDirty = true
	for _, selection in pairs(selectedByList) do
		selection[target] = nil
	end
	if selectedPlayer == target then selectedPlayer = anySelection() end
	if lastSelectedPlayer == target then lastSelectedPlayer = nil end
	if hoveredPlayer == target then hoveredPlayer = nil end
	if displayedPlayer == target then displayedPlayer = nil end
end)

local function findByName(root, name, className)
	for _, descendant in ipairs(root:GetDescendants()) do
		if descendant.Name == name and descendant:IsA(className) then
			return descendant
		end
	end
	return nil
end

local function findPowersFrame()
	return findByName(Seccion1, "PlayerPowers", "ScrollingFrame") or findByName(Gui, "PlayerPowers", "ScrollingFrame")
end

local powersSearchDone = false

local function bindPowersSearch()
	if powersSearchDone then return end

	local searchBox = findByName(Seccion1, "PlayerPowersSearch", "TextBox") or findByName(Gui, "PlayerPowersSearch", "TextBox")
	local powers = findPowersFrame()
	if not (searchBox and powers) then return end

	powersSearchDone = true

	local function filterPowers()
		local query = string.lower(searchBox.Text)
		query = string.match(query, "^%s*(.-)%s*$")

		for _, frame in ipairs(powers:GetChildren()) do
			if frame:IsA("Frame") then
				if query == "" then
					frame.Visible = true
				else
					local label = frame:FindFirstChild("Name", true)
					local text = ""
					if label and label:IsA("TextLabel") then
						text = string.lower(label.Text)
					end
					frame.Visible = string.find(text, query, 1, true) ~= nil
				end
			end
		end
	end

	searchBox:GetPropertyChangedSignal("Text"):Connect(filterPowers)
	powers.ChildAdded:Connect(function()
		task.defer(filterPowers)
	end)
	filterPowers()
end

