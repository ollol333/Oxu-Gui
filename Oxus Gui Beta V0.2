local bound = setmetatable({}, { __mode = "k" })

function once(instance)
	if not instance or bound[instance] then
		return false
	end
	bound[instance] = true
	return true
end

function findIn(root, name, className)
	if not root then
		return nil
	end
	for _, descendant in ipairs(root:GetDescendants()) do
		if descendant.Name == name and (not className or descendant:IsA(className)) then
			return descendant
		end
	end
	return nil
end

