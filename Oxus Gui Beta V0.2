function bindPower(name, spec)
	local record = State.records[name]

	if not record then
		local powersFrame = find("PlayerPowers", "ScrollingFrame")
		local frame = (powersFrame and findIn(powersFrame, name, "GuiObject")) or find(name, "GuiObject")
		if not frame then
			return false
		end

		local masterButton = findIn(frame, "ButtonActivationClick", "TextButton")
		if not masterButton then
			return false
		end

		record = { frame = frame, container = masterButton.Parent, armed = false, binders = {} }
		State.records[name] = record
		watchPowerTextBoxes(frame)

		ensureMaster(record.container, masterButton)
		record.container:GetAttributeChangedSignal("Activated"):Connect(function()
			onMasterChanged(name)
		end)
	end

	local complete = true
	for role, buttonName in pairs(spec) do
		if not record.binders[role] then
			local button = findIn(record.frame, buttonName, "TextButton")
			if button and once(button) then
				record.binders[role] = makeBinder(name, role, record, button)
			else
				complete = false
			end
		end
	end

	return complete
end

local PROMPT_RED_COLOR = Color3.fromRGB(255, 80, 80)

readPromptKey = function(textBox)
	if not textBox then return Enum.KeyCode.E end
	local keyName = string.upper(string.match(textBox.Text or "", "^%s*(.-)%s*$") or "")
	if keyName == "" then return Enum.KeyCode.E end
	local digitNames = { ["0"] = "Zero", ["1"] = "One", ["2"] = "Two", ["3"] = "Three", ["4"] = "Four", ["5"] = "Five", ["6"] = "Six", ["7"] = "Seven", ["8"] = "Eight", ["9"] = "Nine" }
	local lookupName = digitNames[keyName] or keyName
	local keyCode = nil
	for _, item in ipairs(Enum.KeyCode:GetEnumItems()) do
		if string.upper(item.Name) == string.upper(lookupName) then
			keyCode = item
			break
		end
	end
	if not keyCode or keyCode == Enum.KeyCode.Unknown then return nil end
	local codeName = string.upper(keyCode.Name)
	local allowed = codeName:match("^[A-Z]$") or codeName:match("^ONE$") or codeName:match("^TWO$")
		or codeName:match("^THREE$") or codeName:match("^FOUR$") or codeName:match("^FIVE$")
		or codeName:match("^SIX$") or codeName:match("^SEVEN$") or codeName:match("^EIGHT$")
		or codeName:match("^NINE$") or codeName == "ZERO" or codeName:match("^F%d%d?$")
		or ({ SPACE=true, RETURN=true, ENTER=true, TAB=true, BACKSPACE=true, DELETE=true,
			LEFTSHIFT=true, RIGHTSHIFT=true, LEFTCONTROL=true, RIGHTCONTROL=true,
			LEFTALT=true, RIGHTALT=true, UP=true, DOWN=true, LEFT=true, RIGHT=true,
			INSERT=true, HOME=true, END=true, PAGEUP=true, PAGEDOWN=true,
		})[codeName] == true
	if not allowed then return nil end
	return keyCode
end
State.refreshPromptTeleportPower = function()
	local record = State.records.CreatePromptTpPosition
	if not record then return end
	local enabled = masterOn(record)
