	{ name = "OcultarJugador", kind = "hide" },
	{ name = "AlejarseDelJugador", kind = "avoid" },
	{ name = "HitboxDelJugador", kind = "hitbox" },
	{ name = "InfoView", kind = "info" },
	{ name = "RastroDeJugador", kind = "trail" },
	{ name = "AimMirrow", kind = "aim" },
	{ name = "FollowPlayer", kind = "follow" },
}

local tpRecords = {}
local effectRecords = {}
local effectControllers = {}
local tpPowersDone = false
local effectPowersDone = false
local capturing = nil
local activeLoop = nil
local lastTargetName = ""
local syncEffect


local function getData(name)
	local folder = Gui:WaitForChild("Data")
	return folder:WaitForChild(name)
end


local function setData(name, value)
	local folder = Gui:WaitForChild("Data")
	local item = folder:FindFirstChild(name)

	if not item then
		item = Instance.new("StringValue")
		item.Name = name
		item.Parent = folder
	end

	if item:IsA("StringValue") and item.Value ~= value then
		item.Value = value
	end
end


local function tpBlocked()
	local item = getData("TpVoidActive")
	return item ~= nil and item:IsA("StringValue") and item.Value == "true"
end

local function publishTarget(target)
	local name = target and target.Name or ""
	if name ~= lastTargetName then
		lastTargetName = name
		setData("TpTargetPlayer", name)
	end
end

local function getRoot()
	local character = LocalPlayer.Character
	return character and character:FindFirstChild("HumanoidRootPart") or nil
end

local function getHumanoid()
	local character = LocalPlayer.Character
	return character and character:FindFirstChildOfClass("Humanoid") or nil
end

local function isAlive()
	local humanoid = getHumanoid()
	return humanoid ~= nil and humanoid.Health > 0
end

local function teleportRoot(targetCFrame)
	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then return end
	local pivotOffset = root.CFrame:ToObjectSpace(character:GetPivot())
	character:PivotTo(targetCFrame * pivotOffset)
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
end

local function masterOn(record)
	return record.container:GetAttribute("Activated") == true
end

local function keyLabel(keyCode)
	local ok, text = pcall(function()
		return UserInputService:GetStringForKeyCode(keyCode)
	end)
	if ok and text and text ~= "" then
		return text
	end
	return keyCode.Name
end

local function baseColor(record)
	if not masterOn(record) or not record.key or not record.loop then
		return CFG.WHITE_COLOR
	end
	return record.armed and CFG.GREEN_COLOR or CFG.PINK_COLOR
end

local function colorKey(record, color, instant)
	for _, tween in ipairs(record.tweens) do
		tween:Cancel()
	end
	table.clear(record.tweens)

	if instant then
		record.keyButton.TextColor3 = color
		if record.stroke then
			record.stroke.Color = color
		end
		return
	end

	local textTween = TweenService:Create(record.keyButton, CFG.TWEEN_INFO, { TextColor3 = color })
	textTween:Play()
	table.insert(record.tweens, textTween)

	if record.stroke then
		local strokeTween = TweenService:Create(record.stroke, CFG.TWEEN_INFO, { Color = color })
		strokeTween:Play()
		table.insert(record.tweens, strokeTween)
	end
end

local function refreshKey(record, instant)
	record.flashToken += 1
	if capturing ~= record then
		if record.key then
			record.keyButton.Text = "Keybind: " .. keyLabel(record.key)
		else
			record.keyButton.Text = "Keybind:None"
		end
	end
	colorKey(record, baseColor(record), instant)
end

local function flashKey(record)
	record.flashToken += 1
	local token = record.flashToken
	colorKey(record, CFG.GREEN_COLOR)
	task.delay(CFG.TWEEN_INFO.Time, function()
		if record.flashToken == token then
			colorKey(record, baseColor(record))
		end
	end)
end

local function endCapture(record, newKey, assign)
	capturing = nil
	if assign then
		record.key = newKey
		if record.effect and not newKey and record.armed then
			record.armed = false
			syncEffect(record)
		end
	end
	refreshKey(record)
end

local function sanitizeNumber(text, allowNegative)
	local negative = allowNegative and string.sub(text, 1, 1) == "-"
	local cleaned = string.gsub(text, "[^%d%.]", "")
	local dot = string.find(cleaned, ".", 1, true)
	if dot then
		local rest = string.gsub(string.sub(cleaned, dot + 1), "%.", "")
		cleaned = string.sub(cleaned, 1, dot) .. rest
	end
	return (negative and "-" or "") .. cleaned
end

local function bindNumberBox(box, allowNegative, onChange)
	box:GetPropertyChangedSignal("Text"):Connect(function()
		local cleaned = sanitizeNumber(box.Text, allowNegative)
		if cleaned ~= box.Text then
			box.Text = cleaned
			return
		end
		if onChange then
			onChange()
		end
	end)
end

local function offsetValue(record)
	return tonumber(record.offsetBox.Text) or 0
end

local function radiusValue(record)
	local value = record.radioBox and tonumber(record.radioBox.Text)
	if not value or value <= 0 then
		return 0
	end
	return value
end

local function destroyZone(record)
	if record.zone then
		record.zone:Destroy()
		record.zone = nil
	end
	record.center = nil
end

local function createZone()
	local zone = Instance.new("Part")
	zone.Name = "OxusRadioZone"
	zone.Size = Vector3.new(1, 1, 1)
	zone.Transparency = 1
	zone.CanCollide = false
	zone.CanTouch = false
	zone.CanQuery = false
	zone.CastShadow = false
	zone.Anchored = true

	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "RadioVFX"
	emitter.Rate = 200
	emitter.Lifetime = NumberRange.new(0.5)
	emitter.Brightness = 10
	emitter.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255))
	pcall(function()
		emitter.LightEmission = -5
	end)
	emitter.LightInfluence = 0
	emitter.Texture = "rbxassetid://10927170198"
	emitter.Transparency = NumberSequence.new(0)
	emitter.ZOffset = 1
	emitter.RotSpeed = NumberRange.new(1250)
	emitter.Rotation = NumberRange.new(0, 360)
	emitter.Orientation = Enum.ParticleOrientation.VelocityPerpendicular
	emitter.Speed = NumberRange.new(0.165)
	emitter.SpreadAngle = Vector2.new(-360, 360)
	emitter.Drag = 15
	emitter.Size = NumberSequence.new(1)
	emitter.Parent = zone

	zone.Parent = workspace
	return zone
end

local function updateZone(record)
	local root = getRoot()
	local radius = radiusValue(record)
	if not root or radius <= 0 then
		destroyZone(record)
		return
	end
	record.center = root.Position
	if not record.zone or not record.zone.Parent then
		record.zone = createZone()
	end
	record.zone.CFrame = root.CFrame
	local emitter = record.zone:FindFirstChild("RadioVFX")
	if emitter then
		emitter.Size = NumberSequence.new(radius)
	end
end

local function targetPartFor(target, mode)
	local character = target.Character
	if not character then return nil end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then return nil end
	local root = character:FindFirstChild("HumanoidRootPart")
	if mode == "Torso" then
		return character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso") or root
	end
	if mode == "Head" then
		return character:FindFirstChild("Head") or root
	end
	return root
end

local function inRange(record, targetPosition, destinationPosition)
	local center = record.center
	local radius = radiusValue(record)
	if not center or radius <= 0 then return false end
	if (targetPosition - center).Magnitude > radius then return false end
	if (destinationPosition - center).Magnitude > radius then return false end
	return destinationPosition.Y > workspace.FallenPartsDestroyHeight + CFG.VOID_MARGIN
end

local function pickTarget(record, origin)
	local bestTarget, bestDestination, bestDistance = nil, nil, math.huge
	local offset = offsetValue(record)
	for target in pairs(selectedByList[PlayersListTp]) do
		local part = target.Parent and targetPartFor(target, record.mode)
		if part then
			local destination = part.CFrame * CFrame.new(0, 0, offset)
			if not record.ranged or inRange(record, part.Position, destination.Position) then
				local distance = (part.Position - origin).Magnitude
				if distance < bestDistance then
					bestTarget, bestDestination, bestDistance = target, destination, distance
				end
			end
		end
	end
	return bestTarget, bestDestination
end

local function stepLoop(record)
	local root = getRoot()
	if not root or not isAlive() or tpBlocked() then
		record.lastSet = nil
		return
	end
	if record.ranged and not record.center then
		updateZone(record)
	end

	local current = root.CFrame
	local target, destination = pickTarget(record, root.Position)
	publishTarget(target)

	local moved = record.lastSet == nil or (root.Position - record.lastSet.Position).Magnitude > CFG.DRIFT_LIMIT
	if moved or not destination then
		record.returnCFrame = current
	end

	if destination then
		teleportRoot(destination)
		record.lastSet = destination
	else
		record.lastSet = current
	end
end

local function stopLoop(record, restore)
	if record.connection then
		record.connection:Disconnect()
		record.connection = nil
	end
	if activeLoop == record then
		activeLoop = nil
	end
	if record.ranged then
		destroyZone(record)
	end
	if restore and record.returnCFrame and not tpBlocked() then
		teleportRoot(record.returnCFrame)
	end
	record.returnCFrame = nil
	record.lastSet = nil
	publishTarget(nil)
	setData("TpPowerActive", "")
end

local function startLoop(record)
	activeLoop = record
	record.returnCFrame = nil
	record.lastSet = nil
	if record.ranged then
		if record.radioBox.Text == "" then
			record.radioBox.Text = CFG.DEFAULT_RADIUS
		end
		updateZone(record)
	end
	setData("TpPowerActive", record.name)
	record.connection = RunService.Heartbeat:Connect(function()
		stepLoop(record)
	end)
end

local function syncLoop(record)
	local shouldRun = record.armed and masterOn(record)
	if shouldRun then
		if activeLoop ~= record then
			if activeLoop then
				local other = activeLoop
				other.armed = false
				stopLoop(other, true)
				refreshKey(other)
			end
			startLoop(record)
		end
	elseif activeLoop == record then
		stopLoop(record, true)
	end
end

local function teleportOnce(record)
	local root = getRoot()
	if not root or not isAlive() or tpBlocked() then return end
	local target, destination = pickTarget(record, root.Position)
	publishTarget(target)
	if not destination then return end
	teleportRoot(destination)
	flashKey(record)
end

local function pressKey(record)
	if not masterOn(record) then return end
	if record.effect then
		record.armed = not record.armed
		syncEffect(record)
		refreshKey(record)
	elseif record.loop then
		record.armed = not record.armed
		syncLoop(record)
		refreshKey(record)
	else
		teleportOnce(record)
	end
end

local function onMasterChanged(record)
	if record.effect then
		record.armed = false
		syncEffect(record)
		refreshKey(record)
		return
	end
	if not masterOn(record) then
		record.armed = false
	end
	if record.loop then
		syncLoop(record)
	end
	refreshKey(record)
end

local function bindTpPower(spec)
	if tpRecords[spec.name] then return true end

	local powers = findPowersFrame()
	if not powers then return false end
	local frame = findByName(powers, spec.name, "GuiObject")
	if not frame then return false end

	local master = findByName(frame, "ButtonActivationClick", "TextButton")
	local keyButton = findByName(frame, "KeyBindActivation", "TextButton")
	local mirror = findByName(frame, "ObjectMirrow", "TextButton")
	local offsetBox = findByName(frame, "OffsetDistanceZ", "TextBox")
	local radioBox = spec.ranged and findByName(frame, "Radio", "TextBox") or nil
	if not (master and keyButton and mirror and offsetBox) or (spec.ranged and not radioBox) then
		return false
	end

	local record = {
		name = spec.name,
		loop = spec.loop,
		ranged = spec.ranged,
		frame = frame,
		container = master.Parent,
		keyButton = keyButton,
		stroke = keyButton:FindFirstChildOfClass("UIStroke"),
		offsetBox = offsetBox,
		radioBox = radioBox,
		mode = "Humanoid",
		key = nil,
		armed = false,
		tweens = {},
		flashToken = 0,
	}
	tpRecords[spec.name] = record

	mirror.Text = "Object: Humanoid"
	mirror.Activated:Connect(function()
		record.mode = record.mode == "Humanoid" and "Torso" or "Humanoid"
		mirror.Text = "Object: " .. record.mode
	end)

	bindNumberBox(offsetBox, true)
	if radioBox then
		bindNumberBox(radioBox, false, function()
			if activeLoop == record then
				updateZone(record)
			end
		end)
	end

	keyButton.Activated:Connect(function()
		if capturing == record then
			endCapture(record, nil, false)
			return
		end
		if capturing then
			endCapture(capturing, nil, false)
		end
		capturing = record
		keyButton.Text = "Presiona Una Tecla"
	end)

	record.container:GetAttributeChangedSignal("Activated"):Connect(function()
		onMasterChanged(record)
	end)

	refreshKey(record, true)
	return true
end

local function bindTpPowers()
	if tpPowersDone then return end
	local complete = true
	for _, spec in ipairs(TP_POWERS) do
		if not bindTpPower(spec) then
			complete = false
		end
	end
	tpPowersDone = complete
end

syncEffect = function(record)
	local active = masterOn(record) and record.armed
	if active and not record.running then
		record.running = true
		setData(record.dataName, "true")
		record.controller.start(record)
	elseif not active and record.running then
		record.running = false
		record.controller.stop(record)
		setData(record.dataName, "false")
	end
end

local function releaseAll(record, release)
	for target, state in pairs(record.applied) do
		release(record, target, state)
	end
end

local function syncApplied(record, apply, release, isStale)
	local selection = selectedByList[PlayersListEffects]
	for target, state in pairs(record.applied) do
		if not selection[target]
			or target.Parent ~= Players
			or target.Character ~= state.character
			or (isStale and isStale(state)) then
			release(record, target, state)
		end
	end
	for target in pairs(selection) do
		if target.Parent == Players and not record.applied[target] then
			local character = target.Character
			if character and character.Parent then
				apply(record, target, character)
			end
		end
	end
end

local function playerResources(target)
	local root = ReplicatedStorage:FindFirstChild(CFG.RESOURCES_FOLDER)
	if not root then
		root = Instance.new("Folder")
		root.Name = CFG.RESOURCES_FOLDER
		root.Parent = ReplicatedStorage
	end
	local key = tostring(target.UserId)
	local folder = root:FindFirstChild(key)
	if folder then
		folder:ClearAllChildren()
	else
		folder = Instance.new("Folder")
		folder.Name = key
		folder.Parent = root
	end
	return folder
end

local function isMovable(instance)
	return instance:IsA("Texture")
		or instance:IsA("SurfaceAppearance")
		or instance:IsA("ParticleEmitter")
		or instance:IsA("Trail")
		or instance:IsA("Beam")
		or instance:IsA("Fire")
		or instance:IsA("Smoke")
		or instance:IsA("Sparkles")
		or instance:IsA("Highlight")
		or instance:IsA("Light")
		or instance:IsA("ForceField")
		or instance:IsA("BillboardGui")
		or instance:IsA("SurfaceGui")
end

local function watchHide(state, instance)
	if state.connections[instance] then return end
	state.connections[instance] = instance:GetPropertyChangedSignal("Transparency"):Connect(function()
		local value = instance.Transparency
		if value ~= 1 then
			instance:SetAttribute(CFG.ATTR_HIDE, value)
			instance.Transparency = 1
		end
	end)
end

local function hideInstance(state, instance)
	if instance:GetAttribute(CFG.ATTR_OWNED) or not instance:IsDescendantOf(state.character) then return end
	if isMovable(instance) then
		local slot = Instance.new("Folder")
		slot.Name = "Item"
		local origin = Instance.new("ObjectValue")
		origin.Name = "OxusOrigin"
		origin.Value = instance.Parent
		origin.Parent = slot
		instance.Parent = slot
		slot.Parent = state.folder
	elseif instance:IsA("BasePart") or instance:IsA("Decal") then
		if instance:GetAttribute(CFG.ATTR_HIDE) == nil then
			instance:SetAttribute(CFG.ATTR_HIDE, instance.Transparency)
		end
		instance.Transparency = 1
		watchHide(state, instance)
	end
end

local function hideApply(record, target, character)
	local state = {
		character = character,
		folder = playerResources(target),
		connections = {},
	}
	record.applied[target] = state
	state.added = character.DescendantAdded:Connect(function(descendant)
		hideInstance(state, descendant)
	end)
	for _, descendant in ipairs(character:GetDescendants()) do
		hideInstance(state, descendant)
	end
end

local function hideRelease(record, target, state)
	record.applied[target] = nil
	state.added:Disconnect()
	for _, connection in pairs(state.connections) do
		connection:Disconnect()
	end
	local character = state.character
	if character.Parent then
		for _, descendant in ipairs(character:GetDescendants()) do
			local last = descendant:GetAttribute(CFG.ATTR_HIDE)
			if last ~= nil then
				descendant:SetAttribute(CFG.ATTR_HIDE, nil)
				descendant.Transparency = last
			end
		end
		for _, slot in ipairs(state.folder:GetChildren()) do
			local origin = slot:FindFirstChild("OxusOrigin")
			local parent = origin and origin.Value
			if parent and parent:IsDescendantOf(character) then
				for _, item in ipairs(slot:GetChildren()) do
					if item ~= origin then
						item.Parent = parent
					end
				end
			end
		end
	end
	state.folder:Destroy()
end

local function hideStep(record)
	syncApplied(record, hideApply, hideRelease)
end

effectControllers.hide = {
	start = hideStep,
	step = hideStep,
	stop = function(record)
		releaseAll(record, hideRelease)
	end,
}

local function materialFromName(name)
	local ok, material = pcall(function()
		return Enum.Material[name]
	end)
	return ok and material or nil
end

local function hitboxInRange(value)
	return value >= CFG.HITBOX_MIN and value <= CFG.HITBOX_MAX
end

local function hitboxControl(state, part)
	part:SetAttribute(CFG.ATTR_HITBOX_TRANSPARENCY, part.Transparency)
	part:SetAttribute(CFG.ATTR_HITBOX_COLOR, part.Color)
	part:SetAttribute(CFG.ATTR_HITBOX_MATERIAL, part.Material.Name)
	part.Color = state.color
	part.Material = Enum.Material.ForceField
	part.Transparency = 0
end

local function hitboxClear(part, applyTransparency)
	local last = part:GetAttribute(CFG.ATTR_HITBOX_TRANSPARENCY)
	if last == nil then return end
	local color = part:GetAttribute(CFG.ATTR_HITBOX_COLOR)
	local materialName = part:GetAttribute(CFG.ATTR_HITBOX_MATERIAL)
	local material = materialName and materialFromName(materialName)
	if color then part.Color = color end
	if material then part.Material = material end
	if applyTransparency then
		if part:GetAttribute(CFG.ATTR_HIDE) ~= nil then
			part:SetAttribute(CFG.ATTR_HIDE, last)
		else
			part.Transparency = last
		end
	end
	part:SetAttribute(CFG.ATTR_HITBOX_TRANSPARENCY, nil)
	part:SetAttribute(CFG.ATTR_HITBOX_COLOR, nil)
	part:SetAttribute(CFG.ATTR_HITBOX_MATERIAL, nil)
end

local function hitboxHandle(state, part)
	if part:GetAttribute(CFG.ATTR_HIDE) ~= nil then return end
	local value = part.Transparency
	local controlled = part:GetAttribute(CFG.ATTR_HITBOX_TRANSPARENCY) ~= nil
	if hitboxInRange(value) then
		if controlled then
			part:SetAttribute(CFG.ATTR_HITBOX_TRANSPARENCY, value)
			part.Transparency = 0
		else
			hitboxControl(state, part)
		end
	elseif controlled and value ~= 0 then
		hitboxClear(part, false)
	end
end

local function hitboxWatch(state, part)
	if not state.connections[part] then
		state.connections[part] = part:GetPropertyChangedSignal("Transparency"):Connect(function()
			hitboxHandle(state, part)
		end)
	end
	hitboxHandle(state, part)
end

local function hitboxApply(record, target, character)
	local state = {
		character = character,
		color = Color3.fromHSV(math.random(), 0.8, 1),
		connections = {},
	}
	record.applied[target] = state
	state.added = character.DescendantAdded:Connect(function(descendant)
		if descendant:IsA("BasePart") then
			hitboxWatch(state, descendant)
		end
	end)
	for _, descendant in ipairs(character:GetDescendants()) do
		if descendant:IsA("BasePart") then
			hitboxWatch(state, descendant)
		end
	end
end

local function hitboxRelease(record, target, state)
	record.applied[target] = nil
	state.added:Disconnect()
	for _, connection in pairs(state.connections) do
		connection:Disconnect()
	end
	if state.character.Parent then
		for _, descendant in ipairs(state.character:GetDescendants()) do
			if descendant:IsA("BasePart") then
				hitboxClear(descendant, true)
			end
		end
	end
end

local function hitboxStep(record)
	syncApplied(record, hitboxApply, hitboxRelease)
end

effectControllers.hitbox = {
	start = hitboxStep,
	step = hitboxStep,
	stop = function(record)
		releaseAll(record, hitboxRelease)
	end,
}

local function number1(value)
	return value and string.format("%.1f", value) or "--"
end

local function infoText(target, state)
	local character = state.character
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = state.root
	local camera = workspace.CurrentCamera
	local myRoot = getRoot()
	local tool = character:FindFirstChildOfClass("Tool")
	local position = root.Position
	local rx, ry, rz = root.CFrame:ToOrientation()
	local cameraDistance = camera and (camera.CFrame.Position - position).Magnitude or nil
	local distance = myRoot and (myRoot.Position - position).Magnitude or nil

	local health = "--"
	local jumpHeight = "--"
	local jumpPower = "--"
	local autoRotate = "--"
	local jumpStatus = "--"
	local walkSpeed = "--"
	local stateName = "--"
	if humanoid then
		health = string.format("%.1f / %.1f", humanoid.Health, humanoid.MaxHealth)
		jumpHeight = number1(humanoid.JumpHeight)
