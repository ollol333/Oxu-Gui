end

function guiOrigin()
	local topLeft, bottomRight = GuiService:GetGuiInset()
	local camera = workspace.CurrentCamera
	local size = gui.AbsoluteSize
	if not camera or size.X <= 0 or size.Y <= 0 then
		return topLeft
	end
	local viewportSize = camera.ViewportSize
	local diffX = viewportSize.X - size.X
	local diffY = viewportSize.Y - size.Y
	local x = diffX > 0.5 and math.min(topLeft.X, diffX) or 0
	local y = diffY > 0.5 and math.max(diffY - bottomRight.Y, 0) or 0
	return Vector2.new(x, y)
end

function rawPoint(input)
	if input.UserInputType == Enum.UserInputType.Touch then
		local topLeft = GuiService:GetGuiInset()
		return Vector2.new(input.Position.X, input.Position.Y) + topLeft
	end
	return UserInputService:GetMouseLocation()
end

function toPoint(input, shift)
	return rawPoint(input) - shift
end

local learnedDelta = nil

function resolveShift(input, handles)
	local base = guiOrigin()
	if learnedDelta then
		return base + learnedDelta
	end

	local inset = GuiService:GetGuiInset()
	local candidates = { base, Vector2.zero, inset, Vector2.new(0, inset.Y * 2) }
	local raw = rawPoint(input)

	local ordered = {}
	for _, handle in ipairs(handles) do
		if handle.AbsoluteSize.X > 0 and handle.AbsoluteSize.Y > 0 then
			table.insert(ordered, handle)
		end
	end
	table.sort(ordered, function(a, b)
		return a.AbsoluteSize.X * a.AbsoluteSize.Y < b.AbsoluteSize.X * b.AbsoluteSize.Y
	end)

	for _, handle in ipairs(ordered) do
		local minimum = handle.AbsolutePosition
		local maximum = minimum + handle.AbsoluteSize
		local matches = {}
		for _, shift in ipairs(candidates) do
			local point = raw - shift
			if point.X >= minimum.X and point.X <= maximum.X and point.Y >= minimum.Y and point.Y <= maximum.Y then
				table.insert(matches, shift)
			end
		end
		if #matches > 0 then
			if table.find(matches, base) then
				return base
			end
			if #matches == 1 then
				learnedDelta = matches[1] - base
				return matches[1]
			end
		end
	end

	return base
end

function lockHandle(object)
	if not object then
		return
	end
	pcall(function()
		object.Draggable = false
	end)
	for _, child in ipairs(object:GetChildren()) do
		if child:IsA("UIDragDetector") then
			child.Enabled = false
		end
	end
end

function bindDrag(handles, onMove, onEnd, region)
	local dragging = false
	local shift = Vector2.zero

	local function isPointer(input)
		return input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
	end

	for _, handle in ipairs(handles) do
		handle.InputBegan:Connect(function(input)
			if isPointer(input) then
				local began = not dragging
				if began then
					shift = resolveShift(input, handles)
					dragging = true
				end
				onMove(toPoint(input, shift), input, began)
			end
		end)
	end

	if region then
		UserInputService.InputBegan:Connect(function(input)
			if dragging or not isPointer(input) then
				return
			end
			local candidateShift = resolveShift(input, handles)
			local candidate = toPoint(input, candidateShift)
			if region(candidate) then
				shift = candidateShift
				dragging = true
				onMove(candidate, input, true)
			end
		end)
	end

	UserInputService.InputChanged:Connect(function(input)
		if dragging
			and (input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch)
		then
			onMove(toPoint(input, shift), input, false)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if dragging and isPointer(input) then
			dragging = false
			if onEnd then
				onEnd()
			end
		end
	end)
end

local viewport = nil
local viewportHost = nil
local viewerCamera = nil
local viewerClone = nil
local viewerParts = {}
local viewerRadius = 4
local viewerCenter = Vector3.zero
local viewerShown = nil
local viewerNeedsBuild = true
local viewerBuilding = false
local orbitYaw = math.pi
local orbitPitch = 0
local orbitDragging = false
local orbitStart = Vector2.zero
local orbitStartYaw = 0
local orbitStartPitch = 0
local syncQueued = false

function refreshViewerBounds()
	if not viewerClone then
		return
	end
	local cframe, size = viewerClone:GetBoundingBox()
	viewerCenter = cframe.Position
	viewerRadius = math.max(size.Magnitude / 2, 1)
end

function syncViewer()
	if not (viewerClone and character) or viewerShown == false then
		return
	end
	for name, clonePart in pairs(viewerParts) do
		local real = character:FindFirstChild(name)
		if real and real:IsA("BasePart") then
			clonePart.Transparency = real.Transparency
			clonePart.Color = real.Color
			clonePart.Material = real.Material
		end
	end
	local ok, scale = pcall(function()
		return character:GetScale()
	end)
	if ok and math.abs(viewerClone:GetScale() - scale) > 1e-3 then
		pcall(function()
			viewerClone:ScaleTo(scale)
		end)
		refreshViewerBounds()
	end
end

queueSync = function()
	if syncQueued then
		return
	end
	syncQueued = true
	task.defer(function()
		syncQueued = false
		syncViewer()
	end)
end

function watchCharacterVisuals(char)
	for _, child in ipairs(char:GetChildren()) do
		if child:IsA("BasePart") and once(child) then
			for _, prop in ipairs({ "Transparency", "Color", "Material" }) do
				child:GetPropertyChangedSignal(prop):Connect(queueSync)
			end
		end
	end
end

function buildViewer(char)
	if character ~= char or not char.Parent or not viewport then
		return
	end

	if viewerClone then
		viewerClone:Destroy()
		viewerClone = nil
	end
	table.clear(viewerParts)

	char.Archivable = true
	local clone = char:Clone()
	if not clone then
		viewerNeedsBuild = false
		return
	end

	for _, descendant in ipairs(clone:GetDescendants()) do
		if descendant:IsA("BaseScript") then
			descendant:Destroy()
		end
	end

	local cloneHumanoid = clone:FindFirstChildOfClass("Humanoid")
	if cloneHumanoid then
		cloneHumanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		cloneHumanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	end

	for _, child in ipairs(clone:GetChildren()) do
		if child:IsA("BasePart") then
			child.Anchored = true
			viewerParts[child.Name] = child
		end
	end

	clone:PivotTo(CFrame.new(0, 0, 0))
	clone.Parent = viewport
	viewerClone = clone
	viewerNeedsBuild = false

	refreshViewerBounds()
	watchCharacterVisuals(char)
	syncViewer()
end

function bindViewport()
	if viewport then
		return
	end

	local found = find("Player", "ViewportFrame")
	if not found then
		return
	end

	viewport = found
	viewportHost = found.Parent
	viewport.Active = true

	viewerCamera = Instance.new("Camera")
	viewerCamera.FieldOfView = 40
	viewerCamera.Parent = viewport
	viewport.CurrentCamera = viewerCamera

	bindDrag({ viewport }, function(point, _, began)
		if began then
			orbitDragging = true
			orbitStart = point
			orbitStartYaw = orbitYaw
			orbitStartPitch = orbitPitch
			return
		end

		local delta = point - orbitStart
		local width = math.max(viewport.AbsoluteSize.X, 1)
		local height = math.max(viewport.AbsoluteSize.Y, 1)

		orbitYaw = orbitStartYaw - delta.X * (math.pi * 2 / width)
		orbitPitch = math.clamp(orbitStartPitch - delta.Y * (math.pi / height), -1.4, 1.4)
	end, function()
		orbitDragging = false
	end)

	RunService.RenderStepped:Connect(function(deltaTime)
		local shown = isShown(viewportHost)

		if shown ~= viewerShown then
			viewerShown = shown
			if shown then
				syncViewer()
			end
		end

		if not shown then
			return
		end

		if viewerNeedsBuild and not viewerBuilding and character then
			viewerBuilding = true
			local char = character
			task.spawn(function()
				buildViewer(char)
				viewerBuilding = false
			end)
		end

		if not viewerClone then
			return
		end

		if not orbitDragging then
			orbitYaw = orbitYaw + deltaTime * (math.pi * 2 / 5)
		end

		local size = viewport.AbsoluteSize
		local aspect = size.X / math.max(size.Y, 1)
		local halfFov = math.rad(viewerCamera.FieldOfView / 2)
		local effective = math.atan(math.tan(halfFov) * math.min(aspect, 1))
		local distance = viewerRadius / math.sin(math.max(effective, 0.05))

		viewerCamera.CFrame = CFrame.new(viewerCenter)
			* CFrame.Angles(0, orbitYaw, 0)
			* CFrame.Angles(orbitPitch, 0, 0)
			* CFrame.new(0, 0, distance)
	end)
end

function toggleText(label, state, value)
	if state == "override" then
		return label .. ": " .. (value and "True" or "False")
	elseif state == "default" then
		return label .. ": Default " .. (value and "T" or "F")
	elseif state == "variable" then
		return label .. ": Variable"
	end
	return label .. ": -"
end

function computeToggleState(parts, prop)
	if #parts == 0 then
		return "none", nil
	end

	local allActive = true
	local equal = true
	local firstValue = nil

	for index, part in ipairs(parts) do
		local entry = getEntry(part, prop)
		local value = readProp(part, prop) == true
		if index == 1 then
			firstValue = value
		elseif value ~= firstValue then
			equal = false
		end
		if not entry.active then
			allActive = false
		end
	end

	if allActive and equal then
		return "override", firstValue
	end
	if equal then
		return "default", firstValue
	end
	return "variable", nil
end

function overrideValue(targets, prop)
	if #targets == 0 then
		return nil
	end
	local first = nil
	for index, target in ipairs(targets) do
		local entry = getEntry(target, prop)
		if not entry.active then
			return nil
		end
		local value = readProp(target, prop)
		if type(value) ~= "number" then
			return nil
		end
		if index == 1 then
			first = value
		elseif math.abs(value - first) > 1e-4 then
			return nil
		end
	end
	return first
end

function formatNumber(value)
	return tostring(math.round(value * 1000) / 1000)
end

function refreshJumpMode()
	if not humanoid then
		return
	end
	local powerActive = getEntry(humanoid, "JumpPower").active
	local heightActive = getEntry(humanoid, "JumpHeight").active
	if powerActive and not heightActive then
		setOverride(humanoid, "UseJumpPower", true)
	elseif heightActive and not powerActive then
		setOverride(humanoid, "UseJumpPower", false)
	elseif not powerActive and not heightActive then
		clearOverride(humanoid, "UseJumpPower")
	end
end

function applyNumeric(name, value)
	if name == "Transparency" then
		local clamped = value and math.clamp(value, 0, 1) or nil
		local parts = selectedParts()
		if #parts == 0 then
			warn("[OxusGui] Transparency: no hay partes seleccionadas o no se encontraron en el personaje")
		end
		for _, part in ipairs(parts) do
			setOrClear(part, "Transparency", clamped)
		end
	elseif name == "Speed" and humanoid then
		setOrClear(humanoid, "WalkSpeed", value)
	elseif name == "JumpPower" and humanoid then
		setOrClear(humanoid, "JumpPower", value)
		if value then
			setOverride(humanoid, "UseJumpPower", true)
		else
			refreshJumpMode()
		end
	elseif name == "Jump" and humanoid then
		setOrClear(humanoid, "JumpHeight", value)
		if value then
			setOverride(humanoid, "UseJumpPower", false)
		else
			refreshJumpMode()
		end
	elseif name == "Scale" and character then
		setOrClear(character, "Scale", value)
	end
	queueSync()
end

function sanitizeNumber(text)
	local cleaned = string.gsub(text, "[^%d%.]", "")
	local firstDot = string.find(cleaned, ".", 1, true)
	if firstDot then
		local rest = string.gsub(string.sub(cleaned, firstDot + 1), "%.", "")
		cleaned = string.sub(cleaned, 1, firstDot) .. rest
	end
	return cleaned
end

local colorState = { angle = 0, sat = 0, value = 1 }

function angleToHue(angle)
	angle = angle % 360
	for index = 1, #HUE_STOPS - 1 do
		local a1, h1 = HUE_STOPS[index][1], HUE_STOPS[index][2]
		local a2, h2 = HUE_STOPS[index + 1][1], HUE_STOPS[index + 1][2]
		if angle >= a1 and angle <= a2 then
			return (h1 + (h2 - h1) * (angle - a1) / (a2 - a1)) % 360
		end
	end
	return 0
end

function hueToAngle(hue)
	hue = hue % 360
	for index = 1, #HUE_STOPS - 1 do
		local a1, h1 = HUE_STOPS[index][1], HUE_STOPS[index][2]
		local a2, h2 = HUE_STOPS[index + 1][1], HUE_STOPS[index + 1][2]
		if hue <= h1 and hue >= h2 then
			return (a1 + (h1 - hue) / (h1 - h2) * (a2 - a1)) % 360
		end
	end
	return 0
end

function colorFromState()
	return Color3.fromHSV(angleToHue(colorState.angle) / 360, colorState.sat, colorState.value)
end

function setStateFromColor(color)
	local h, s, v = color:ToHSV()
	colorState.value = v
	if v > 0.001 then
		colorState.sat = s
		if s > 0.001 then
			colorState.angle = hueToAngle(h * 360)
		end
	end
end

function parseHex(text)
	local hex = string.gsub(text, "[#%s]", "")
	if #hex == 3 then
		hex = string.rep(string.sub(hex, 1, 1), 2)
			.. string.rep(string.sub(hex, 2, 2), 2)
			.. string.rep(string.sub(hex, 3, 3), 2)
	end
	if #hex ~= 6 or not string.match(hex, "^%x+$") then
		return nil
	end
	return Color3.fromHex(hex)
end

local diagramFrames = {}
local toggleButtons = {}
local numericBoxes = {}
local materialButtons = {}
local paletteImage = nil
local paletteButton = nil
local toneFrame = nil
local toneBar = nil
local redBox = nil
local greenBox = nil
local blueBox = nil
local hexBox = nil

function placeAt(object, point)
	local parent = object.Parent
	if parent and parent:IsA("GuiObject") and parent.AbsoluteSize.X > 0 and parent.AbsoluteSize.Y > 0 then
		local origin = parent.AbsolutePosition
		local size = parent.AbsoluteSize
		object.Position = UDim2.fromScale((point.X - origin.X) / size.X, (point.Y - origin.Y) / size.Y)
	else
		object.Position = UDim2.fromOffset(point.X, point.Y)
	end
end

function paletteGeometry()
	local size = paletteImage.AbsoluteSize
	local center = paletteImage.AbsolutePosition + size / 2
	local radius = math.max(math.min(size.X, size.Y) / 2, 1)
	return center, radius
end

function placePalette()
	if not (paletteImage and paletteButton) then
		return
	end
	local center, radius = paletteGeometry()
	local radians = math.rad(colorState.angle)
	local distance = colorState.sat * radius
	placeAt(paletteButton, center + Vector2.new(math.cos(radians) * distance, -math.sin(radians) * distance))
end

function placeBar()
	if not (toneFrame and toneBar) then
		return
	end
	local position = toneFrame.AbsolutePosition
	local size = toneFrame.AbsoluteSize
	placeAt(toneBar, Vector2.new(position.X + size.X / 2, position.Y + size.Y * (1 - colorState.value)))
end

function setBoxText(box, text)
	if box and not box:IsFocused() then
		box.Text = text
	end
end

function updateColorBoxes(color)
	setBoxText(redBox, tostring(math.round(color.R * 255)))
	setBoxText(greenBox, tostring(math.round(color.G * 255)))
	setBoxText(blueBox, tostring(math.round(color.B * 255)))
	setBoxText(hexBox, "#" .. color:ToHex())
end

function applyColorToSelection(color)
	for _, part in ipairs(selectedParts()) do
		setOverride(part, "Color", color)
	end
	queueSync()
end

function pushColor()
	local color = colorFromState()
	applyColorToSelection(color)
	updateColorBoxes(color)
end

function applyExactColor(color)
	setStateFromColor(color)
	placePalette()
	placeBar()
	applyColorToSelection(color)
	updateColorBoxes(color)
end

function refreshColor()
	local color = Color3.new(1, 1, 1)
	local group = selectionOrder[#selectionOrder]
	if group then
		local parts = groupParts(group)
		if parts[1] then
			color = parts[1].Color
		end
	end
	setStateFromColor(color)
	placePalette()
	placeBar()
	updateColorBoxes(color)
end

function refreshMaterials()
	local current = nil
	local group = selectionOrder[#selectionOrder]
	if group then
		local parts = groupParts(group)
		if parts[1] then
			current = parts[1].Material
		end
	end
	for _, item in ipairs(materialButtons) do
		item.button.BackgroundTransparency = (current and item.material == current) and 0.8 or 1
	end
end

function applyGroupVisual(groupName)
	local frame = diagramFrames[groupName]
	if not frame then
		return
	end
	local selected = table.find(selectionOrder, groupName) ~= nil
	local target = selected and GROUP_SELECTED_TRANSPARENCY or GROUP_DESELECTED_TRANSPARENCY
	if frame.BackgroundTransparency ~= target then
		frame.BackgroundTransparency = target
	end
end

function refreshDiagram()
	for groupName in pairs(diagramFrames) do
		applyGroupVisual(groupName)
	end
end

refreshAll = function()
	local parts = selectedParts()

	for _, toggle in ipairs(toggleButtons) do
		local state, value = computeToggleState(parts, toggle.prop)
		toggle.button.Text = toggleText(toggle.label, state, value)
	end

	local function setNumeric(name, value)
		local text = value and formatNumber(value) or ""
		for _, box in ipairs(numericBoxes[name] or {}) do
			setBoxText(box, text)
		end
	end

	setNumeric("Transparency", overrideValue(parts, "Transparency"))
	setNumeric("Speed", humanoid and overrideValue({ humanoid }, "WalkSpeed") or nil)
	setNumeric("JumpPower", humanoid and overrideValue({ humanoid }, "JumpPower") or nil)
	setNumeric("Jump", humanoid and overrideValue({ humanoid }, "JumpHeight") or nil)
	setNumeric("Scale", character and overrideValue({ character }, "Scale") or nil)

	refreshDiagram()
	refreshMaterials()
	refreshColor()
end

local lastGroupToggle = {}

function toggleGroup(groupName)
	local now = os.clock()
	if lastGroupToggle[groupName] and now - lastGroupToggle[groupName] < 0.05 then
		return
	end
	lastGroupToggle[groupName] = now

	local index = table.find(selectionOrder, groupName)
	if index then
		table.remove(selectionOrder, index)
	else
		table.insert(selectionOrder, groupName)
	end
	dataSelectedGroups.Value = table.concat(selectionOrder, ",")
	refreshAll()
end

function bindGroupButton(groupName, instance)
	if not instance:IsA("GuiButton") or not once(instance) then
		return
	end
	instance.Activated:Connect(function()
		toggleGroup(groupName)
	end)
end

function bindGroupFrame(groupName, frame)
	diagramFrames[groupName] = frame

	local fallback = nil
	local hasButton = false

	if frame:IsA("GuiButton") then
		hasButton = true
		bindGroupButton(groupName, frame)
	end

	for _, descendant in ipairs(frame:GetDescendants()) do
		if descendant:IsA("GuiButton") then
			hasButton = true
			bindGroupButton(groupName, descendant)
		end
	end

	if not hasButton then
		frame.Active = true
		fallback = frame.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch
			then
				toggleGroup(groupName)
			end
		end)
	end

	frame.DescendantAdded:Connect(function(descendant)
		if descendant:IsA("GuiButton") then
			bindGroupButton(groupName, descendant)
			if fallback then
				fallback:Disconnect()
				fallback = nil
			end
		end
	end)

	frame:GetPropertyChangedSignal("BackgroundTransparency"):Connect(function()
		applyGroupVisual(groupName)
	end)

	applyGroupVisual(groupName)
end

function hasGuiButton(object)
	if object:IsA("GuiButton") then
		return true
	end
	for _, descendant in ipairs(object:GetDescendants()) do
		if descendant:IsA("GuiButton") then
			return true
		end
	end
	return false
end

function findGroupFrame(roots, groupName)
	local fallback = nil
	for _, root in ipairs(roots) do
		for _, descendant in ipairs(root:GetDescendants()) do
			if descendant.Name == groupName and descendant:IsA("GuiObject") then
				if hasGuiButton(descendant) then
					return descendant
				end
				fallback = fallback or descendant
			end
		end
	end
	return fallback
end

function findDiagram()
	local exact = find("PlayerDiagrama", "GuiObject")
	if exact then
		return exact
	end
	for _, descendant in ipairs(gui:GetDescendants()) do
		if descendant:IsA("GuiObject") then
			local lowered = string.lower(descendant.Name)
			if string.find(lowered, "diagram", 1, true) or string.find(lowered, "diabram", 1, true) then
				return descendant
			end
		end
	end
	return nil
end

local diagramDone = false

function bindDiagram()
	if diagramDone then
		return
	end

	local diagram = findDiagram()
	local roots = diagram and { diagram, gui } or { gui }
	local complete = true

	for _, groupName in ipairs(GROUP_ORDER) do
		if not diagramFrames[groupName] then
			local frame = findGroupFrame(roots, groupName)
			if frame then
				bindGroupFrame(groupName, frame)
			else
				complete = false
			end
		end
	end

	diagramDone = complete
end

local togglesBound = {}
local togglesDone = false

function bindToggles()
	if togglesDone then
		return
	end

	local complete = true

	for _, toggle in ipairs(TOGGLES) do
		if not togglesBound[toggle.name] then
			local button = find(toggle.name, "TextButton")
			if button and once(button) then
				togglesBound[toggle.name] = true
				table.insert(toggleButtons, { button = button, prop = toggle.prop, label = toggle.label })

				button.Activated:Connect(function()
					local parts = selectedParts()
					if #parts == 0 then
						return
					end

					local state, value = computeToggleState(parts, toggle.prop)
					if state == "override" and value == true then
						for _, part in ipairs(parts) do
							setOverride(part, toggle.prop, false)
						end
					elseif state == "override" and value == false then
						for _, part in ipairs(parts) do
							clearOverride(part, toggle.prop)
						end
					else
						for _, part in ipairs(parts) do
							setOverride(part, toggle.prop, true)
						end
					end

					refreshAll()
				end)
			else
				complete = false
			end
		end
	end

	togglesDone = complete
end

function classifyBox(box)
	local levels = { box.Name }
	local parent = box.Parent
	if parent then
		table.insert(levels, parent.Name)
		if parent.Parent then
			table.insert(levels, parent.Parent.Name)
		end
	end
	if box.PlaceholderText ~= "" then
		table.insert(levels, box.PlaceholderText)
	end

	for _, text in ipairs(levels) do
		local lowered = string.lower(text)
		local best = nil
		for _, target in ipairs(NUMERIC_BOXES) do
			local targetLowered = string.lower(target)
			if string.sub(lowered, 1, #targetLowered) == targetLowered and (not best or #target > #best) then
				best = target
			end
		end
		if best then
			return best
		end
	end

	return nil
end

function bindNumericBox(name, box)
	numericBoxes[name] = numericBoxes[name] or {}
	table.insert(numericBoxes[name], box)

	box:GetPropertyChangedSignal("Text"):Connect(function()
		local cleaned = sanitizeNumber(box.Text)
		if cleaned ~= box.Text then
			box.Text = cleaned
			return
		end
		if name == "Transparency" and box:IsFocused() then
			local value = tonumber(cleaned)
			if value then
				applyNumeric(name, value)
			end
		end
	end)

	box.FocusLost:Connect(function()
		local text = box.Text
		if text == "" then
			applyNumeric(name, nil)
		else
			local value = tonumber(text)
			if value then
				applyNumeric(name, value)
			end
		end
		refreshAll()
		if queueSavePlayerSettings then queueSavePlayerSettings() end
	end)
end

local numericDone = false

function bindNumerics()
	if numericDone then
		return
	end

	for _, descendant in ipairs(gui:GetDescendants()) do
		if descendant:IsA("TextBox") and not bound[descendant] then
			local name = classifyBox(descendant)
			if name and once(descendant) then
				bindNumericBox(name, descendant)
			end
		end
	end

	local complete = true
	for _, name in ipairs(NUMERIC_BOXES) do
		if not numericBoxes[name] then
			complete = false
		end
	end

	numericDone = complete
end

local materialsDone = false

function bindMaterials()
	if materialsDone then
		return
	end

	local materialLabel = find("MaterialSeccion", "TextLabel")
	if not materialLabel then
		return
	end

	local template = findIn(materialLabel, "MaterialButton1", "TextButton")
	if not template then
		return
	end

	materialsDone = true

	local container = template.Parent

	for _, descendant in ipairs(materialLabel:GetDescendants()) do
		if descendant:IsA("TextButton") and descendant ~= template and not descendant:IsDescendantOf(template) then
			descendant:Destroy()
		end
	end

	local materials = Enum.Material:GetEnumItems()
	table.sort(materials, function(a, b)
		return a.Name < b.Name
	end)

	for index, material in ipairs(materials) do
		local button = index == 1 and template or template:Clone()
		button.Name = "MaterialButton" .. index
		button.Text = material.Name
		button.LayoutOrder = index
		button.Visible = true
		button.BackgroundTransparency = 1
		button.Parent = container

		table.insert(materialButtons, { button = button, material = material })

		button.Activated:Connect(function()
			local group = selectionOrder[#selectionOrder]
			if not group then
				return
			end
			local parts = groupParts(group)
			if #parts == 0 then
				return
			end

			local entry = getEntry(parts[1], "Material")
			if parts[1].Material == material then
				if entry.active then
					for _, part in ipairs(parts) do
						clearOverride(part, "Material")
					end
				end
			else
				for _, part in ipairs(parts) do
					setOverride(part, "Material", material)
				end
			end

			queueSync()
			refreshAll()
		end)
	end
end

function bindChannel(box, channel)
	box:GetPropertyChangedSignal("Text"):Connect(function()
		local cleaned = string.sub(string.gsub(box.Text, "%D", ""), 1, 3)
		if cleaned ~= box.Text then
			box.Text = cleaned
		end
	end)

	box.FocusLost:Connect(function()
		local current = colorFromState()
		local value = tonumber(box.Text)
		if not value then
			updateColorBoxes(current)
			return
		end

		value = math.clamp(math.floor(value), 0, 255)
		local r = math.round(current.R * 255)
		local g = math.round(current.G * 255)
		local b = math.round(current.B * 255)

		if channel == "R" then
			r = value
		elseif channel == "G" then
			g = value
		else
			b = value
		end

		applyExactColor(Color3.fromRGB(r, g, b))
	end)
end

local colorDone = false

function bindColor()
	if colorDone then
		return
	end

	local colorFrame = find("Marc", "GuiObject")
	if not colorFrame then
		return
	end

	paletteImage = paletteImage or findIn(colorFrame, "Color_PaleteImage", "GuiObject")
	paletteButton = paletteButton
		or (paletteImage and findIn(paletteImage, "ButtonPalete", "GuiObject"))
		or findIn(colorFrame, "ButtonPalete", "GuiObject")
	toneFrame = toneFrame or findIn(colorFrame, "Tonal_Bar", "GuiObject")
	toneBar = toneBar or (toneFrame and findIn(toneFrame, "Bar", "GuiObject"))
	redBox = redBox or findIn(colorFrame, "Color_Red", "TextBox")
	greenBox = greenBox or findIn(colorFrame, "Color_Green", "TextBox")
	blueBox = blueBox or findIn(colorFrame, "Color_Blue", "TextBox")
	hexBox = hexBox or findIn(colorFrame, "Color_HTML", "TextBox")

	if paletteImage and paletteButton and once(paletteButton) then
		lockHandle(paletteButton)
		lockHandle(paletteImage)
		paletteButton.AnchorPoint = Vector2.new(0.5, 0.5)
		paletteImage.Active = true
		paletteButton.Active = true

		bindDrag({ paletteImage, paletteButton }, function(point)
			local center, radius = paletteGeometry()
			local offset = point - center
			local distance = offset.Magnitude

			if distance > 0.001 then
				colorState.angle = math.deg(math.atan2(-offset.Y, offset.X)) % 360
			end
			colorState.sat = math.clamp(distance / radius, 0, 1)

			placePalette()
			pushColor()
		end, nil, function(point)
			if not isShown(paletteImage) then
				return false
			end
			local center, radius = paletteGeometry()
			return (point - center).Magnitude <= radius * 1.02
		end)

		paletteImage:GetPropertyChangedSignal("AbsoluteSize"):Connect(placePalette)
		paletteImage:GetPropertyChangedSignal("AbsolutePosition"):Connect(placePalette)
		placePalette()
	end

	if toneFrame and toneBar and once(toneBar) then
		lockHandle(toneBar)
		lockHandle(toneFrame)
		toneBar.AnchorPoint = Vector2.new(0.5, 0.5)
		toneFrame.Active = true
		toneBar.Active = true

		bindDrag({ toneFrame, toneBar }, function(point)
			local top = toneFrame.AbsolutePosition.Y
			local height = math.max(toneFrame.AbsoluteSize.Y, 1)
			local relative = math.clamp((point.Y - top) / height, 0, 1)

			colorState.value = 1 - relative

			placeBar()
			pushColor()
		end, nil, function(point)
			if not isShown(toneFrame) then
				return false
			end
			local minimum = toneFrame.AbsolutePosition
			local maximum = minimum + toneFrame.AbsoluteSize
			return point.X >= minimum.X and point.X <= maximum.X and point.Y >= minimum.Y and point.Y <= maximum.Y
		end)

		toneFrame:GetPropertyChangedSignal("AbsoluteSize"):Connect(placeBar)
		toneFrame:GetPropertyChangedSignal("AbsolutePosition"):Connect(placeBar)
		placeBar()
	end

	if redBox and once(redBox) then
		bindChannel(redBox, "R")
	end
	if greenBox and once(greenBox) then
		bindChannel(greenBox, "G")
	end
	if blueBox and once(blueBox) then
		bindChannel(blueBox, "B")
	end

	if hexBox and once(hexBox) then
		hexBox:GetPropertyChangedSignal("Text"):Connect(function()
			local cleaned = string.sub(string.gsub(hexBox.Text, "[^#%x]", ""), 1, 7)
			if cleaned ~= hexBox.Text then
				hexBox.Text = cleaned
			end
		end)

		hexBox.FocusLost:Connect(function()
			local color = parseHex(hexBox.Text)
			if color then
				applyExactColor(color)
			else
				updateColorBoxes(colorFromState())
			end
		end)
	end

	colorDone = paletteImage ~= nil
		and paletteButton ~= nil
		and toneFrame ~= nil
		and toneBar ~= nil
		and redBox ~= nil
		and greenBox ~= nil
		and blueBox ~= nil
		and hexBox ~= nil
end

local searchDone = false

function bindSearch()
	if searchDone then
		return
	end

	local searchBox = find("PlayerPowersSearch", "TextBox")
	local powers = find("PlayerPowers", "ScrollingFrame")
	if not (searchBox and powers) then
		return
	end

	searchDone = true

	local function filterPowers()
		local query = string.lower(searchBox.Text)
		query = string.match(query, "^%s*(.-)%s*$")

		for _, frame in ipairs(powers:GetChildren()) do
			if frame:IsA("Frame") then
				if query == "" then
					frame.Visible = true
				else
					local label = frame:FindFirstChild("Name", true)
					local text = ""
					if label and label:IsA("TextLabel") then
						text = string.lower(label.Text)
					end
					frame.Visible = string.find(text, query, 1, true) ~= nil
				end
			end
		end
	end

	searchBox:GetPropertyChangedSignal("Text"):Connect(filterPowers)
	powers.ChildAdded:Connect(function()
		task.defer(filterPowers)
	end)
	filterPowers()
end

