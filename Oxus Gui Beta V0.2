UserInputService.InputBegan:Connect(function(input, processed)
	if State.capturing then
		if input.UserInputType == Enum.UserInputType.Keyboard then
			local keyCode = input.KeyCode
			if keyCode == Enum.KeyCode.Escape then
				endCapture(State.capturing, nil, false)
			elseif keyCode == Enum.KeyCode.Backspace or keyCode == Enum.KeyCode.Delete then
				endCapture(State.capturing, nil, true)
			elseif keyCode ~= Enum.KeyCode.Tab and keyCode ~= Enum.KeyCode.Unknown then
				endCapture(State.capturing, keyCode, true)
			end
		end
		return
	end

	if processed or UserInputService:GetFocusedTextBox() then
		return
	end

	if input.UserInputType == Enum.UserInputType.Keyboard then
		for _, binder in ipairs(State.binders) do
			if binder.key and binder.key == input.KeyCode then
				binder.onPress()
			end
		end
	elseif input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch
	then
		clickTeleport(input)
	end
end)

