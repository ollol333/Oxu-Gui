local function restoreHitboxPart(part, record)
	if not part or not record then return end
	State.hitboxViewerApplying[part] = true
	pcall(function()
		part.Transparency = record.transparency
		part.Material = record.material
	end)
	State.hitboxViewerApplying[part] = nil
	State.hitboxViewerRecords[part] = nil
end

local function trackHitboxViewerPart(instance)
	if not State.hitboxViewerActive or not character or not instance:IsA("BasePart") then return end
	if not instance:IsDescendantOf(character) or State.hitboxViewerRecords[instance] then return end
	if instance.Transparency < 0.8 then return end

	local record = {
		transparency = instance.Transparency,
		material = instance.Material,
		appliedTransparency = 0,
		appliedMaterial = Enum.Material.ForceField,
	}
	State.hitboxViewerRecords[instance] = record

	local function enforce(property)
		if not State.hitboxViewerActive or State.hitboxViewerApplying[instance] or not instance.Parent then return end
		local ok, current = pcall(function() return instance[property] end)
		if not ok then return end
		local applied = property == "Transparency" and record.appliedTransparency or record.appliedMaterial
		if current ~= applied then
			if property == "Transparency" then
				record.transparency = current
			else
				record.material = current
			end
			State.hitboxViewerApplying[instance] = true
			pcall(function() instance[property] = applied end)
			State.hitboxViewerApplying[instance] = nil
		end
	end

	instance:GetPropertyChangedSignal("Transparency"):Connect(function() enforce("Transparency") end)
	instance:GetPropertyChangedSignal("Material"):Connect(function() enforce("Material") end)

	State.hitboxViewerApplying[instance] = true
	pcall(function()
		instance.Transparency = 0
		instance.Material = Enum.Material.ForceField
	end)
	State.hitboxViewerApplying[instance] = nil
end

local function startHitboxViewer()
	if State.hitboxViewerActive or not character then return end
	State.hitboxViewerActive = true
	for _, descendant in ipairs(character:GetDescendants()) do
		trackHitboxViewerPart(descendant)
	end
	table.insert(State.hitboxViewerConnections, character.DescendantAdded:Connect(function(descendant)
		task.defer(trackHitboxViewerPart, descendant)
	end))
end

local function stopHitboxViewer()
	State.hitboxViewerActive = false
	for _, connection in ipairs(State.hitboxViewerConnections) do
		connection:Disconnect()
	end
	table.clear(State.hitboxViewerConnections)
	for part, record in pairs(State.hitboxViewerRecords) do
		restoreHitboxPart(part, record)
	end
end

