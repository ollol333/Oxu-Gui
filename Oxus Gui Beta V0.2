	{ name = "Collide", prop = "CanCollide", label = "Collide" },
	{ name = "Touch", prop = "CanTouch", label = "Can Touch" },
	{ name = "Query", prop = "CanQuery", label = "Can Query" },
	{ name = "Audio_Collide", prop = "AudioCanCollide", label = "Audio Can Collide" },
}

local NUMERIC_BOXES = { "Transparency", "Speed", "JumpPower", "Jump", "Scale" }

local HUE_STOPS = {
	{ 0, 360 },
	{ 90, 240 },
	{ 180, 120 },
	{ 270, 60 },
	{ 360, 0 },
}

local character = nil
local humanoid = nil
local selectionOrder = {}
local refreshAll
local queueSync

local overrideEntries = setmetatable({}, { __mode = "k" })

function readProp(target, prop)
	if prop == "Scale" then
		return target:GetScale()
	end
	local ok, value = pcall(function()
		return target[prop]
	end)
	if ok then
		return value
	end
	return nil
end

function writeProp(target, prop, value)
	if prop == "Scale" then
		target:ScaleTo(value)
	else
		target[prop] = value
	end
end

function sameValue(a, b)
	if type(a) == "number" and type(b) == "number" then
		return math.abs(a - b) <= 1e-4 * math.max(1, math.abs(a), math.abs(b))
	end
	return a == b
end

function getEntry(target, prop)
	local perTarget = overrideEntries[target]
	if not perTarget then
		perTarget = {}
		overrideEntries[target] = perTarget
	end

	local entry = perTarget[prop]
	if entry then
		return entry
	end

	entry = { active = false, applied = nil, baseline = readProp(target, prop) }
	perTarget[prop] = entry

	local ok, signal = pcall(function()
		return target:GetPropertyChangedSignal(prop)
	end)
	if ok then
		signal:Connect(function()
			local current = readProp(target, prop)
			if entry.active then
				if not sameValue(current, entry.applied) then
					entry.baseline = current
					pcall(writeProp, target, prop, entry.applied)
				end
			else
				entry.baseline = current
			end
			queueSync()
		end)
	end

	return entry
end

function setOverride(target, prop, value)
	local entry = getEntry(target, prop)
	entry.active = true
	entry.applied = value
	local ok = pcall(writeProp, target, prop, value)
	if ok then
		entry.applied = readProp(target, prop)
	else
		entry.active = false
	end
end

function clearOverride(target, prop)
	local perTarget = overrideEntries[target]
	local entry = perTarget and perTarget[prop]
	if not entry or not entry.active then
		return
	end
	entry.active = false
	pcall(writeProp, target, prop, entry.baseline)
end

function setOrClear(target, prop, value)
	if value then
		setOverride(target, prop, value)
	else
		clearOverride(target, prop)
	end
end

function groupParts(groupName)
