local function rayParams()
	local list = {}
	for _, player in ipairs(Players:GetPlayers()) do
		if player.Character then
			table.insert(list, player.Character)
		end
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = list
	params.IgnoreWater = true
	return params
end

local function avoidRadius(record)
	return tonumber(record.radioBox.Text) or tonumber(CFG.AVOID_DEFAULT_RADIUS)
end

local function selectedPositions()
	local list = {}
	for target in pairs(selectedByList[PlayersListEffects]) do
		local part = target.Parent and targetPartFor(target, "Humanoid")
		if part then
			table.insert(list, part.Position)
		end
	end
	return list
end

local function awayFrom(origin, positions, radius, fallback)
	local sum = Vector3.zero
	local nearest, nearestDistance = nil, math.huge
	for _, position in ipairs(positions) do
		local distance = (origin - position).Magnitude
		if distance < radius then
			local flat = Vector3.new(origin.X - position.X, 0, origin.Z - position.Z)
			if flat.Magnitude > 0.05 then
				sum += flat.Unit / math.max(distance, 1)
			end
			if distance < nearestDistance then
				nearest, nearestDistance = position, distance
			end
		end
	end
	if not nearest then return nil, nil end
	if sum.Magnitude < 1e-4 then
		sum = fallback
	end
	return sum.Unit, nearest
end

local function findSpot(root, direction, nearest, positions, radius)
	local params = rayParams()
	local overlap = OverlapParams.new()
	overlap.FilterType = Enum.RaycastFilterType.Exclude
	overlap.FilterDescendantsInstances = params.FilterDescendantsInstances

	local currentGround = workspace:Raycast(root.Position, Vector3.new(0, -12, 0), params)
	local offset = currentGround and math.clamp(root.Position.Y - currentGround.Position.Y, 2, 6) or 3
	local floorLimit = workspace.FallenPartsDestroyHeight + CFG.VOID_MARGIN

	for _, angle in ipairs(CFG.AVOID_ANGLES) do
		local rotated = CFrame.Angles(0, math.rad(angle), 0):VectorToWorldSpace(direction)
		local flatDestination = Vector3.new(nearest.X, root.Position.Y, nearest.Z) + rotated * (radius + CFG.AVOID_MARGIN)
		local hit = workspace:Raycast(flatDestination + Vector3.new(0, 6, 0), Vector3.new(0, -(6 + CFG.AVOID_MAX_DROP), 0), params)
		if hit and hit.Position.Y > floorLimit then
			local spot = hit.Position + Vector3.new(0, offset, 0)
			local clear = true
			for _, position in ipairs(positions) do
				if (position - spot).Magnitude < radius then
					clear = false
					break
				end
			end
			if clear then
				local parts = workspace:GetPartBoundsInBox(CFrame.new(hit.Position + Vector3.new(0, 3.2, 0)), Vector3.new(2, 4.4, 2), overlap)
				for _, part in ipairs(parts) do
					if part.CanCollide then
						clear = false
						break
					end
				end
			end
			if clear then
				return spot
			end
		end
	end
	return nil
end

local function obstacleAhead(root, direction)
	local result = workspace:Raycast(root.Position - Vector3.new(0, 2, 0), direction * 3.5, rayParams())
	return result ~= nil and result.Instance.CanCollide
end

local function avoidStep(record)
	if activeLoop or tpBlocked() then return end
	local root = getRoot()
	local humanoid = getHumanoid()
	if not root or not humanoid or humanoid.Health <= 0 then return end
	local radius = avoidRadius(record)
	if radius <= 0 then return end

	local look = root.CFrame.LookVector
	local fallback = Vector3.new(-look.X, 0, -look.Z)
	if fallback.Magnitude < 0.05 then
		fallback = Vector3.new(0, 0, 1)
	end
	local positions = selectedPositions()
	local direction, nearest = awayFrom(root.Position, positions, radius, fallback.Unit)
	if not direction then return end

	if record.mode == "Caminata" then
		humanoid:Move(direction, false)
		if obstacleAhead(root, direction) then
			humanoid.Jump = true
		end
		return
	end

	if os.clock() < record.retryAt then return end
	local spot = findSpot(root, direction, nearest, positions, radius)
	if spot then
		teleportRoot(CFrame.new(spot) * root.CFrame.Rotation)
	else
		record.retryAt = os.clock() + CFG.AVOID_RETRY
	end
end

