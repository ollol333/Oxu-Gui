coordinateProbe.Name = "OxusCoordinateProbe"
coordinateProbe.BackgroundTransparency = 1
coordinateProbe.BorderSizePixel = 0
coordinateProbe.Active = false
coordinateProbe.Interactable = false
coordinateProbe.Size = UDim2.new(0, 1, 0, 1)
coordinateProbe.Position = UDim2.new(0, 0, 0, 0)
coordinateProbe.Parent = Gui

local function guiShift()
	local origin = Gui.IgnoreGuiInset and Vector2.zero or GuiService:GetGuiInset()
	return origin - coordinateProbe.AbsolutePosition
end

local function inputGuiPoint(input)
	local raw
	if input.UserInputType == Enum.UserInputType.Touch then
		raw = Vector2.new(input.Position.X, input.Position.Y) + GuiService:GetGuiInset()
	else
		raw = UserInputService:GetMouseLocation()
	end
	return raw - guiShift()
end

local function isOver(gui, point)
	local position = gui.AbsolutePosition
	local size = gui.AbsoluteSize
	return point.X >= position.X
		and point.X <= position.X + size.X
		and point.Y >= position.Y
		and point.Y <= position.Y + size.Y
end

local function setSelection(list)
	local previous = table.clone(selectedList)
	table.clear(selectedList)
	table.clear(selected)
	for _, instance in ipairs(list) do
		if not selected[instance] then
			selected[instance] = true
			table.insert(selectedList, instance)
		end
	end
	for _, instance in ipairs(previous) do
		local node = nodeByInstance[instance]
		if node and Hooks.paint then
			Hooks.paint(node)
		end
	end
	for _, instance in ipairs(selectedList) do
		local node = nodeByInstance[instance]
		if node and Hooks.paint then
			Hooks.paint(node)
		end
	end
	viewerDirty = true
	propsDirty = true
	toolsDirty = true
end

do
	local Explorer = Seccion2:WaitForChild("Explorer")
	local SearchBox = Explorer:WaitForChild("Search")
	local PowersFrame = Explorer:WaitForChild("PlayerPowers")
	local HolderTemplate = PowersFrame:WaitForChild("MarcObject")
	local RowSource = HolderTemplate:WaitForChild("MarcFrameObject")

	assert(SearchBox:IsA("TextBox"), "Search debe ser TextBox")
	assert(HolderTemplate:IsA("ScrollingFrame"), "MarcObject debe ser ScrollingFrame")
	assert(RowSource:IsA("Frame"), "MarcFrameObject debe ser Frame")

	local SELECTED_COLOR = Color3.fromRGB(50, 50, 50)
	local ARROW_CLOSED = "▷"
	local ARROW_OPEN = "▽"
	local INDENT = 14
	local MAX_INDENT_DEPTH = 14
	local BUILD_BATCH = 30
	local FRAME_BUDGET = 0.006
	local DEFAULT_ROW_HEIGHT = 24
	local PRUNE_INTERVAL = 0.5

	local rowTemplate = RowSource:Clone()
	local rowSize = RowSource.Size
	local rowBaseColor = RowSource.BackgroundColor3
	local rowBaseTransparency = RowSource.BackgroundTransparency
	local rowHeight = rowSize.Y.Offset
	if rowHeight <= 0 then rowHeight = RowSource.AbsoluteSize.Y end
	if rowHeight <= 0 then rowHeight = DEFAULT_ROW_HEIGHT end

	local CHILD_WIDTH_FACTOR = 0.93
	local MIN_CHILD_WIDTH_FACTOR = 0.25

	local function widthFactorForDepth(depth)
		return math.max(MIN_CHILD_WIDTH_FACTOR, CHILD_WIDTH_FACTOR ^ math.max(depth, 0))
	end
	HolderTemplate.Visible = false

	local rootMap = {}
	local dirty = {}
	local rootSequence = 0
	local query = ""
	local built = false
	local building = false
	local lastPrune = 0

	local createNode
	local destroyNode
	local setExpanded
	local toggleSelected
	local refreshArrow
	local onChildAdded
	local onChildRemoved
	local onRename

	local function resolveIconImage(className)
		local value = Data:FindFirstChild("Icon_" .. className) or Data:FindFirstChild("Icon_Default")
		local text = value and string.gsub(value.Value, "^%s*(.-)%s*$", "%1") or ""
		if text == "" or text == "0" then return nil end
		if string.match(text, "^%d+$") then return "rbxassetid://" .. text end
		return text
	end

	local function applyIcon(node)
		local icon = node.iconLabel
		if not icon then
			return
		end
		local image = resolveIconImage(node.instance.ClassName)
		if image and icon.Image ~= image then
			icon.Image = image
		end
	end

	local function markDirty(node)
		dirty[node.root] = true
	end

	local function markAllDirty()
		for _, root in pairs(rootMap) do
			dirty[root] = true
		end
	end

	local function paintRow(node)
		local isSelected = selected[node.instance] == true
		node.row.BackgroundColor3 = isSelected and SELECTED_COLOR or rowBaseColor
		node.row.BackgroundTransparency = isSelected and 0 or rowBaseTransparency
	end

	Hooks.paint = paintRow

	local function bindClick(node, gui, callback)
		if not gui then return end
		if gui:IsA("GuiButton") then
			table.insert(node.connections, gui.Activated:Connect(function()
				callback()
			end))
			return
		end
		table.insert(node.connections, gui.InputBegan:Connect(function(input)
			if isPress(input) then
				callback()
			end
		end))
	end

	local function prepareHolder(holder)
		holder.Visible = true
		holder.ScrollingEnabled = false
		holder.ScrollBarThickness = 0
		local layout = holder:FindFirstChildOfClass("UIListLayout")
		if not layout then
			layout = Instance.new("UIListLayout")
			layout.Parent = holder
		end
		layout.FillDirection = Enum.FillDirection.Vertical
		layout.SortOrder = Enum.SortOrder.LayoutOrder
		layout.HorizontalAlignment = Enum.HorizontalAlignment.Left
		return layout
	end

	refreshArrow = function(node)
		local button = node.openButton
		if not button then return end
		local text = ""
		if #node.instance:GetChildren() > 0 then
			text = node.expanded and ARROW_OPEN or ARROW_CLOSED
		end
		if button.Text ~= text then
			button.Text = text
		end
	end

	createNode = function(instance, parent)
		local node = {
			instance = instance,
			parent = parent,
			depth = parent and parent.depth + 1 or 0,
			children = {},
			childMap = {},
			connections = {},
			expanded = false,
			shown = true,
			token = 0,
			lower = string.lower(instance.Name),
		}

		local row
		if parent then
			node.root = parent.root
			row = rowTemplate:Clone()
			row.Name = "Row"
			local widthFactor = widthFactorForDepth(node.depth)
			row.Size = UDim2.new(
				rowSize.X.Scale * widthFactor,
				math.max(40, rowSize.X.Offset * widthFactor - INDENT * math.min(node.depth, MAX_INDENT_DEPTH)),
				0,
				rowHeight
			)
			row.Visible = true
			row.Parent = node.root.holder
			table.insert(parent.children, node)
			parent.childMap[instance] = node
		else
			node.root = node
			rootSequence += 1
			local holder = HolderTemplate:Clone()
			holder.Name = "Object_" .. rootSequence
			holder.LayoutOrder = rootSequence
			local layout = prepareHolder(holder)
			holder.Size = UDim2.new(1, 0, 0, rowHeight)
			node.holder = holder
			node.padding = layout.Padding.Offset
			row = holder:FindFirstChild("MarcFrameObject")
			row.Size = UDim2.new(1, 0, 0, rowHeight)
			row.Visible = true
			holder.Parent = PowersFrame
			rootMap[instance] = node
		end

		node.row = row
		node.nameLabel = row:FindFirstChild("NameObject", true)
		node.openButton = row:FindFirstChild("OpenObject", true)
		node.clickButton = row:FindFirstChild("ClickButtonInteract", true)
		local iconCandidate = row:FindFirstChild("IconObject", true)
		if iconCandidate and iconCandidate:IsA("ImageLabel") then
			node.iconLabel = iconCandidate
		end
		nodeByInstance[instance] = node

		if node.nameLabel then
			node.nameLabel.Text = instance.Name
		end

		applyIcon(node)

		bindClick(node, node.openButton, function()
			setExpanded(node, not node.expanded)
		end)
		bindClick(node, node.clickButton, function()
			toggleSelected(node)
		end)

		table.insert(node.connections, instance.ChildAdded:Connect(function(child)
			onChildAdded(node, child)
		end))
		table.insert(node.connections, instance.ChildRemoved:Connect(function(child)
			onChildRemoved(node, child)
		end))
		table.insert(node.connections, instance:GetPropertyChangedSignal("Name"):Connect(function()
			onRename(node)
		end))

		paintRow(node)
		refreshArrow(node)
		markDirty(node)
		return node
	end

	destroyNode = function(node, skipGui)
		for _, connection in ipairs(node.connections) do
			connection:Disconnect()
		end
		table.clear(node.connections)
		node.token += 1
		dirty[node] = nil
		if nodeByInstance[node.instance] == node then
			nodeByInstance[node.instance] = nil
		end
		local childSkip = skipGui or node.parent == nil
		for _, child in ipairs(node.children) do
			destroyNode(child, childSkip)
		end
		table.clear(node.children)
		table.clear(node.childMap)
		if not skipGui then
			if node.parent then
				node.row:Destroy()
			else
				node.holder:Destroy()
			end
		end
	end

	onChildAdded = function(node, child)
		if node.expanded and not node.childMap[child] then
			createNode(child, node)
			markDirty(node)
		end
		refreshArrow(node)
	end

	onChildRemoved = function(node, child)
		local childNode = node.childMap[child]
		if childNode then
			node.childMap[child] = nil
			local index = table.find(node.children, childNode)
			if index then
				table.remove(node.children, index)
			end
			destroyNode(childNode, false)
			markDirty(node)
		end
		refreshArrow(node)
	end

	onRename = function(node)
		node.lower = string.lower(node.instance.Name)
		if node.nameLabel then
			node.nameLabel.Text = node.instance.Name
		end
		if query ~= "" then
			markDirty(node)
		end
	end

	local function populate(node)
		node.token += 1
		local token = node.token
		local list = node.instance:GetChildren()
		for index, child in ipairs(list) do
			if node.token ~= token or not node.expanded then return end
			if child.Parent == node.instance and not node.childMap[child] then
				createNode(child, node)
			end
			if index % BUILD_BATCH == 0 then
				markDirty(node)
				task.wait()
			end
		end
		markDirty(node)
	end

	setExpanded = function(node, value)
		if node.expanded == value then return end
		if value and not node.instance:FindFirstChildWhichIsA("Instance") then return end
		node.expanded = value
		if value then
			task.spawn(populate, node)
		else
			node.token += 1
			for _, child in ipairs(node.children) do
				destroyNode(child, false)
			end
			table.clear(node.children)
			table.clear(node.childMap)
			markDirty(node)
		end
		refreshArrow(node)
	end

	toggleSelected = function(node)
		local instance = node.instance
		if selected[instance] then
			selected[instance] = nil
			local index = table.find(selectedList, instance)
			if index then
				table.remove(selectedList, index)
			end
		else
			selected[instance] = true
			table.insert(selectedList, instance)
		end
		paintRow(node)
		viewerDirty = true
		propsDirty = true
		toolsDirty = true
	end

	local function evaluate(node)
		local matches = query == "" or string.find(node.lower, query, 1, true) ~= nil
		local childShown = false
		for _, child in ipairs(node.children) do
			if evaluate(child) then
				childShown = true
			end
		end
		node.shown = matches or childShown
		return node.shown
	end

	local function place(node, count)
		local row = node.row
		if node.shown then
			count += 1
			row.LayoutOrder = count
		end
		if row.Visible ~= node.shown then
			row.Visible = node.shown
		end
		for _, child in ipairs(node.children) do
			count = place(child, count)
		end
		return count
	end

	local function relayout(root)
		local holder = root.holder
		if not holder or not holder.Parent then
			return
		end

		evaluate(root)
		place(root, 0)

		local layout = holder:FindFirstChildOfClass("UIListLayout")
		if not layout then
			holder.Visible = root.shown
			return
		end

		local function updateHeight()
			if not holder.Parent then
				return
			end

			local totalHeight = layout.AbsoluteContentSize.Y
			local currentSize = holder.Size

			if totalHeight < rowHeight then
				totalHeight = rowHeight
			end

			totalHeight = math.ceil(totalHeight)

			if currentSize.Y.Scale ~= 0 or currentSize.Y.Offset ~= totalHeight then
				holder.Size = UDim2.new(
					currentSize.X.Scale,
					currentSize.X.Offset,
					0,
					totalHeight
				)
			end

			holder.Visible = root.shown
		end

		updateHeight()

		task.defer(function()
			if not holder.Parent then
				return
			end

			updateHeight()
		end)
	end

	local function processDirty()
		local started = os.clock()
		for root in pairs(dirty) do
			dirty[root] = nil
			relayout(root)
			if os.clock() - started > FRAME_BUDGET then
				break
			end
		end
	end

	local function buildRoots()
		if built or building then return end
		building = true
		task.spawn(function()
			local list = workspace:GetChildren()
			for index, child in ipairs(list) do
				if child.Parent == workspace and not rootMap[child] then
					createNode(child, nil)
				end
				if index % BUILD_BATCH == 0 then
					task.wait()
				end
			end
			built = true
			building = false
		end)
	end

	workspace.ChildAdded:Connect(function(child)
		if (built or building) and not rootMap[child] then
			createNode(child, nil)
		end
	end)

	workspace.ChildRemoved:Connect(function(child)
		local node = rootMap[child]
		if node then
			rootMap[child] = nil
			destroyNode(node, false)
		end
	end)

	SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
		query = string.lower(string.match(SearchBox.Text, "^%s*(.-)%s*$") or "")
		markAllDirty()
	end)

	local function pruneSelection()
		for index = #selectedList, 1, -1 do
			local instance = selectedList[index]
			if not instance:IsDescendantOf(workspace) then
				table.remove(selectedList, index)
				selected[instance] = nil
				viewerDirty = true
				propsDirty = true
				toolsDirty = true
			end
		end
	end

	RunService.Heartbeat:Connect(function()
		if not sectionIsOpen() then return end
		if not built and not building then
			buildRoots()
		end
		local now = os.clock()
		if now - lastPrune >= PRUNE_INTERVAL then
			lastPrune = now
			pruneSelection()
		end
		processDirty()
	end)

	Seccion2:GetPropertyChangedSignal("Visible"):Connect(function()
		if Seccion2.Visible then
			viewerDirty = true
			propsDirty = true
			markAllDirty()
		end
	end)
end

do
	local ViewerPart = Seccion2:WaitForChild("ViewerPart")
	local Viewport = ViewerPart:FindFirstChildWhichIsA("ViewportFrame", true)
	assert(Viewport, "OxusGuiBeta: falta un ViewportFrame dentro de ViewerPart")

	local MAX_PREVIEW = 30
	local MIN_RADIUS = 4
	local FIT_MARGIN = 1.08
	local PREVIEW_FOV = 38
	local SPIN_SECONDS = 12
	local ZOOM_STEP = 0.12
	local MIN_ZOOM = 0.15
	local MAX_ZOOM = 3

	local previewActive = false
	local previewCenter = Vector3.zero
	local previewRadius = MIN_RADIUS
	local zoom = 1

	local world = Viewport:FindFirstChildOfClass("WorldModel")
	if not world then
		world = Instance.new("WorldModel")
		world.Name = "PartPreviewWorld"
		world.Parent = Viewport
	end

	local camera = Viewport:FindFirstChild("PartPreviewCamera")
	if not camera then
		camera = Instance.new("Camera")
		camera.Name = "PartPreviewCamera"
		camera.Parent = Viewport
	end
	camera.FieldOfView = PREVIEW_FOV
	Viewport.CurrentCamera = camera
	Viewport.Active = true

	local function buildItem(instance)
		local previous = instance.Archivable
		pcall(function()
			instance.Archivable = true
		end)
		local ok, copy = pcall(function()
			return instance:Clone()
		end)
		pcall(function()
			instance.Archivable = previous
		end)
		if not ok or not copy then return nil end
		if copy:IsA("BaseScript") then
			copy:Destroy()
			return nil
		end

		local items = copy:GetDescendants()
		table.insert(items, copy)
		for _, item in ipairs(items) do
			if item:IsA("BaseScript") then
				item:Destroy()
			elseif item:IsA("BasePart") then
				item.Anchored = true
				item.CanCollide = false
			elseif item:IsA("Sound") then
				item.Playing = false
			elseif item:IsA("Humanoid") then
				item.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
				item.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
			end
		end

		local wrapper = Instance.new("Model")
		wrapper.Name = "Item"
		copy.Parent = wrapper
		if not wrapper:FindFirstChildWhichIsA("BasePart", true) then
			wrapper:Destroy()
			return nil
		end
		return wrapper
	end

	local function arrangeItems(items)
		local count = #items
		local centers = {}
		local footprints = {}
		local maxFootprint = 0
		for index, item in ipairs(items) do
			local cframe, size = item:GetBoundingBox()
			centers[index] = cframe.Position
			footprints[index] = math.max(size.X, size.Z)
			maxFootprint = math.max(maxFootprint, footprints[index])
		end

		local columns = math.ceil(math.sqrt(count))
		local gap = math.max(maxFootprint * 0.1, 0.5)
		local columnWidth = {}
		local rowDepth = {}
		for index = 1, count do
			local column = (index - 1) % columns + 1
			local rowIndex = math.floor((index - 1) / columns) + 1
			columnWidth[column] = math.max(columnWidth[column] or 0, footprints[index])
			rowDepth[rowIndex] = math.max(rowDepth[rowIndex] or 0, footprints[index])
		end

		local columnStart = {}
		local cursor = 0
		for column = 1, #columnWidth do
			columnStart[column] = cursor
			cursor += columnWidth[column] + gap
		end
		local rowStart = {}
		cursor = 0
		for rowIndex = 1, #rowDepth do
			rowStart[rowIndex] = cursor
			cursor += rowDepth[rowIndex] + gap
		end

		for index, item in ipairs(items) do
			local column = (index - 1) % columns + 1
			local rowIndex = math.floor((index - 1) / columns) + 1
			local target = Vector3.new(
				columnStart[column] + columnWidth[column] * 0.5,
				0,
				rowStart[rowIndex] + rowDepth[rowIndex] * 0.5
			)
			item:PivotTo(item:GetPivot() + (target - centers[index]))
		end
	end

	local function fitGroup(group)
		local cframe, size = group:GetBoundingBox()
		local radius = size.Magnitude * 0.5
		if radius > 0 and radius < MIN_RADIUS then
			local ok = pcall(function()
				group:ScaleTo(MIN_RADIUS / radius)
			end)
			if ok then
				cframe, size = group:GetBoundingBox()
				radius = size.Magnitude * 0.5
			end
		end
		if not cframe or not size or typeof(radius) ~= "number" or radius ~= radius then
			previewCenter = Vector3.zero
			previewRadius = MIN_RADIUS
			return
		end
		previewCenter = cframe.Position
		previewRadius = math.max(radius, 0.5)
	end

	local function rebuildViewer()
		world:ClearAllChildren()
		previewActive = false
		zoom = 1

		local items = {}
		for _, instance in ipairs(selectedList) do
			if #items >= MAX_PREVIEW then break end
			if instance:IsDescendantOf(workspace) then
				local item = buildItem(instance)
				if item then
					table.insert(items, item)
				end
			end
		end
		if #items == 0 then return end

		local group = Instance.new("Model")
		group.Name = "PreviewGroup"
		for _, item in ipairs(items) do
			item.Parent = group
		end
		group.Parent = world
		arrangeItems(items)
		fitGroup(group)
		previewActive = true
	end

	RunService.Heartbeat:Connect(function()
		if viewerDirty and sectionIsOpen() then
			viewerDirty = false
			rebuildViewer()
		end
	end)

	local dragging = false
	local dragInput = nil
	local dragStart = nil
	local startYaw = 0
	local startPitch = 0
	local yaw = math.rad(35)
	local pitch = 0.3

	Viewport.InputBegan:Connect(function(input)
		if isPress(input) then
			dragging = true
			dragInput = input
			dragStart = input.Position
			startYaw, startPitch = yaw, pitch
		end
	end)

	Viewport.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseWheel then
			zoom = math.clamp(zoom * (1 - input.Position.Z * ZOOM_STEP), MIN_ZOOM, MAX_ZOOM)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if not dragging or not dragStart then return end
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			local delta = input.Position - dragStart
			yaw = startYaw - delta.X * (math.pi * 2 / math.max(Viewport.AbsoluteSize.X, 1))
			pitch = math.clamp(startPitch + delta.Y * math.pi / math.max(Viewport.AbsoluteSize.Y, 1), -1.2, 1.2)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input == dragInput or isPress(input) then
			dragging = false
			dragInput = nil
		end
	end)

	RunService.RenderStepped:Connect(function(dt)
		if not previewActive or not sectionIsOpen() then return end
		if not dragging then
			yaw += dt * (math.pi * 2 / SPIN_SECONDS)
		end
		local aspect = Viewport.AbsoluteSize.X / math.max(Viewport.AbsoluteSize.Y, 1)
		local effective = math.atan(math.tan(math.rad(camera.FieldOfView * 0.5)) * math.min(aspect, 1))
		local distance = previewRadius / math.sin(math.max(effective, 0.05)) * FIT_MARGIN * zoom
		local direction = Vector3.new(
			math.sin(yaw) * math.cos(pitch),
			math.sin(pitch),
			math.cos(yaw) * math.cos(pitch)
		)
		camera.CFrame = CFrame.lookAt(previewCenter + direction * distance, previewCenter)
	end)
end

do
	local CREATE_DISTANCE = 3
	local HANDLE_GAP = 0.09
	local HANDLE_SCREEN_SCALE = 0.025
	local HANDLE_MIN = 0.1
	local RAY_LENGTH = 5000
	local MODE_ON = 0.6
	local MODE_OFF = 0.95
	local FRAME_REFRESH = 0.15
	local MIN_AXIS = 0.05
	local MIN_FACTOR = 0.02
	local BODY_DRAG_HOLD = 0.25
	local BODY_DRAG_DISTANCE = 6

	local HANDLE_COLORS = {
		Color3.fromRGB(255, 0, 0),
		Color3.fromRGB(0, 255, 0),
		Color3.fromRGB(0, 0, 255),
	}

	local SIGNS = { 1, -1 }

	local CREATORS = {
		InstanceNewBlock = { class = "Part", shape = Enum.PartType.Block },
		InstanceNewCilindro = { class = "Part", shape = Enum.PartType.Cylinder, size = Vector3.new(4, 2, 2) },
		["InstanceNewCuña"] = { class = "WedgePart" },
		["InstanceNewCuñaDeEsquina"] = { class = "CornerWedgePart" },
		InstanceNewSeatPart = { class = "Seat" },
		InstanceNewSphere = { class = "Part", shape = Enum.PartType.Ball, size = Vector3.new(4, 4, 4) },
		InstanceNewTrussPart = { class = "TrussPart" },
	}

	local MODES = {
		MoveModeButton = "move",
		RotationModeButton = "rotate",
		ScaleModeButton = "scale",
	}

	local toolMode = nil
	local movables = {}
	local frameCF = nil
	local frameSize = nil
	local drag = nil
	local handleFolder = nil
	local handleParts = {}
	local modeButtons = {}
	local lastFrameRefresh = 0

	local function axisVector(cframe, axis)
		if axis == 1 then
			return cframe.XVector
		elseif axis == 2 then
			return cframe.YVector
		end
		return cframe.ZVector
	end

	local function axisSize(size, axis)
		if axis == 1 then
			return size.X
		elseif axis == 2 then
			return size.Y
		end
		return size.Z
	end

	local function clearHandles()
		if handleFolder then
			handleFolder:Destroy()
			handleFolder = nil
		end
		table.clear(handleParts)
	end

	local function ensureHandles()
		if handleFolder and handleFolder.Parent then return end
		clearHandles()
		handleFolder = Instance.new("Folder")
		handleFolder.Name = "OxusToolHandles"
		handleFolder.Parent = workspace.CurrentCamera or workspace
		for axis = 1, 3 do
			for _, sign in ipairs(SIGNS) do
				local part = Instance.new("Part")
				part.Name = "Handle"
				part.Shape = Enum.PartType.Ball
				part.Anchored = true
				part.CanCollide = false
				part.CanTouch = false
				part.CanQuery = true
				part.CastShadow = false
				part.Material = Enum.Material.ForceField
				part.Color = HANDLE_COLORS[axis]
				part.Size = Vector3.new(0.5, 0.5, 0.5)
				part.Parent = handleFolder
				handleParts[part] = { axis = axis, sign = sign }
			end
		end
	end

	local function collectMovables()
		local result = {}
		local function add(instance)
			if instance:IsA("Terrain") or instance:IsA("Camera") then return end
			if instance:IsA("BasePart") or instance:IsA("Model") then
				table.insert(result, instance)
				return
			end
			for _, child in ipairs(instance:GetChildren()) do
				add(child)
			end
		end
		for _, instance in ipairs(selectedList) do
			if instance:IsDescendantOf(workspace) then
				add(instance)
			end
		end
		local filtered = {}
		for _, instance in ipairs(result) do
			local nested = false
			for _, other in ipairs(result) do
				if other ~= instance and instance:IsDescendantOf(other) then
					nested = true
					break
				end
			end
			if not nested then
				table.insert(filtered, instance)
			end
		end
		return filtered
	end

	local function boundsOf(item)
		if item:IsA("BasePart") then
			return item.CFrame, item.Size
		end
		return item:GetBoundingBox()
	end

	local function computeFrame(items)
		if #items == 0 then return nil, nil end
		if #items == 1 then
			return boundsOf(items[1])
		end
		local minimum = Vector3.new(math.huge, math.huge, math.huge)
		local maximum = Vector3.new(-math.huge, -math.huge, -math.huge)
		for _, item in ipairs(items) do
			local cframe, size = boundsOf(item)
			local half = size * 0.5
			for _, sx in ipairs(SIGNS) do
				for _, sy in ipairs(SIGNS) do
					for _, sz in ipairs(SIGNS) do
						local corner = cframe:PointToWorldSpace(Vector3.new(half.X * sx, half.Y * sy, half.Z * sz))
						minimum = minimum:Min(corner)
						maximum = maximum:Max(corner)
					end
				end
			end
		end
		return CFrame.new((minimum + maximum) * 0.5), maximum - minimum
	end

	local function updateHandles()
		if not toolMode or not frameCF or #movables == 0 then
			clearHandles()
			return
		end
		ensureHandles()
		local camera = workspace.CurrentCamera
		for part, data in pairs(handleParts) do
			local size = axisSize(frameSize, data.axis)
			local direction = axisVector(frameCF, data.axis) * data.sign
			local position = frameCF.Position + direction * (size * 0.5 + size * HANDLE_GAP)
			local distance = camera and (camera.CFrame.Position - position).Magnitude or 30
			local diameter = math.clamp(distance * HANDLE_SCREEN_SCALE, HANDLE_MIN, math.max(size * 0.45, HANDLE_MIN))
			part.Size = Vector3.new(diameter, diameter, diameter)
			part.Position = position
		end
	end

	local function refreshTool()
		movables = collectMovables()
		frameCF, frameSize = computeFrame(movables)
		updateHandles()
	end
	refreshToolShared = refreshTool

	local function pointerPosition(input)
		if input and input.UserInputType == Enum.UserInputType.Touch then
			return Vector2.new(input.Position.X, input.Position.Y)
		end
		return UserInputService:GetMouseLocation()
	end

	local function rayFromInput(input)
		local camera = workspace.CurrentCamera
		if not camera then return nil end
		if input and input.UserInputType == Enum.UserInputType.Touch then
			return camera:ScreenPointToRay(input.Position.X, input.Position.Y)
		end
		local location = UserInputService:GetMouseLocation()
		return camera:ViewportPointToRay(location.X, location.Y)
	end

	local function castHandles(ray)
		if not handleFolder then return nil end
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Include
		params.FilterDescendantsInstances = { handleFolder }
		local result = workspace:Raycast(ray.Origin, ray.Direction * RAY_LENGTH, params)
		if result and handleParts[result.Instance] then
			return result.Instance
		end
		return nil
	end

	local function castScene(ray, extraIgnore)
		local ignore = {}
		if handleFolder then
			table.insert(ignore, handleFolder)
		end
		if LocalPlayer.Character then
			table.insert(ignore, LocalPlayer.Character)
		end
		if extraIgnore then
			for _, item in ipairs(extraIgnore) do
				table.insert(ignore, item)
			end
		end
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = ignore
		return workspace:Raycast(ray.Origin, ray.Direction * RAY_LENGTH, params)
	end

	local function isPlayerCharacter(instance)
		for _, player in ipairs(game:GetService("Players"):GetPlayers()) do
			local character = player.Character
			if character and (instance == character or instance:IsDescendantOf(character)) then
				return true
			end
		end
		local current = instance
		while current and current ~= workspace do
			if current:IsA("Model") and current:FindFirstChildOfClass("Humanoid") then
				return true
			end
			current = current.Parent
		end
		return false
	end

	local function shiftHeld()
		return UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
	end

	local function resolveTarget(part, individual)
		if not part or isPlayerCharacter(part) then return nil end
		if individual then return part end
		local target = part
		local current = part.Parent
		while current and current ~= workspace do
			if current:IsA("Model") then
				if isPlayerCharacter(current) then return nil end
				target = current
			end
			current = current.Parent
		end
		return target
	end

	local function inSelection(target)
		for _, instance in ipairs(selectedList) do
			if target == instance or target:IsDescendantOf(instance) then
				return true
			end
		end
		return false
	end

	local function lineParam(ray, origin, direction)
		local rayDirection = ray.Direction.Unit
		local offset = ray.Origin - origin
		local b = rayDirection:Dot(direction)
		local d = rayDirection:Dot(offset)
		local e = direction:Dot(offset)
		local denominator = 1 - b * b
		if math.abs(denominator) < 1e-4 then return nil end
		return (e - b * d) / denominator
	end

	local function planePoint(ray, center, normal)
		local rayDirection = ray.Direction.Unit
		local denominator = rayDirection:Dot(normal)
		if math.abs(denominator) < 1e-4 then return nil end
		local t = (center - ray.Origin):Dot(normal) / denominator
		if t < 0 then return nil end
		return ray.Origin + rayDirection * t
	end

	local function snapshot(input)
		local state = {
			input = input,
			frameCF = frameCF,
			frameSize = frameSize,
			center = frameCF.Position,
			pivots = {},
			sizes = {},
			scales = {},
			single = #movables == 1 and movables[1]:IsA("BasePart"),
		}
		for _, item in ipairs(movables) do
			state.pivots[item] = item:GetPivot()
			if item:IsA("BasePart") then
				state.sizes[item] = item.Size
			else
				state.scales[item] = item:GetScale()
			end
		end
		return state
	end

	local function applyTranslation(state, delta)
		for item, pivot in pairs(state.pivots) do
			item:PivotTo(pivot + delta)
			if item:IsA("BasePart") then
				item.AssemblyLinearVelocity = Vector3.zero
			end
		end
	end

	local function applyRotation(state, angle)
		local transform = CFrame.new(state.center) * CFrame.fromAxisAngle(state.dir, angle) * CFrame.new(-state.center)
		for item, pivot in pairs(state.pivots) do
			item:PivotTo(transform * pivot)
		end
	end

	local function applyUniformScale(state, anchor, factor)
		for item, pivot in pairs(state.pivots) do
			local position = anchor + (pivot.Position - anchor) * factor
			if item:IsA("BasePart") then
				item.Size = state.sizes[item] * factor
			else
				pcall(function()
					item:ScaleTo(state.scales[item] * factor)
				end)
			end
			item:PivotTo(CFrame.new(position) * pivot.Rotation)
		end
	end

	local function beginHandleDrag(handle, input, ray)
		if not frameCF then return end
		local data = handleParts[handle]
		local state = snapshot(input)
		state.kind = "handle"
		state.axis = data.axis
		state.sign = data.sign
		state.dir = axisVector(frameCF, data.axis)
		if toolMode == "rotate" then
			local hit = planePoint(ray, state.center, state.dir)
			if not hit then return end
			local vector = hit - state.center
			vector = vector - state.dir * vector:Dot(state.dir)
			if vector.Magnitude < 1e-3 then return end
			state.startVector = vector
		else
			local t = lineParam(ray, state.center, state.dir)
			if not t then return end
			state.t0 = t
		end
		drag = state
	end

	local function beginBodyDrag(input)
		if not frameCF then return end
		local state = snapshot(input)
		state.kind = "body"
		state.pending = true
		state.startedAt = os.clock()
		state.startPoint = pointerPosition(input)
		drag = state
	end

	local function stepDrag()
		local state = drag
		local ray = rayFromInput(state.input)
		if not ray then return end

		if state.kind == "body" then
			if state.pending then
				local moved = (pointerPosition(state.input) - state.startPoint).Magnitude
				if moved < BODY_DRAG_DISTANCE and os.clock() - state.startedAt < BODY_DRAG_HOLD then
					return
				end
				state.pending = false
			end
			local result = castScene(ray, movables)
			local newCenter = nil
			if result then
				local normal = result.Normal
				local cframe = state.frameCF
				local size = state.frameSize
				local extent = (
					math.abs(cframe.XVector:Dot(normal)) * size.X
						+ math.abs(cframe.YVector:Dot(normal)) * size.Y
						+ math.abs(cframe.ZVector:Dot(normal)) * size.Z
				) * 0.5
				newCenter = result.Position + normal * extent
			elseif math.abs(ray.Direction.Y) > 1e-4 then
				local t = (state.center.Y - ray.Origin.Y) / ray.Direction.Y
				if t > 0 then
					newCenter = ray.Origin + ray.Direction * t
				end
			end
			if not newCenter then return end
			local delta = newCenter - state.center
			applyTranslation(state, delta)
			frameCF = state.frameCF + delta
			return
		end

		if toolMode == "rotate" then
			local hit = planePoint(ray, state.center, state.dir)
			if not hit then return end
			local vector = hit - state.center
			vector = vector - state.dir * vector:Dot(state.dir)
			if vector.Magnitude < 1e-3 then return end
			local angle = math.atan2(state.dir:Dot(state.startVector:Cross(vector)), state.startVector:Dot(vector))
			applyRotation(state, angle)
			frameCF = CFrame.new(state.center) * CFrame.fromAxisAngle(state.dir, angle) * CFrame.new(-state.center) * state.frameCF
			return
		end

		local t = lineParam(ray, state.center, state.dir)
		if not t then return end
		local travel = t - state.t0

		if toolMode == "move" then
			local delta = state.dir * travel
			applyTranslation(state, delta)
			frameCF = state.frameCF + delta
			return
		end

		local startAxis = math.max(axisSize(state.frameSize, state.axis), MIN_AXIS)
		local newAxis = math.max(startAxis + state.sign * travel, MIN_AXIS)

		if state.single then
			local size = state.frameSize
			local newSize = Vector3.new(
				state.axis == 1 and newAxis or size.X,
				state.axis == 2 and newAxis or size.Y,
				state.axis == 3 and newAxis or size.Z
			)
			local shift = state.dir * state.sign * (newAxis - startAxis) * 0.5
			local item = movables[1]
			item.Size = newSize
			item:PivotTo(state.pivots[item] + shift)
			frameCF = state.frameCF + shift
			frameSize = newSize
		else
			local factor = math.max(newAxis / startAxis, MIN_FACTOR)
			local anchor = state.center - state.dir * state.sign * startAxis * 0.5
			applyUniformScale(state, anchor, factor)
			frameCF = CFrame.new(anchor + (state.center - anchor) * factor) * state.frameCF.Rotation
			frameSize = state.frameSize * factor
		end
	end

	local function endDrag()
		if drag then
			local state = drag
			local changedItems = {}
			for _, item in ipairs(movables) do
				if item.Parent then
					local beforePivot = state.pivots[item]
					local beforeSize = state.sizes[item]
					local beforeScale = state.scales[item]
					local afterPivot = item:GetPivot()
					local afterSize = item:IsA("BasePart") and item.Size or nil
					local afterScale = item:IsA("Model") and item:GetScale() or nil
					if beforePivot and (beforePivot ~= afterPivot or beforeSize ~= afterSize or beforeScale ~= afterScale) then
						table.insert(changedItems, {instance = item, beforePivot = beforePivot, afterPivot = afterPivot, beforeSize = beforeSize, afterSize = afterSize, beforeScale = beforeScale, afterScale = afterScale})
					end
				end
			end
			if #changedItems > 0 and not historyApplying then
				table.insert(undoStack, {{kind = "transform", items = changedItems}})
				if #undoStack > 100 then table.remove(undoStack, 1) end
				table.clear(redoStack)
			end
			drag = nil
			refreshTool()
		end
	end

	local contextBillboard
	local contextTarget
	local contextFrame
	local contextButtons = {}
	local closeContextMenu

	local function setMode(mode)
		toolMode = mode
		WorkspaceSettings.Value = mode or "none"
		drag = nil
		if mode == nil and closeContextMenu then closeContextMenu() end
		for button, buttonMode in pairs(modeButtons) do
			button.BackgroundTransparency = buttonMode == mode and MODE_ON or MODE_OFF
		end
		refreshTool()
	end

	local function normalizeWorkspaceMode(value)
		if typeof(value) ~= "string" then
			return nil
		end

		value = string.lower(string.match(value, "^%s*(.-)%s*$") or "")
		if value == "move" or value == "rotate" or value == "scale" then
			return value
		end

		return nil
	end

	-- Aplicar el valor guardado al iniciar; cualquier valor no reconocido pasa a "none".
	setMode(normalizeWorkspaceMode(WorkspaceSettings.Value))

	-- Mantener el modo sincronizado si otro script cambia WorkspaceSettings.Value.
	WorkspaceSettings:GetPropertyChangedSignal("Value"):Connect(function()
		local mode = normalizeWorkspaceMode(WorkspaceSettings.Value)
		local normalizedValue = mode or "none"

		if WorkspaceSettings.Value ~= normalizedValue then
			WorkspaceSettings.Value = normalizedValue
		end

		if toolMode ~= mode then
			setMode(mode)
		end
	end)

	local function createPart(definition)
		local character = LocalPlayer.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if not root then return end
		local humanoid = character:FindFirstChildOfClass("Humanoid")

		local look = root.CFrame.LookVector
		local flat = Vector3.new(look.X, 0, look.Z)
		if flat.Magnitude < 0.01 then
			flat = Vector3.new(0, 0, -1)
		else
			flat = flat.Unit
		end

		local part = Instance.new(definition.class)
		if definition.shape then
			part.Shape = definition.shape
		end
		if definition.size then
			part.Size = definition.size
		end
		part.Anchored = true
		part.CanCollide = true

		local origin = Vector3.new(
			root.Position.X + flat.X * CREATE_DISTANCE,
			root.Position.Y,
			root.Position.Z + flat.Z * CREATE_DISTANCE
		)
		local ignore = { character }
		if handleFolder then
			table.insert(ignore, handleFolder)
		end
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = ignore
		local hit = workspace:Raycast(origin + Vector3.new(0, 2, 0), Vector3.new(0, -1000, 0), params)
		local groundY
		if hit then
			groundY = hit.Position.Y
		else
			groundY = root.Position.Y - (humanoid and humanoid.HipHeight or 2) - root.Size.Y * 0.5
		end

		local position = Vector3.new(origin.X, groundY + part.Size.Y * 0.5, origin.Z)
		part.CFrame = CFrame.lookAt(position, position + flat)
		part.Parent = workspace
		recordObjectCreated(part)
		setSelection({part})
	end

	for name, definition in pairs(CREATORS) do
		local button = findOptional(Seccion2, name, "GuiButton")
		if button then
			button.Activated:Connect(function()
				createPart(definition)
			end)
		end
	end

	closeContextMenu = function()
		if contextBillboard then contextBillboard:Destroy() end
		contextBillboard = nil
		contextTarget = nil
		contextFrame = nil
		table.clear(contextButtons)
	end

	local function selectionParts()
		local parts = {}
		local seenParts = {}
		for _, instance in ipairs(selectedList) do
			if instance:IsA("BasePart") and not seenParts[instance] then
				seenParts[instance] = true
				table.insert(parts, instance)
			elseif instance:IsA("Model") then
				for _, descendant in ipairs(instance:GetDescendants()) do
					if descendant:IsA("BasePart") and not seenParts[descendant] then
						seenParts[descendant] = true
						table.insert(parts, descendant)
					end
				end
			end
		end
		return parts
	end

	local function addToggleHistory(propertyName, parts, nextValue)
		local changes = {}
		for _, part in ipairs(parts) do
			table.insert(changes, {instance = part, name = propertyName, old = part[propertyName], new = nextValue})
		end
		if #changes > 0 then
			table.insert(undoStack, changes)
			if #undoStack > 100 then table.remove(undoStack, 1) end
			table.clear(redoStack)
		end
		for _, part in ipairs(parts) do pcall(function() part[propertyName] = nextValue end) end
	end

	local function openContextMenu(target)
		closeContextMenu()
		if not target or not target:IsDescendantOf(workspace) then return end
		local adornee
		local sizeX = 1
		if target:IsA("BasePart") then
			adornee = target
			sizeX = target.Size.X
		elseif target:IsA("Model") then
			adornee = target.PrimaryPart or target:FindFirstChildWhichIsA("BasePart", true)
			local ok, _, bounds = pcall(function() return target:GetBoundingBox() end)
			if ok and bounds then sizeX = bounds.X end
		end
		if not adornee then return end
		local billboard = Instance.new("BillboardGui")
		billboard.Name = "OxusObjectContextMenu"
		billboard.Adornee = adornee
		billboard.AlwaysOnTop = true
		billboard.Active = true
		billboard.Enabled = true
		billboard.Size = UDim2.new(0, 300, 0, 300)
		billboard.StudsOffset = Vector3.new(sizeX * 1.2, 0, 0)
		billboard.ResetOnSpawn = false
		billboard.Parent = PlayerGui
		contextBillboard = billboard
		contextTarget = target

		local scrolling = Instance.new("ScrollingFrame")
		scrolling.Name = "Options"
		scrolling.Size = UDim2.new(1, 0, 1, 0)
		scrolling.Position = UDim2.new(0.5, 0, 0.5, 0)
		scrolling.AnchorPoint = Vector2.new(0.5, 0.5)
		scrolling.BackgroundTransparency = 1
		scrolling.Active = true
		scrolling.BorderSizePixel = 0
		scrolling.AutomaticCanvasSize = Enum.AutomaticSize.XY
		scrolling.CanvasSize = UDim2.new(0, 0, 1, 0)
		scrolling.ScrollingDirection = Enum.ScrollingDirection.XY
		scrolling.Parent = billboard
		contextFrame = scrolling

		local layout = Instance.new("UIListLayout")
		layout.Padding = UDim.new(0, 0)
		layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
		layout.SortOrder = Enum.SortOrder.LayoutOrder
		layout.Parent = scrolling

		local parts = selectionParts()
		local anchored = #parts > 0
		local collidable = #parts > 0
		for _, part in ipairs(parts) do
			anchored = anchored and part.Anchored
			collidable = collidable and part.CanCollide
		end
		local definitions = {
			{ text = "Move", action = function() setMode("move") end },
			{ text = "Rotation", action = function() setMode("rotate") end },
			{ text = "Scale", action = function() setMode("scale") end },
			{ text = "Anchore " .. tostring(anchored), action = function()
				local current = true
				for _, part in ipairs(selectionParts()) do current = current and part.Anchored end
				addToggleHistory("Anchored", selectionParts(), not current)
			end },
			{ text = "Colision " .. tostring(collidable), action = function()
				local current = true
				for _, part in ipairs(selectionParts()) do current = current and part.CanCollide end
				addToggleHistory("CanCollide", selectionParts(), not current)
			end },
			{ text = "Deleted", action = function()
				local toDelete = {}
				for _, instance in ipairs(selectedList) do
					local nested = false
					for _, other in ipairs(selectedList) do
						if other ~= instance and instance:IsDescendantOf(other) then nested = true break end
					end
					if not nested and instance.Parent then table.insert(toDelete, instance) end
				end
				local changes = {}
				for _, instance in ipairs(toDelete) do
					if instance.Parent then
						local pivot
						pcall(function() pivot = instance:GetPivot() end)
						table.insert(changes, {kind = "deleted", instance = instance, parent = instance.Parent, pivot = pivot})
					end
				end
				if #changes > 0 then
					table.insert(undoStack, changes)
					if #undoStack > 100 then table.remove(undoStack, 1) end
					table.clear(redoStack)
				end
				closeContextMenu()
				for _, instance in ipairs(toDelete) do if instance.Parent then instance.Parent = nil end end
				setSelection({})
			end },
			{ text = "Duplicate", action = function()
				local source = contextTarget
				if source and source.Parent then
					local copy = cloneForHistory(source)
					if copy then
						copy.Parent = source.Parent
						pcall(function() copy:PivotTo(source:GetPivot() * CFrame.new(2, 0, 0)) end)
						recordObjectCreated(copy)
						setSelection({copy})
					end
				end
			end },
			{ text = "Reset Rotation", action = function()
				local before = {}
				for _, instance in ipairs(selectedList) do
					if instance:IsA("BasePart") or instance:IsA("Model") then
						table.insert(before, {instance = instance, beforePivot = instance:GetPivot(), afterPivot = CFrame.new(instance:GetPivot().Position), beforeSize = instance:IsA("BasePart") and instance.Size or nil, afterSize = instance:IsA("BasePart") and instance.Size or nil, beforeScale = instance:IsA("Model") and instance:GetScale() or nil, afterScale = instance:IsA("Model") and instance:GetScale() or nil})
					end
				end
				for _, entry in ipairs(before) do pcall(function() entry.instance:PivotTo(entry.afterPivot) end) end
				if #before > 0 then pushHistory({kind = "transform", items = before}) end
			end },
		}
		for index, definition in ipairs(definitions) do
			local button = Instance.new("TextButton")
			button.Name = "Option" .. index
			button.LayoutOrder = index
			button.Size = UDim2.new(1, 0, 0.125, 0)
			button.Position = UDim2.new(0.5, 0, 0.5, 0)
			button.AnchorPoint = Vector2.new(0.5, 0.5)
			button.Active = true
			button.Selectable = true
			button.ZIndex = 10
			button.BackgroundTransparency = 0
			button.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
			button.TextColor3 = Color3.fromRGB(0, 0, 0)
			button.TextScaled = true
			button.Text = definition.text
			button.Parent = scrolling
			table.insert(contextButtons, button)
			button.Activated:Connect(function()
				local ok, err = pcall(definition.action)
				if not ok then warn("OxusGuiBeta: fallo la opcion " .. definition.text .. ": " .. tostring(err)) end
				if definition.text ~= "Deleted" then closeContextMenu() end
				if refreshToolShared then refreshToolShared() end
			end)
		end
	end

	local rightClickStartedAt = nil
	local rightClickStartPosition = nil
	local RIGHT_CLICK_HOLD_THRESHOLD = 0.22
	local RIGHT_CLICK_MOVE_THRESHOLD = 8

	UserInputService.InputBegan:Connect(function(input, processed)
		if input.UserInputType == Enum.UserInputType.MouseButton2 then
			rightClickStartedAt = os.clock()
			rightClickStartPosition = UserInputService:GetMouseLocation()
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton2 or not rightClickStartedAt then return end
		local elapsed = os.clock() - rightClickStartedAt
		local startPosition = rightClickStartPosition
		rightClickStartedAt = nil
		rightClickStartPosition = nil
		local endPosition = UserInputService:GetMouseLocation()
		if elapsed >= RIGHT_CLICK_HOLD_THRESHOLD or not startPosition or (endPosition - startPosition).Magnitude > RIGHT_CLICK_MOVE_THRESHOLD then return end
		if toolMode ~= "move" and toolMode ~= "rotate" and toolMode ~= "scale" then
			closeContextMenu()
			return
		end
		local camera = workspace.CurrentCamera
		if not camera then return end
		local ray = camera:ViewportPointToRay(endPosition.X, endPosition.Y)
		local result = castScene(ray)
		local hit = result and result.Instance
		if hit and hit:IsA("Terrain") then hit = nil end
		local target = hit and resolveTarget(hit, shiftHeld())
		if contextBillboard then
			closeContextMenu()
			return
		end
		if target then
			if not inSelection(target) then setSelection({target}) end
			openContextMenu(target)
		else
			closeContextMenu()
		end
	end)

	for name, mode in pairs(MODES) do
		local button = findOptional(Seccion2, name, "GuiButton")
		if button then
			modeButtons[button] = mode
			button.BackgroundTransparency = toolMode == mode and MODE_ON or MODE_OFF
			button.Activated:Connect(function()
				if toolMode == mode then
					setMode(nil)
				else
					setMode(mode)
				end
			end)
		end
	end

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or not toolMode or not isPress(input) then return end
		if PrincipalMenu.Visible and Gui.Enabled and isOver(PrincipalMenu, inputGuiPoint(input)) then return end
		local ray = rayFromInput(input)
		if not ray then return end

		local handle = castHandles(ray)
		if handle then
			beginHandleDrag(handle, input, ray)
			return
		end

		local result = castScene(ray)
		local hit = result and result.Instance
		if hit and hit:IsA("Terrain") then
			hit = nil
		end
		if not hit then
			setSelection({})
			refreshTool()
			return
		end

		local target = resolveTarget(hit, shiftHeld())
		if not target then
			setSelection({})
			refreshTool()
			return
		end
		local multi = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)
		if multi then
			local node = nodeByInstance[target]
			if node then
				toggleSelected(node)
			elseif not inSelection(target) then
				local nextSelection = table.clone(selectedList)
				table.insert(nextSelection, target)
				setSelection(nextSelection)
			end
		elseif not ( #selectedList == 1 and selectedList[1] == target ) then
			setSelection({ target })
		end
		refreshTool()
		toolsDirty = false
		if toolMode == "move" then
			beginBodyDrag(input)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if drag and (input == drag.input or isPress(input)) then
			endDrag()
		end
	end)

	RunService.Heartbeat:Connect(function()
		if toolsDirty then
			toolsDirty = false
			drag = nil
			refreshTool()
		end
		if toolMode and not drag then
			local now = os.clock()
			if now - lastFrameRefresh >= FRAME_REFRESH then
				lastFrameRefresh = now
				for index = #movables, 1, -1 do
					if not movables[index]:IsDescendantOf(workspace) then
						table.remove(movables, index)
					end
				end
				frameCF, frameSize = computeFrame(movables)
			end
		end
	end)

	RunService.RenderStepped:Connect(function()
		if drag then
			stepDrag()
		end
		if toolMode then
			updateHandles()
		end
	end)
end

