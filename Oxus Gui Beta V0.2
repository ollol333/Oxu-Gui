				if not masterOn(record) or not State.savedCFrame then
					return
				end
				teleportRoot(State.savedCFrame)
				flashBinder(binder)
			end
		end
	else
		binder.getColor = function()
			if not masterOn(record) or not binder.key then
				return WHITE_COLOR
			end
			local coloredToggle = {
				Fly1=true, Fly2=true, Flying=true, Locate=true, AutoRotate=true, Desanchore=true,
				TpLong=true, HitboxViewer=true, LastSpawnPosition=true, TpVoid=true, AntiFlying=true,
			}
			if coloredToggle[name] then
				return record.armed and GREEN_COLOR or FLY_RED_COLOR
			end
			return record.armed and WHITE_COLOR or PINK_COLOR
		end
		binder.onPress = function()
			if not masterOn(record) then
				return
			end
			record.armed = not record.armed
			if name == "ClickTeleport" then
				if record.armed then
					if not State.clickTeleportRenderConnection then
						State.clickTeleportRenderConnection = RunService.RenderStepped:Connect(updateClickTeleportMarker)
					end
				else
					clearClickTeleportMarker()
				end
			end
			if SPECIAL_POWERS[name] then
				State.updateSpecialPowerStates()
			elseif name == "HidlePlayer" or name == "SafeZone" or name == "AutoRemovalofEntities" then
				syncUtilityPower(name)
			end
			refreshBinder(binder)
		end
	end

	button.Activated:Connect(function()
		if State.capturing == binder then
			endCapture(binder, nil, false)
			return
		end
		if State.capturing then
			endCapture(State.capturing, nil, false)
		end
		State.capturing = binder
		button.Text = "Presiona Una Tecla"
	end)

	local originalOnPress = binder.onPress
	if originalOnPress then
		binder.onPress = function(...)
			originalOnPress(...)
			if queueSavePlayerSettings then queueSavePlayerSettings() end
		end
	end
	table.insert(State.binders, binder)
	refreshBinder(binder, true)
	return binder
end

function onMasterChanged(name)
	local record = State.records[name]
	if not record then
		return
	end
	if not masterOn(record) then
		record.armed = false
		if name == "Noclip" then
			setNoclip(false)
		elseif name == "ClickTeleport" then
			clearClickTeleportMarker()
		elseif name == "Locate" or name == "AutoRotate" or name == "Desanchore" then
			syncUtilityPower(name)
		elseif SPECIAL_POWERS[name] then
			State.updateSpecialPowerStates()
		end
	end
	if name == "CreatePromptTpPosition" then
		State.refreshPromptTeleportPower()
	end
	if SPECIAL_POWERS[name] then
		State.updateSpecialPowerStates()
	elseif name == "Locate" or name == "AutoRotate" or name == "Desanchore" or name == "HidlePlayer" or name == "SafeZone" or name == "AutoRemovalofEntities" then
		syncUtilityPower(name)
	end
	if name == "ClickTeleport" and not masterOn(record) then
		clearClickTeleportMarker()
	elseif name == "ClickTeleport" and masterOn(record) and record.armed and not State.clickTeleportRenderConnection then
		State.clickTeleportRenderConnection = RunService.RenderStepped:Connect(updateClickTeleportMarker)
	end
	for _, binder in pairs(record.binders) do
		refreshBinder(binder)
	end
	if queueSavePlayerSettings then queueSavePlayerSettings() end
end

function ensureMaster(container, button)
