RunService.Heartbeat:Connect(function()
	enforceBudget = ENFORCE_BUDGET
	for _, target in ipairs(allTargets) do
		if target.pending then
			target.pending = false
			if anchored then
				enforceTarget(target)
			end
		end
	end
	if not sectionIsOpen() then return end
	local now = os.clock()
	if refreshRequested or now - lastPoll >= POLL_INTERVAL then
		refreshRequested = false
		lastPoll = now
		objectsPanel.refresh()
		lightingPanel.refresh()
	end
end)
end

