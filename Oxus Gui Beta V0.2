do
local __mergedScriptName = "Explorer"

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")
local Gui = PlayerGui:WaitForChild("OxusGuiBeta")
local PrincipalMenu = Gui:WaitForChild("PrincipalMenu")
local Seccion8 = PrincipalMenu:WaitForChild("Seccion8")

local function nameMatches(name, wanted)
	if type(wanted) == "table" then
		return table.find(wanted, name) ~= nil
	end
	return name == wanted
end

local function waitDeep(root, name, className)
	local waited = 0
	local warned = false
	while true do
		for _, descendant in ipairs(root:GetDescendants()) do
			if nameMatches(descendant.Name, name) and (not className or descendant:IsA(className)) then
				return descendant
			end
		end
		task.wait(0.2)
		waited += 0.2
		if waited >= 5 and not warned then
			warned = true
			local label = type(name) == "table" and table.concat(name, "/") or name
			warn("OxusGuiSeccion8: no se encontro " .. label .. " dentro de " .. root:GetFullName())
		end
	end
end

do
	local ToolsList = waitDeep(Seccion8, "ToolsList", "ScrollingFrame")
	local EquipedList = waitDeep(Seccion8, "ToolsEquipedList", "ScrollingFrame")
	local SearchTools = waitDeep(Seccion8, "SearchTools", "TextBox")
	local SearchEquiped = waitDeep(Seccion8, "SearchEquipedTools", "TextBox")
	local ToolsTemplate = waitDeep(ToolsList, "Marc", "Frame")
	local EquipedTemplate = waitDeep(EquipedList, "Marc", "Frame")

	local ROW_ON = 0.9
	local ROW_OFF = 1
	local BUDGET = 0.004
	local REFRESH_INTERVAL = 0.3

	local templates = { owned = EquipedTemplate, available = ToolsTemplate }
	local holders = { owned = EquipedList, available = ToolsList }
	local queries = { owned = "", available = "" }
	local lists = { owned = {}, available = {} }
	local dirty = { owned = false, available = false }
	local records = {}
	local pending = {}
	local pendingSet = {}
	local pendingFirst = 1
	local pendingLast = 0
	local sequence = 0
	local lastRefresh = 0

	ToolsTemplate.Visible = false
	EquipedTemplate.Visible = false

	local function isOwned(tool)
		local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
		if backpack and tool:IsDescendantOf(backpack) then
			return true
		end
		if tool:IsDescendantOf(PlayerGui) then
			return true
		end
		local character = LocalPlayer.Character
		if character and tool:IsDescendantOf(character) then
			return true
		end
		return false
	end

	local function schedule(tool)
		if pendingSet[tool] then return end
		pendingSet[tool] = true
		pendingLast += 1
		pending[pendingLast] = tool
	end

	local function removeTool(tool)
		pcall(function()
			tool:Destroy()
		end)
	end

	local function giveTool(tool)
		local ok, clone = pcall(function()
			local copy = tool:Clone()
			if copy then
				return copy
			end
			local original = tool.Archivable
			tool.Archivable = true
			copy = tool:Clone()
			tool.Archivable = original
			return copy
		end)
		if not ok or not clone then return end
		clone.Parent = LocalPlayer:FindFirstChildOfClass("Backpack") or PlayerGui
	end

	local function paintEntry(record)
		local entry = record.entry
		local tool = record.tool
		local name = tool.Name
		record.sortName = string.lower(name)
		record.searchKey = record.sortName
		if not entry then return end
		entry.frame.Name = "Tool_" .. name
		if entry.nameLabel then
			entry.nameLabel.Text = name
		end
		if entry.icon then
			entry.icon.Image = tool.TextureId
		end
		dirty[record.kind] = true
	end

	local function destroyEntry(record)
		local entry = record.entry
		if not entry then return end
		record.entry = nil
		lists[record.kind][record] = nil
		if entry.connection then
			entry.connection:Disconnect()
		end
		entry.frame:Destroy()
		dirty[record.kind] = true
	end

	local function createEntry(record)
		local kind = record.kind
		local frame = templates[kind]:Clone()
		frame.BackgroundTransparency = kind == "owned" and ROW_ON or ROW_OFF
		frame.Visible = true
		local icon = frame:FindFirstChild("Icon", true)
		if icon and not (icon:IsA("ImageLabel") or icon:IsA("ImageButton")) then
			icon = nil
		end
		local nameLabel = frame:FindFirstChild("Name", true)
		if nameLabel and not (nameLabel:IsA("TextLabel") or nameLabel:IsA("TextButton") or nameLabel:IsA("TextBox")) then
			nameLabel = nil
		end
		local entry = { frame = frame, icon = icon, nameLabel = nameLabel }
		local button = frame:FindFirstChild("Button", true)
		if button and button:IsA("GuiButton") then
			entry.connection = button.Activated:Connect(function()
				if record.kind == "owned" then
					removeTool(record.tool)
				else
					giveTool(record.tool)
				end
			end)
		end
		record.entry = entry
		lists[kind][record] = true
		paintEntry(record)
		frame.Parent = holders[kind]
	end

	local function removeRecord(record)
		destroyEntry(record)
		for _, connection in ipairs(record.connections) do
			connection:Disconnect()
		end
		records[record.tool] = nil
	end

	local function classify(tool)
		local record = records[tool]
		if not tool:IsDescendantOf(game) then
			if record then
				removeRecord(record)
			end
			return
		end
		local kind = isOwned(tool) and "owned" or "available"
		if not record then
			sequence += 1
			record = { tool = tool, id = sequence, connections = {}, kind = kind }
			records[tool] = record
			table.insert(record.connections, tool:GetPropertyChangedSignal("Name"):Connect(function()
				paintEntry(record)
			end))
			table.insert(record.connections, tool:GetPropertyChangedSignal("TextureId"):Connect(function()
				paintEntry(record)
			end))
		elseif record.kind == kind then
			return
		else
			destroyEntry(record)
			record.kind = kind
		end
		createEntry(record)
	end

	local function refreshList(kind)
		dirty[kind] = false
		local query = queries[kind]
		local ordered = {}
		for record in pairs(lists[kind]) do
			table.insert(ordered, record)
		end
		table.sort(ordered, function(a, b)
			if a.sortName ~= b.sortName then
				return a.sortName < b.sortName
			end
			return a.id < b.id
		end)
		for index, record in ipairs(ordered) do
			local frame = record.entry.frame
			frame.LayoutOrder = index
			local show = query == "" or string.find(record.searchKey, query, 1, true) ~= nil
			if frame.Visible ~= show then
				frame.Visible = show
			end
		end
	end

	local function resyncAll()
		for tool in pairs(records) do
			schedule(tool)
		end
	end

	SearchTools:GetPropertyChangedSignal("Text"):Connect(function()
		queries.available = string.lower(string.match(SearchTools.Text, "^%s*(.-)%s*$") or "")
		refreshList("available")
	end)

	SearchEquiped:GetPropertyChangedSignal("Text"):Connect(function()
		queries.owned = string.lower(string.match(SearchEquiped.Text, "^%s*(.-)%s*$") or "")
		refreshList("owned")
	end)

	game.DescendantAdded:Connect(function(instance)
		if instance:IsA("Tool") then
			schedule(instance)
		end
	end)

	game.DescendantRemoving:Connect(function(instance)
		if records[instance] then
			schedule(instance)
		end
	end)

	LocalPlayer.CharacterAdded:Connect(resyncAll)
	LocalPlayer.ChildAdded:Connect(resyncAll)

	RunService.Heartbeat:Connect(function()
		if pendingFirst <= pendingLast then
			local started = os.clock()
			local processed = 0
			while pendingFirst <= pendingLast do
				local tool = pending[pendingFirst]
				pending[pendingFirst] = nil
				pendingFirst += 1
				pendingSet[tool] = nil
				classify(tool)
				processed += 1
				if processed % 16 == 0 and os.clock() - started > BUDGET then
					break
				end
			end
			if pendingFirst > pendingLast then
				pendingFirst = 1
				pendingLast = 0
			end
		end
		local now = os.clock()
		if pendingFirst > pendingLast or now - lastRefresh >= REFRESH_INTERVAL then
			for kind, isDirty in pairs(dirty) do
				if isDirty then
					refreshList(kind)
				end
			end
			lastRefresh = now
		end
	end)

	task.spawn(function()
		local count = 0
		for _, descendant in ipairs(game:GetDescendants()) do
			if descendant:IsA("Tool") then
				schedule(descendant)
			end
			count += 1
			if count % 5000 == 0 then
				task.wait()
			end
		end
	end)
end

do
	local ConfigBox = waitDeep(Seccion8, "Configuration", "TextBox")

	local CONFIG = {
		{ name = "PlayerSetting", label = "Player" },
		{ name = "PlayersSettings", label = "Players" },
		{ name = "WorkspaceSettings", label = "Workspace" },
		{ name = "LightingSettings", label = "Lighting" },
		{ name = "ConsolaSettings", label = "Consola" },
		{ name = "GuiSettings", label = "Gui" },
		{ name = "SoundManagerSettings", label = "SoundManager" },
		{ name = "CameraYVisualsSettings", label = "CameraYVisuals" },
		{ name = "ExplorerYToolsSettings", label = "ExplorerYTools" },
	}

	local labelSet = {}
	for _, item in ipairs(CONFIG) do
		labelSet[item.label] = item
	end

	local data = nil
	local found = Gui:FindFirstChild("Data") or Gui:WaitForChild("Data", 2)
	if found and found:IsA("Folder") then
		data = found
	else
		data = Instance.new("Folder")
		data.Name = "Data"
		data.Parent = Gui
	end

	local values = {}
	local connections = {}
	local rendered = {}

	local function buildText()
		local blocks = {}
		for _, item in ipairs(CONFIG) do
			local stringValue = values[item.label]
			local value = stringValue and stringValue.Value or ""
			rendered[item.label] = value
			table.insert(blocks, item.label .. ": " .. value)
		end
		return table.concat(blocks, "\n")
	end

	local function render()
		local text = buildText()
		if ConfigBox.Text ~= text then
			ConfigBox.Text = text
		end
	end

	local function requestRender()
		if ConfigBox:IsFocused() then return end
		render()
	end

	local function parseConfiguration(text)
		local result = {}
		local currentLabel = nil
		local lines = {}
		local function flush()
			if currentLabel then
				result[currentLabel] = table.concat(lines, "\n")
			end
		end
		for _, line in ipairs(string.split(text, "\n")) do
			local label, rest = string.match(line, "^([%w_]+):%s?(.*)$")
			if label and labelSet[label] then
				flush()
				currentLabel = label
				lines = { rest }
			elseif currentLabel then
				table.insert(lines, line)
			end
		end
		flush()
		return result
	end

	local function commit()
		local parsed = parseConfiguration(ConfigBox.Text)
		for label, text in pairs(parsed) do
			if text ~= rendered[label] then
				local stringValue = values[label]
				if stringValue and stringValue.Value ~= text then
					stringValue.Value = text
				end
				rendered[label] = text
			end
		end
	end

	local function bindValue(item, stringValue)
		if values[item.label] == stringValue then return end
		local previous = connections[item.label]
		if previous then
			previous:Disconnect()
		end
		values[item.label] = stringValue
		connections[item.label] = stringValue:GetPropertyChangedSignal("Value"):Connect(requestRender)
	end

	for _, item in ipairs(CONFIG) do
		local stringValue = data:FindFirstChild(item.name)
		if not stringValue or not stringValue:IsA("StringValue") then
			stringValue = Instance.new("StringValue")
			stringValue.Name = item.name
			stringValue.Parent = data
		end
		bindValue(item, stringValue)
	end

	data.ChildAdded:Connect(function(child)
		if not child:IsA("StringValue") then return end
		for _, item in ipairs(CONFIG) do
			if item.name == child.Name then
				bindValue(item, child)
				requestRender()
			end
		end
	end)

	ConfigBox.ClearTextOnFocus = false
	ConfigBox.MultiLine = true
	ConfigBox.FocusLost:Connect(function()
		commit()
		render()
	end)

	render()
end
end

