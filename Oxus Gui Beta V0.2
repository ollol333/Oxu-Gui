function startTpVoid()
	if State.tpVoidActive then return end
	local root = getRoot()
	if not (root and character) then return end
	State.tpVoidReturnCFrame = root.CFrame
	State.tpVoidActive = true
	dataTpVoidActive.Value = "true"
	createTpVoidPlatform()
	teleportToTpVoidCenter()
	State.tpVoidHeartbeatConnection = RunService.Heartbeat:Connect(function(dt)
		if not State.tpVoidActive then return end
		local currentRoot = getRoot()
		if not currentRoot then return end
		local currentPosition = currentRoot.Position
		local previousPosition = State.tpVoidLastPosition
		if previousPosition then
			local delta = (currentPosition - previousPosition).Magnitude
			local outsideZone = math.abs(currentPosition.X - (State.tpVoidCFrame and State.tpVoidCFrame.Position.X or 0)) > 500
				or math.abs(currentPosition.Z - (State.tpVoidCFrame and State.tpVoidCFrame.Position.Z or 0)) > 500
				or math.abs(currentPosition.Y - (State.tpVoidCFrame and State.tpVoidCFrame.Position.Y or currentPosition.Y)) > 25
			if delta > 25 then
				State.tpVoidReturnCFrame = currentRoot.CFrame
				teleportToTpVoidCenter()
			elseif outsideZone then
				teleportRoot(State.tpVoidCFrame)
			end
		end
		State.tpVoidLastPosition = currentRoot.Position
	end)
end

