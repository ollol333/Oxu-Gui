	State.masterEnsured[container] = true
	task.defer(function()
		if registeredToggles[container] then
			return
		end
		if container:GetAttribute("Activated") == nil then
			container:SetAttribute("Activated", false)
		end
		button.Activated:Connect(function()
			container:SetAttribute("Activated", not container:GetAttribute("Activated"))
		end)
	end)
