		end
	end
end

function setupPromptTeleportPower()
	if State.promptTeleportSetupDone then return end
	local powersFrame = find("PlayerPowers", "ScrollingFrame")
	local frame = (powersFrame and findIn(powersFrame, "CreatePromptTpPosition", "GuiObject")) or find("CreatePromptTpPosition", "GuiObject")
	if not frame then return end
	local record = State.records.CreatePromptTpPosition
	if not record then return end
	local keyBox = findIn(frame, "KeyActivationPrompt", "TextBox")
	if not keyBox then return end
	State.promptTeleportSetupDone = true

	local function applyKeyToPrompts()
		local trimmed = string.match(keyBox.Text or "", "^%s*(.-)%s*$") or ""
		local keyCode = readPromptKey(keyBox)
		if trimmed == "" or keyCode then
			keyBox.TextColor3 = GREEN_COLOR
			for _, entry in ipairs(State.promptTeleportParts) do
				if entry.prompt and entry.prompt.Parent then
					entry.prompt.KeyboardKeyCode = keyCode or Enum.KeyCode.E
				end
			end
		else
			keyBox.TextColor3 = PROMPT_RED_COLOR
		end
	end
	keyBox:GetPropertyChangedSignal("Text"):Connect(applyKeyToPrompts)
	keyBox.FocusLost:Connect(applyKeyToPrompts)
	applyKeyToPrompts()
	State.refreshPromptTeleportPower()
end

