local function flyInputDirection(camera)
	local direction = Vector3.zero
	local look = camera.CFrame.LookVector
	local right = camera.CFrame.RightVector
	if UserInputService:IsKeyDown(Enum.KeyCode.W) then direction += look end
	if UserInputService:IsKeyDown(Enum.KeyCode.S) then direction -= look end
	if UserInputService:IsKeyDown(Enum.KeyCode.D) then direction += right end
	if UserInputService:IsKeyDown(Enum.KeyCode.A) then direction -= right end
	if UserInputService:IsKeyDown(Enum.KeyCode.E) or UserInputService:IsKeyDown(Enum.KeyCode.Space) then
		direction += Vector3.yAxis
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.Q) or UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl) then
		direction -= Vector3.yAxis
	end
	if direction.Magnitude > 1 then direction = direction.Unit end
	return direction
end

local function startFly(mode)
	if State.flyMode == mode then return end
	stopFly(true)
	local root = getRoot()
	if not root or not humanoid or humanoid.Health <= 0 then return end
	State.flyMode = mode
	State.flyStartedAt = os.clock()
	State.flyLastPosition = root.Position
	State.flyCurrentVelocity = Vector3.zero

	if mode == "Fly2" then
		State.flyOriginalAnchored = root.Anchored
		root.Anchored = true
	else
		humanoid.PlatformStand = true
		State.flyVelocity = Instance.new("BodyVelocity")
		State.flyVelocity.Name = "OxusFlyVelocity"
		State.flyVelocity.MaxForce = Vector3.new(1e9, 1e9, 1e9)
		State.flyVelocity.P = 1e5
		State.flyVelocity.Velocity = Vector3.zero
		State.flyVelocity.Parent = root
		State.flyGyro = Instance.new("BodyGyro")
		State.flyGyro.Name = "OxusFlyGyro"
		State.flyGyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
		State.flyGyro.P = 1e5
		State.flyGyro.D = 1000
		State.flyGyro.CFrame = root.CFrame
		State.flyGyro.Parent = root
	end

	State.flyRenderConnection = RunService.RenderStepped:Connect(function(deltaTime)
		if not State.flyMode then return end
		local currentRoot = getRoot()
		local camera = workspace.CurrentCamera
		if not currentRoot or not camera or not humanoid or humanoid.Health <= 0 then
			stopFly(true)
			return
		end

		local direction = flyInputDirection(camera)
		local fast = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)
		local targetVelocity = direction * State.flySpeed * (fast and 2 or 1)
		local blend = 1 - math.exp(-deltaTime / 3)
		State.flyCurrentVelocity = State.flyCurrentVelocity:Lerp(targetVelocity, blend)
		local velocity = State.flyCurrentVelocity
		local bobTime = os.clock() - State.flyStartedAt
		local idleBob = 0
		if direction.Magnitude < 0.01 then
			idleBob = math.sin(bobTime * math.pi * 2) * 0.15
		end

		if State.flyMode == "Fly2" then
			deltaTime = math.clamp(deltaTime, 0, 1 / 20)
			local basePosition = (State.flyLastPosition or currentRoot.Position) + velocity * deltaTime
			State.flyLastPosition = basePosition
			local displayPosition = basePosition + Vector3.new(0, idleBob, 0)
			local flatLook = Vector3.new(camera.CFrame.LookVector.X, 0, camera.CFrame.LookVector.Z)
			if flatLook.Magnitude < 0.01 then flatLook = Vector3.new(0, 0, -1) else flatLook = flatLook.Unit end
			currentRoot.CFrame = CFrame.lookAt(displayPosition, displayPosition + flatLook)
		else
			local bobVelocity = 0
			if direction.Magnitude < 0.01 then
				bobVelocity = math.cos(bobTime * math.pi * 2) * (math.pi * 2 * 0.15)
			end
			if State.flyVelocity then State.flyVelocity.Velocity = velocity + Vector3.new(0, bobVelocity, 0) end
			if State.flyGyro then State.flyGyro.CFrame = camera.CFrame end
		end
	end)
end

local function stopFling()
	State.flingActive = false
	State.flingToken = State.flingToken + 1
end

local function startFling()
	if State.flingActive then return end
	State.flingActive = true
	State.flingToken = State.flingToken + 1
	local token = State.flingToken
	task.spawn(function()
		local bob = 0.1
		while State.flingActive and State.flingToken == token do
			RunService.Heartbeat:Wait()
			local root = getRoot()
			if root and root.Parent then
				local current = root.AssemblyLinearVelocity
				root.AssemblyLinearVelocity = current * 10000 + Vector3.new(0, 10000, 0)
				RunService.RenderStepped:Wait()
				if root.Parent then
					root.AssemblyLinearVelocity = current
				end
				RunService.Stepped:Wait()
				if root.Parent then
					root.AssemblyLinearVelocity = current + Vector3.new(0, bob, 0)
				end
				bob = -bob
			end
		end
	end)
end

