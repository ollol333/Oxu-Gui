local function bindEffectPower(spec)
	if effectRecords[spec.name] then return true end

	local powers = findPowersFrame()
	if not powers then return false end
	local frame = findByName(powers, spec.name, "GuiObject")
	if not frame then return false end

	local needsMode = spec.kind == "avoid"
	local master = findByName(frame, "ButtonActivationClick", "TextButton")
	local keyButton = findByName(frame, "KeyBindActivation", "TextButton")
	local modeButton = needsMode and findByName(frame, "ModeButton", "TextButton") or nil
	local radioBox = needsMode and findByName(frame, "Radio", "TextBox") or nil
	local needsMirror = spec.kind == "aim"
	local mirror = needsMirror and findByName(frame, "ObjectMirrow", "TextButton") or nil
	if not (master and keyButton) or (needsMode and not (modeButton and radioBox)) or (needsMirror and not mirror) then
		return false
	end

	local record = {
		name = spec.name,
		effect = true,
		loop = true,
		kind = spec.kind,
		controller = effectControllers[spec.kind],
		dataName = spec.name .. "Active",
		bindName = "OxusEffect_" .. spec.name,
		frame = frame,
		container = master.Parent,
		keyButton = keyButton,
		stroke = keyButton:FindFirstChildOfClass("UIStroke"),
		radioBox = radioBox,
		mode = needsMode and "TP" or "Humanoid",
		key = nil,
		armed = false,
		running = false,
		bound = false,
		retryAt = 0,
		applied = {},
		tweens = {},
		flashToken = 0,
	}
	effectRecords[spec.name] = record
	setData(record.dataName, "false")

	if modeButton then
		modeButton.Text = "Modo TP"
		setData(spec.name .. "Mode", record.mode)
		modeButton.Activated:Connect(function()
			record.mode = record.mode == "TP" and "Caminata" or "TP"
			modeButton.Text = record.mode == "TP" and "Modo TP" or "Modo Caminata"
			setData(spec.name .. "Mode", record.mode)
		end)
	end
	if mirror then
		mirror.Text = "Object: " .. record.mode
		setData(spec.name .. "Mode", record.mode)
		mirror.Activated:Connect(function()
			local index = table.find(CFG.AIM_MODES, record.mode) or 1
			record.mode = CFG.AIM_MODES[index % #CFG.AIM_MODES + 1]
			mirror.Text = "Object: " .. record.mode
			setData(spec.name .. "Mode", record.mode)
		end)
	end
	if radioBox then
		bindNumberBox(radioBox, false)
	end

	keyButton.Activated:Connect(function()
		if capturing == record then
			endCapture(record, nil, false)
			return
		end
		if capturing then
			endCapture(capturing, nil, false)
		end
		capturing = record
		keyButton.Text = "Presiona Una Tecla"
	end)

	record.container:GetAttributeChangedSignal("Activated"):Connect(function()
		onMasterChanged(record)
	end)

	refreshKey(record, true)
	return true
end

local function bindEffectPowers()
	if effectPowersDone then return end
	local complete = true
	for _, spec in ipairs(EFFECT_POWERS) do
		if not bindEffectPower(spec) then
			complete = false
		end
	end
	effectPowersDone = complete
end

local lastEffectStep = 0
RunService.Heartbeat:Connect(function()
	local now = os.clock()
	if now - lastEffectStep < CFG.EFFECT_INTERVAL then return end
	lastEffectStep = now
	for _, record in pairs(effectRecords) do
		if record.running and record.controller.step then
			record.controller.step(record)
		end
	end
end)

UserInputService.InputBegan:Connect(function(input, processed)
	if capturing then
		if input.UserInputType == Enum.UserInputType.Keyboard then
			local keyCode = input.KeyCode
			if keyCode == Enum.KeyCode.Escape then
				endCapture(capturing, nil, false)
			elseif keyCode == Enum.KeyCode.Backspace or keyCode == Enum.KeyCode.Delete then
				endCapture(capturing, nil, true)
			elseif keyCode ~= Enum.KeyCode.Tab and keyCode ~= Enum.KeyCode.Unknown then
				endCapture(capturing, keyCode, true)
			end
		end
		return
	end

	if processed or UserInputService:GetFocusedTextBox() then
		return
	end

	if input.UserInputType == Enum.UserInputType.Keyboard then
		for _, group in ipairs({ tpRecords, effectRecords }) do
			for _, record in pairs(group) do
				if record.key and record.key == input.KeyCode then
					pressKey(record)
				end
			end
		end
	end
end)

