	dataTpVoidActive.Value = "false"
	if State.tpVoidHeartbeatConnection then
		State.tpVoidHeartbeatConnection:Disconnect()
		State.tpVoidHeartbeatConnection = nil
	end
	destroyTpVoidPlatform()
	if restorePosition and State.tpVoidReturnCFrame then
		teleportRoot(State.tpVoidReturnCFrame)
	end
	State.tpVoidCFrame = nil
	State.tpVoidReturnCFrame = nil
	State.tpVoidLastPosition = nil
