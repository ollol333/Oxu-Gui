		return nil
	end
	return character:FindFirstChild("HumanoidRootPart")
end

function masterOn(record)
	return record.container:GetAttribute("Activated") == true
end

function powerEnabled(record)
	return masterOn(record) and record.armed
end

function keyLabel(keyCode)
	local ok, text = pcall(function()
		return UserInputService:GetStringForKeyCode(keyCode)
	end)
	if ok and text and text ~= "" then
		return text
	end
	return keyCode.Name
end

function colorBinder(binder, color, instant)
	for _, tween in ipairs(binder.tweens) do
		tween:Cancel()
	end
	table.clear(binder.tweens)

	if instant then
		binder.button.TextColor3 = color
		if binder.stroke then
			binder.stroke.Color = color
		end
		return
	end

	local textTween = TweenService:Create(binder.button, TWEEN_INFO, { TextColor3 = color })
	textTween:Play()
	table.insert(binder.tweens, textTween)

	if binder.stroke then
		local strokeTween = TweenService:Create(binder.stroke, TWEEN_INFO, { Color = color })
		strokeTween:Play()
		table.insert(binder.tweens, strokeTween)
	end
end

function refreshBinder(binder, instant)
	binder.flashToken = binder.flashToken + 1
	if State.capturing ~= binder then
		if binder.key then
			binder.button.Text = "Keybind: " .. keyLabel(binder.key)
		else
			binder.button.Text = "Keybind:None"
		end
	end
	colorBinder(binder, binder.getColor(), instant)
end

function flashBinder(binder)
	if not binder then
		return
	end
	binder.flashToken = binder.flashToken + 1
	local token = binder.flashToken
	colorBinder(binder, GREEN_COLOR)
	task.delay(TWEEN_INFO.Time, function()
		if binder.flashToken == token then
			colorBinder(binder, binder.getColor())
		end
	end)
end

function endCapture(binder, newKey, assign)
	State.capturing = nil
	if assign then
		binder.key = newKey
	end
	refreshBinder(binder)
	if queueSavePlayerSettings then queueSavePlayerSettings() end
end

function setNoclip(on)
	State.noclipActive = on
	dataNoclipActive.Value = tostring(on)
	for part in pairs(State.noclipParts) do
		if on then
			setOverride(part, "CanCollide", false)
		else
			clearOverride(part, "CanCollide")
		end
	end
end

function trackNoclipPart(instance)
	if instance:IsA("BasePart") and not State.noclipParts[instance] then
		State.noclipParts[instance] = true
		if State.noclipActive then
			setOverride(instance, "CanCollide", false)
		end
	end
end

