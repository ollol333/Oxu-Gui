local function viewportInputBegan(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragInput = input
		dragStart = input.Position
		startYaw, startPitch = yaw, pitch
	end
end
Viewport.InputBegan:Connect(viewportInputBegan)
UserInputService.InputChanged:Connect(function(input)
	if not dragging or not dragStart then return end
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		local delta = input.Position - dragStart
		yaw = startYaw - delta.X * (math.pi * 2 / math.max(Viewport.AbsoluteSize.X, 1))
		pitch = math.clamp(startPitch - delta.Y * math.pi / math.max(Viewport.AbsoluteSize.Y, 1), -1.2, 1.2)
	end
end)
UserInputService.InputEnded:Connect(function(input)
	if input == dragInput or input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = false
		dragInput = nil
	end
end)

local function sectionIsOpen()
	return Seccion1.Visible and Gui.Enabled
end

RunService.RenderStepped:Connect(function(dt)
	if not sectionIsOpen() then return end
	local now = os.clock()
	if listDirty or now - lastListUpdate >= 1 then
		lastListUpdate = now
		rebuildLists()
	end

	local preview = getPreviewTarget()
	if preview ~= displayedPlayer then updateViewport(preview) end

	local world = Viewport:FindFirstChildOfClass("WorldModel")
	local model = world and world:GetChildren()[1]
	if model and model:IsA("Model") then
		if not dragging then yaw += dt * (math.pi * 2 / 6) end
		local cf, size = model:GetBoundingBox()
		local center = cf.Position
		previewRadius = math.max(size.Magnitude * 0.5, 2)
		local aspect = Viewport.AbsoluteSize.X / math.max(Viewport.AbsoluteSize.Y, 1)
		local effective = math.atan(math.tan(math.rad(camera.FieldOfView / 2)) * math.min(aspect, 1))
		local distance = previewRadius / math.sin(math.max(effective, 0.05))
		local offset = Vector3.new(math.sin(yaw) * distance, math.sin(pitch) * distance * 0.55, math.cos(yaw) * distance)
		camera.CFrame = CFrame.lookAt(center + offset, center)
	end

	if now - lastInfoUpdate >= 0.25 then
		lastInfoUpdate = now
		refreshInfo(preview)
		for _, byPlayer in pairs(records) do
			for _, record in pairs(byPlayer) do updateRecord(record) end
		end
	end
end)

Seccion1:GetPropertyChangedSignal("Visible"):Connect(function()
	if Seccion1.Visible then
		listDirty = true
		task.defer(function()
			rebuildLists()
			filterList(PlayersListEffects, PlayerEffectsBox.Text)
			filterList(PlayersListTp, PlayerTpBox.Text)
			local preview = getPreviewTarget()
			updateViewport(preview)
			refreshInfo(preview)
		end)
	end
end)

if sectionIsOpen() then
	rebuildLists()
	filterList(PlayersListEffects, PlayerEffectsBox.Text)
	filterList(PlayersListTp, PlayerTpBox.Text)
end

local configChangeGuard = {}
for name, default in pairs(CONFIG_DEFAULTS) do
	local item = CONFIG_DATA:FindFirstChild(name)
	if item and item:IsA("StringValue") then
		item:GetPropertyChangedSignal("Value"):Connect(function()
			if configChangeGuard[name] then return end
			local parsed = parseConfig(name, item.Value)
			if parsed == nil then
				configChangeGuard[name] = true
				item.Value = default
				configChangeGuard[name] = nil
				CFG[name] = parseConfig(name, default)
			else
				CFG[name] = parsed
			end

			-- Actualiza los elementos que muestran colores/estados ya existentes.
			if name == "SELECTED_COLOR" or name == "NORMAL_COLOR" or name == "HEALTH_GREEN"
				or name == "HEALTH_YELLOW" or name == "HEALTH_RED" or name == "HEALTH_BLACK" then
				for list, byPlayer in pairs(records) do
					for target, record in pairs(byPlayer) do
						if target and target.Parent then
							if name == "SELECTED_COLOR" or name == "NORMAL_COLOR" then
								setMarcSelected(record, selectedByList[list][target] == true)
							else
								updateRecord(record)
							end
						end
					end
				end
			end

			if name == "TWEEN_INFO" or name == "GREEN_COLOR" or name == "PINK_COLOR" or name == "WHITE_COLOR" then
				for _, group in ipairs({ tpRecords, effectRecords }) do
					for _, record in pairs(group) do
						refreshKey(record, true)
					end
				end
			end

			if name == "INFO_SIZE" or name == "INFO_STROKE_COLOR" then
				for _, record in pairs(effectRecords) do
					for _, state in pairs(record.applied or {}) do
						if state.gui and state.gui.Parent and name == "INFO_SIZE" then
							state.gui.Size = CFG.INFO_SIZE
						end
						if state.label and state.label.Parent and name == "INFO_STROKE_COLOR" then
							local stroke = state.label:FindFirstChildOfClass("UIStroke")
							if stroke then stroke.Color = CFG.INFO_STROKE_COLOR end
						end
					end
				end
			end
		end)
	end
end

end

do
local __mergedScriptName = "Sound"

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")
local Gui = PlayerGui:WaitForChild("OxusGuiBeta")
local PrincipalMenu = Gui:WaitForChild("PrincipalMenu")
local Seccion6 = PrincipalMenu:WaitForChild("Seccion6")

local selected = {}
local selectedList = {}
local nodeByInstance = {}
local propsDirty = false
local playerDirty = false
local paintHook = nil

local knownSounds = {}
local volumeConnections = {}
local lastVolume = setmetatable({}, { __mode = "k" })
local muted = false
local ownedSound = nil
local soundAddedHook = nil
local soundRemovedHook = nil

local function nameMatches(name, wanted)
	if type(wanted) == "table" then
		return table.find(wanted, name) ~= nil
	end
	return name == wanted
end

local function waitDeep(root, name, className)
	local waited = 0
	local warned = false
	while true do
		for _, descendant in ipairs(root:GetDescendants()) do
			if nameMatches(descendant.Name, name) and (not className or descendant:IsA(className)) then
				return descendant
			end
		end
		task.wait(0.2)
		waited += 0.2
		if waited >= 5 and not warned then
			warned = true
			local label = type(name) == "table" and table.concat(name, "/") or name
			warn("OxusGuiSeccion6: no se encontro " .. label .. " dentro de " .. root:GetFullName())
		end
	end
end

local function sectionIsOpen()
	return Seccion6.Visible and Gui.Enabled
end

local function isPress(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
end

local function ctrlHeld()
	return UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
		or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)
		or UserInputService:IsKeyDown(Enum.KeyCode.LeftMeta)
		or UserInputService:IsKeyDown(Enum.KeyCode.RightMeta)
end

local coordinateProbe = Instance.new("Frame")
coordinateProbe.Name = "OxusCoordinateProbeSeccion6"
coordinateProbe.BackgroundTransparency = 1
coordinateProbe.BorderSizePixel = 0
coordinateProbe.Active = false
coordinateProbe.Interactable = false
coordinateProbe.Size = UDim2.new(0, 1, 0, 1)
coordinateProbe.Position = UDim2.new(0, 0, 0, 0)
coordinateProbe.Parent = Gui

local function guiShift()
	local origin = Gui.IgnoreGuiInset and Vector2.zero or GuiService:GetGuiInset()
	return origin - coordinateProbe.AbsolutePosition
end

local function inputGuiPoint(input)
	local raw
	if input.UserInputType == Enum.UserInputType.Touch then
		raw = Vector2.new(input.Position.X, input.Position.Y) + GuiService:GetGuiInset()
	else
		raw = UserInputService:GetMouseLocation()
	end
	return raw - guiShift()
end

local function isOver(gui, point)
	local position = gui.AbsolutePosition
	local size = gui.AbsoluteSize
	return point.X >= position.X
		and point.X <= position.X + size.X
		and point.Y >= position.Y
		and point.Y <= position.Y + size.Y
end

local function paintInstance(instance)
	local node = nodeByInstance[instance]
	if node and paintHook then
		paintHook(node)
	end
end

local function setSelection(list)
	local previous = table.clone(selectedList)
	table.clear(selectedList)
	table.clear(selected)
	for _, instance in ipairs(list) do
		if not selected[instance] then
			selected[instance] = true
			table.insert(selectedList, instance)
		end
	end
	for _, instance in ipairs(previous) do
		paintInstance(instance)
	end
	for _, instance in ipairs(selectedList) do
		paintInstance(instance)
	end
	propsDirty = true
	playerDirty = true
end

local function enforceVolume(sound)
	local volume = sound.Volume
	if muted and sound ~= ownedSound then
		if volume ~= 0 then
			lastVolume[sound] = volume
			sound.Volume = 0
		end
	else
		lastVolume[sound] = volume
	end
end

local function applyMute()
	for sound in pairs(knownSounds) do
		if muted and sound ~= ownedSound then
			if sound.Volume ~= 0 then
				lastVolume[sound] = sound.Volume
				sound.Volume = 0
			end
		else
			local saved = lastVolume[sound]
			if saved ~= nil and sound.Volume ~= saved then
				sound.Volume = saved
			end
		end
	end
end

local function trackSound(sound)
	if knownSounds[sound] then return end
	knownSounds[sound] = true
	if lastVolume[sound] == nil then
		lastVolume[sound] = sound.Volume
	end
	volumeConnections[sound] = sound:GetPropertyChangedSignal("Volume"):Connect(function()
		enforceVolume(sound)
	end)
	enforceVolume(sound)
	if soundAddedHook then
		soundAddedHook(sound)
	end
end

local function untrackSound(sound)
	if not knownSounds[sound] then return end
	knownSounds[sound] = nil
	local connection = volumeConnections[sound]
	if connection then
		connection:Disconnect()
		volumeConnections[sound] = nil
	end
	if ownedSound == sound then
		ownedSound = nil
	end
	if soundRemovedHook then
		soundRemovedHook(sound)
	end
end

local function considerSound(instance)
	if instance:IsA("Sound") and not instance:IsDescendantOf(Gui) then
		trackSound(instance)
	end
end

for _, container in ipairs({ Workspace, SoundService, ReplicatedStorage, ReplicatedFirst, Lighting, LocalPlayer }) do
	for _, descendant in ipairs(container:GetDescendants()) do
		considerSound(descendant)
	end
	container.DescendantAdded:Connect(considerSound)
	container.DescendantRemoving:Connect(function(instance)
		if instance:IsA("Sound") then
			untrackSound(instance)
		end
	end)
end

do
	local ExplorerFrame = waitDeep(Seccion6, "ExplorerSounds", "ScrollingFrame")
	local SearchBox = waitDeep(Seccion6, "SearchExplorerSounds", "TextBox")
	local HolderTemplate = waitDeep(ExplorerFrame, "MarcObject", "ScrollingFrame")
	local RowSource = waitDeep(HolderTemplate, "MarcFrameObject", "Frame")

	local SELECTED_COLOR = Color3.fromRGB(50, 50, 50)
	local ARROW_CLOSED = "▷"
	local ARROW_OPEN = "▽"
	local BUILD_BATCH = 30
	local FRAME_BUDGET = 0.006
	local DEFAULT_ROW_HEIGHT = 24
	local PRUNE_INTERVAL = 0.5
	local CHILD_WIDTH_FACTOR = 0.9
	local MIN_CHILD_WIDTH_FACTOR = 0.25

	local rowTemplate = RowSource:Clone()
	local rowSize = RowSource.Size
	local rowBaseColor = RowSource.BackgroundColor3
	local rowBaseTransparency = RowSource.BackgroundTransparency
	local rowHeight = rowSize.Y.Offset
	if rowHeight <= 0 then rowHeight = RowSource.AbsoluteSize.Y end
	if rowHeight <= 0 then rowHeight = DEFAULT_ROW_HEIGHT end

	local function widthFactorForDepth(depth)
		return math.max(MIN_CHILD_WIDTH_FACTOR, CHILD_WIDTH_FACTOR ^ math.max(depth, 0))
	end
	HolderTemplate.Visible = false

	local rootMap = {}
	local dirty = {}
	local rootSequence = 0
	local query = ""
	local built = false
	local building = false
	local lastPrune = 0
	local warnedMissing = false

	local createNode
	local destroyNode
	local setExpanded
	local toggleSelected
	local clickSelect
	local refreshArrow
	local onChildAdded
	local onChildRemoved
	local onRename

	local function markDirty(node)
		dirty[node.root] = true
	end

	local function markAllDirty()
		for _, root in pairs(rootMap) do
			dirty[root] = true
		end
	end

	local function paintRow(node)
		local isSelected = selected[node.instance] == true
		node.row.BackgroundColor3 = isSelected and SELECTED_COLOR or rowBaseColor
		node.row.BackgroundTransparency = isSelected and 0 or rowBaseTransparency
	end

	paintHook = paintRow

	local function bindClick(node, gui, callback)
		if not gui then return end
		if gui:IsA("GuiButton") then
			table.insert(node.connections, gui.Activated:Connect(function(input)
				callback(input)
			end))
			return
		end
		table.insert(node.connections, gui.InputBegan:Connect(function(input)
			if isPress(input) then
				callback(input)
			end
		end))
	end

	local function prepareHolder(holder)
		holder.Visible = true
		holder.ScrollingEnabled = false
		holder.ScrollBarThickness = 0
		local layout = holder:FindFirstChildOfClass("UIListLayout")
		if not layout then
			layout = Instance.new("UIListLayout")
			layout.Parent = holder
		end
		layout.FillDirection = Enum.FillDirection.Vertical
		layout.SortOrder = Enum.SortOrder.LayoutOrder
		layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	
		return layout
	end

	refreshArrow = function(node)
		local button = node.openButton
		if not button then return end
		local text = ""
		if #node.instance:GetChildren() > 0 then
			text = node.expanded and ARROW_OPEN or ARROW_CLOSED
		end
		if button.Text ~= text then
			button.Text = text
		end
	end

	createNode = function(instance, parent)
		local node = {
			instance = instance,
			parent = parent,
			depth = parent and parent.depth + 1 or 0,
			children = {},
			childMap = {},
			connections = {},
			expanded = false,
			shown = true,
			token = 0,
			lower = string.lower(instance.Name),
		}

		local row
		if parent then
			node.root = parent.root
			row = rowTemplate:Clone()
			row.Name = "Row"
			local widthFactor = widthFactorForDepth(node.depth)
			row.Size = UDim2.new(
				rowSize.X.Scale * widthFactor,
				rowSize.X.Offset * widthFactor,
				0,
				rowHeight
			)
			row.Visible = true
			row.Parent = node.root.holder
			table.insert(parent.children, node)
			parent.childMap[instance] = node
		else
			node.root = node
			rootSequence += 1
			local holder = HolderTemplate:Clone()
			holder.Name = "Object_" .. rootSequence
			holder.LayoutOrder = rootSequence
			local layout = prepareHolder(holder)
			holder.Size = UDim2.new(1, 0, 0, rowHeight)
			node.holder = holder
			node.padding = layout.Padding.Offset
			row = holder:FindFirstChild("MarcFrameObject")
			row.Size = UDim2.new(1, 0, 0, rowHeight)
			row.Visible = true
			holder.Parent = ExplorerFrame
			rootMap[instance] = node
		end

		node.row = row
		node.nameLabel = row:FindFirstChild("NameObject", true)
		node.openButton = row:FindFirstChild("OpenObject", true)
		node.clickButton = row:FindFirstChild("ClickButtonInteract", true)
		nodeByInstance[instance] = node

		if node.nameLabel then
			node.nameLabel.Text = instance.Name
		end

		if not node.openButton and not warnedMissing then
			warnedMissing = true
			warn("OxusGuiSeccion6: la fila no tiene OpenObject")
		end

		local function clickedOpenArea(input)
			local button = node.openButton
			if not button or not input or not button.Visible or button.Text == "" then
				return false
			end
			return isOver(button, inputGuiPoint(input))
		end

		bindClick(node, node.openButton, function()
			setExpanded(node, not node.expanded)
		end)
		bindClick(node, node.clickButton, function(input)
			if clickedOpenArea(input) then
				setExpanded(node, not node.expanded)
			else
				clickSelect(node)
			end
		end)

		table.insert(node.connections, instance.ChildAdded:Connect(function(child)
			onChildAdded(node, child)
		end))
		table.insert(node.connections, instance.ChildRemoved:Connect(function(child)
			onChildRemoved(node, child)
		end))
		table.insert(node.connections, instance:GetPropertyChangedSignal("Name"):Connect(function()
			onRename(node)
		end))

		paintRow(node)
		refreshArrow(node)
		markDirty(node)
		return node
	end

	destroyNode = function(node, skipGui)
		for _, connection in ipairs(node.connections) do
			connection:Disconnect()
		end
		table.clear(node.connections)
		node.token += 1
		dirty[node] = nil
		if nodeByInstance[node.instance] == node then
			nodeByInstance[node.instance] = nil
		end
		local childSkip = skipGui or node.parent == nil
		for _, child in ipairs(node.children) do
			destroyNode(child, childSkip)
		end
		table.clear(node.children)
		table.clear(node.childMap)
		if not skipGui then
			if node.parent then
				node.row:Destroy()
			else
				node.holder:Destroy()
			end
		end
	end

	onChildAdded = function(node, child)
		if node.expanded and not node.childMap[child] then
			createNode(child, node)
			markDirty(node)
		end
		refreshArrow(node)
	end

	onChildRemoved = function(node, child)
		local childNode = node.childMap[child]
		if childNode then
			node.childMap[child] = nil
			local index = table.find(node.children, childNode)
			if index then
				table.remove(node.children, index)
			end
			destroyNode(childNode, false)
			markDirty(node)
		end
		refreshArrow(node)
	end

	onRename = function(node)
		node.lower = string.lower(node.instance.Name)
		if node.nameLabel then
			node.nameLabel.Text = node.instance.Name
		end
		if query ~= "" then
			markDirty(node)
		end
	end

	local function populate(node)
		node.token += 1
		local token = node.token
		local list = node.instance:GetChildren()
		for index, child in ipairs(list) do
			if node.token ~= token or not node.expanded then return end
			if child.Parent == node.instance and not node.childMap[child] then
				createNode(child, node)
			end
			if index % BUILD_BATCH == 0 then
				markDirty(node)
				task.wait()
			end
		end
		markDirty(node)
	end

	setExpanded = function(node, value)
		if node.expanded == value then return end
		if value and not node.instance:FindFirstChildWhichIsA("Instance") then return end
		node.expanded = value
		if value then
			task.spawn(populate, node)
		else
			node.token += 1
			for _, child in ipairs(node.children) do
				destroyNode(child, false)
			end
			table.clear(node.children)
			table.clear(node.childMap)
			markDirty(node)
		end
		refreshArrow(node)
	end

	toggleSelected = function(node)
		local instance = node.instance
		if selected[instance] then
			selected[instance] = nil
			local index = table.find(selectedList, instance)
			if index then
				table.remove(selectedList, index)
			end
		else
			selected[instance] = true
			table.insert(selectedList, instance)
		end
		paintRow(node)
		propsDirty = true
		playerDirty = true
	end

	clickSelect = function(node)
		local instance = node.instance
		if ctrlHeld() then
			toggleSelected(node)
		elseif #selectedList == 1 and selected[instance] then
			setSelection({})
		else
			setSelection({ instance })
		end
	end

	local function evaluate(node)
		local matches = query == "" or string.find(node.lower, query, 1, true) ~= nil
		local childShown = false
		for _, child in ipairs(node.children) do
			if evaluate(child) then
				childShown = true
			end
		end
		node.shown = matches or childShown
		return node.shown
	end

	local function place(node, count)
		local row = node.row
		if node.shown then
			count += 1
			row.LayoutOrder = count
		end
		if row.Visible ~= node.shown then
			row.Visible = node.shown
		end
		for _, child in ipairs(node.children) do
			count = place(child, count)
		end
		return count
	end

	local function relayout(root)
		local holder = root.holder
		if not holder or not holder.Parent then
			return
		end

		evaluate(root)
		place(root, 0)

		local layout = holder:FindFirstChildOfClass("UIListLayout")
		if not layout then
			holder.Visible = root.shown
			return
		end

		local function updateHeight()
			if not holder.Parent then
				return
			end

			local totalHeight = layout.AbsoluteContentSize.Y
			local currentSize = holder.Size

			if totalHeight < rowHeight then
				totalHeight = rowHeight
			end

			totalHeight = math.ceil(totalHeight)

			if currentSize.Y.Scale ~= 0 or currentSize.Y.Offset ~= totalHeight then
				holder.Size = UDim2.new(
					currentSize.X.Scale,
					currentSize.X.Offset,
					0,
					totalHeight
				)
			end

			holder.Visible = root.shown
		end

		updateHeight()

		task.defer(function()
			if not holder.Parent then
				return
			end

			updateHeight()
		end)
	end

	local function processDirty()
		local started = os.clock()
		for root in pairs(dirty) do
			dirty[root] = nil
			relayout(root)
			if os.clock() - started > FRAME_BUDGET then
				break
			end
		end
	end

	local function buildRoots()
		if built or building then return end
		building = true
		task.spawn(function()
			local list = {}
			for sound in pairs(knownSounds) do
				table.insert(list, sound)
			end
			table.sort(list, function(a, b)
				local nameA = string.lower(a.Name)
				local nameB = string.lower(b.Name)
				if nameA ~= nameB then
					return nameA < nameB
				end
				return a:GetFullName() < b:GetFullName()
			end)
			for index, sound in ipairs(list) do
				if knownSounds[sound] and sound.Parent and not rootMap[sound] then
					createNode(sound, nil)
				end
				if index % BUILD_BATCH == 0 then
					task.wait()
				end
			end
			built = true
			building = false
		end)
	end

	soundAddedHook = function(sound)
		if (built or building) and not rootMap[sound] then
			createNode(sound, nil)
		end
	end

	soundRemovedHook = function(sound)
		local node = rootMap[sound]
		if node then
			rootMap[sound] = nil
			destroyNode(node, false)
		end
	end

	SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
		query = string.lower(string.match(SearchBox.Text, "^%s*(.-)%s*$") or "")
		markAllDirty()
	end)

	local function pruneSelection()
		for index = #selectedList, 1, -1 do
			local instance = selectedList[index]
			if not instance:IsDescendantOf(game) then
				table.remove(selectedList, index)
				selected[instance] = nil
				propsDirty = true
				playerDirty = true
			end
		end
	end

	RunService.Heartbeat:Connect(function()
		if not sectionIsOpen() then return end
		if not built and not building then
			buildRoots()
		end
		local now = os.clock()
		if now - lastPrune >= PRUNE_INTERVAL then
			lastPrune = now
			pruneSelection()
		end
		processDirty()
	end)

	Seccion6:GetPropertyChangedSignal("Visible"):Connect(function()
		if Seccion6.Visible then
			propsDirty = true
			playerDirty = true
			markAllDirty()
		end
	end)
end

do
	local PlayButton = waitDeep(Seccion6, "Play", "ImageButton")
	local UndoButton = waitDeep(Seccion6, "Undo", "ImageButton")
	local RedoButton = waitDeep(Seccion6, "Redo", "ImageButton")
	local MuteButton = waitDeep(Seccion6, "Mute", "ImageButton")
	local LoopButton = waitDeep(Seccion6, "Bucle", "ImageButton")
	local IconSound = waitDeep(Seccion6, "IconSound", "ImageLabel")
	local SoundViewer = waitDeep(Seccion6, "SoundViewer", "Frame")
	local Bar = waitDeep(Seccion6, "Bar", "Frame")
	local Line = waitDeep(Bar, "Line", "Frame")
	local TimeHandle = waitDeep(Bar, "Click", "TextButton")
	local VolumeFrame = waitDeep(Seccion6, "Volumen", "Frame")
	local VolumeLine = waitDeep(VolumeFrame, "Line", "Frame")
	local VolumeHandle = waitDeep(VolumeFrame, "BarClick", "TextButton")
	local VolumePercent = waitDeep(VolumeFrame, "Porcentaje", "TextLabel")
	local DurationNormal = waitDeep(Seccion6, "DurationNormal", "TextLabel")
	local DurationToFinish = waitDeep(Seccion6, "DurationToFinish", "TextLabel")
	local NameSound = waitDeep(Seccion6, "NameSound", "TextLabel")

	local DEFAULT_COVER = "rbxassetid://79813355473197"
	local ICON_PLAY = "rbxassetid://138194288843901"
	local ICON_PAUSE = "rbxassetid://86285017735945"
	local ICON_MUTE_ON = "rbxassetid://120419353234086"
	local ICON_MUTE_OFF = "rbxassetid://82016937910211"
	local ICON_LOOP = "rbxassetid://96844650261974"
	local BUTTON_ON = 0.8
	local BUTTON_OFF = 1
	local REWIND_SECONDS = 2
	local FORWARD_SECONDS = 5
	local VOLUME_MAX = 1
	local COVER_ATTRIBUTES = { "Cover", "CoverImage", "Icon", "Image", "Thumbnail" }
	local BAR_COUNT = 36
	local BAR_FILL = 0.6
	local BAR_COLOR = Color3.fromRGB(235, 235, 235)
	local BAR_MIN = 0.04
	local LOUDNESS_REF = 400

	local TimeTrack = TimeHandle.Parent:IsA("GuiObject") and TimeHandle.Parent or Bar
	local VolumeTrack = VolumeHandle.Parent:IsA("GuiObject") and VolumeHandle.Parent or VolumeFrame

	local currentSound = nil
	local drag = nil
	local shownKey = nil
	local shownTime = nil
	local shownPercent = nil
	local shownProgress = nil
	local shownPlaying = nil
	local shownLoop = nil
	local shownVolume = nil
	local shownVolumeText = nil
	local coverCache = {}
	local bars = {}
	local smoothLevel = 0
	local clock = 0

	Line.AnchorPoint = Vector2.new(0.5, 0.5)
	VolumeLine.AnchorPoint = Vector2.new(0.5, 0.5)
	TimeHandle.AnchorPoint = Vector2.new(0.5, 0.5)
	VolumeHandle.AnchorPoint = Vector2.new(0.5, 0.5)

	local function formatTime(seconds)
		local total = math.max(0, math.floor(seconds))
		return string.format("%02d:%02d", total // 60, total % 60)
	end

	local function setFill(line, handle, fraction)
		line.Size = UDim2.new(fraction, 0, 1, 0)
		line.Position = UDim2.new(fraction / 2, 0, 0.5, 0)
		handle.Position = UDim2.new(fraction, 0, 0.5, 0)
	end

	local function paintMute()
		MuteButton.Image = muted and ICON_MUTE_ON or ICON_MUTE_OFF
		MuteButton.BackgroundTransparency = muted and BUTTON_ON or BUTTON_OFF
	end

	local function displayedVolume(sound)
		if muted and sound ~= ownedSound then
			local saved = lastVolume[sound]
			if saved ~= nil then
				return saved
			end
		end
		return sound.Volume
	end

	local function setVolume(sound, value)
		lastVolume[sound] = value
		sound.Volume = value
	end

	local function resolveCover(sound, key)
		for _, attributeName in ipairs(COVER_ATTRIBUTES) do
			local value = sound:GetAttribute(attributeName)
			if type(value) == "number" and value > 0 then
				IconSound.Image = "rbxassetid://" .. tostring(math.floor(value))
				return
			elseif type(value) == "string" and value ~= "" then
				IconSound.Image = value
				return
			end
		end
		local id = tonumber(string.match(sound.SoundId, "%d+"))
		if not id then return end
		local cached = coverCache[id]
		if cached == nil then
			local ok, info = pcall(function()
				return MarketplaceService:GetProductInfo(id, Enum.InfoType.Asset)
			end)
			local raw = ok and info and info.IconImageAssetId or nil
			local icon = tonumber(raw) or 0
			cached = icon > 0 and ("rbxassetid://" .. tostring(math.floor(icon))) or false
			coverCache[id] = cached
		end
		if cached and shownKey == key then
			IconSound.Image = cached
		end
	end

	local function refreshInfo()
		local sound = currentSound
		local key = ""
		if sound then
			key = sound.Name .. "\n" .. sound.SoundId
		end
		if key == shownKey then return end
		shownKey = key
		IconSound.Image = DEFAULT_COVER
		if not sound then
			NameSound.Text = ""
			return
		end
		local idText = string.match(sound.SoundId, "%d+") or sound.SoundId
		if idText ~= "" then
			NameSound.Text = sound.Name .. " - " .. idText
		else
			NameSound.Text = sound.Name
		end
		task.spawn(resolveCover, sound, key)
	end

	local function refreshCurrent()
		local found = nil
		for index = #selectedList, 1, -1 do
			local instance = selectedList[index]
			if instance:IsA("Sound") and knownSounds[instance] then
				found = instance
				break
			end
		end
		if found == currentSound then return end
		currentSound = found
		drag = nil
		if ownedSound and ownedSound ~= found then
			local previous = ownedSound
			ownedSound = nil
			pcall(function()
				previous:Stop()
			end)
			applyMute()
		end
	end

	local function togglePlay()
		local sound = currentSound
		if not sound then return end
		if sound.IsPlaying then
			sound:Pause()
			return
		end
		ownedSound = sound
		applyMute()
		local length = sound.TimeLength
		if length > 0 and sound.TimePosition >= length - 0.05 then
			sound.TimePosition = 0
		end
		sound:Play()
	end

	local function seek(delta)
		local sound = currentSound
		if not sound then return end
		local length = sound.TimeLength
		if length <= 0 then return end
		sound.TimePosition = math.clamp(sound.TimePosition + delta, 0, length)
	end

	local function toggleLoop()
		local sound = currentSound
		if not sound then return end
		sound.Looped = not sound.Looped
	end

	local function updateDrag(point)
		if not drag then return end
		local track = drag.kind == "time" and TimeTrack or VolumeTrack
		local position = track.AbsolutePosition
		local size = track.AbsoluteSize
		drag.fraction = math.clamp((point.X - position.X) / math.max(size.X, 1), 0, 1)
		if drag.kind == "volume" and currentSound then
			setVolume(currentSound, drag.fraction * VOLUME_MAX)
		end
	end

	local function beginDrag(kind, input)
		local sound = currentSound
		if not sound then return end
		if kind == "time" and sound.TimeLength <= 0 then return end
		drag = { kind = kind, input = input, fraction = 0 }
		updateDrag(inputGuiPoint(input))
	end

	local function endDrag()
		local finished = drag
		drag = nil
		if not finished or finished.kind ~= "time" then return end
		local sound = currentSound
		if not sound then return end
		local length = sound.TimeLength
		if length <= 0 then return end
		sound.TimePosition = math.clamp(finished.fraction * length, 0, length)
	end

	local function updateProgress()
		local sound = currentSound
		local position = 0
		local length = 0
		if sound then
			position = math.max(sound.TimePosition, 0)
			length = math.max(sound.TimeLength, 0)
		end
		local progress = length > 0 and math.clamp(position / length, 0, 1) or 0
		if drag and drag.kind == "time" then
			progress = drag.fraction
			position = progress * length
		end
		local timeText = formatTime(position) .. " / " .. formatTime(length)
		if timeText ~= shownTime then
			shownTime = timeText
			DurationNormal.Text = timeText
		end
		local percentText = tostring(math.floor(progress * 100)) .. "%"
		if percentText ~= shownPercent then
			shownPercent = percentText
			DurationToFinish.Text = percentText
		end
		if progress ~= shownProgress then
			shownProgress = progress
			setFill(Line, TimeHandle, progress)
		end
	end

	local function updateVolume()
		local sound = currentSound
		local volume = 0
		if sound then
			volume = displayedVolume(sound)
		end
		if drag and drag.kind == "volume" then
			volume = drag.fraction * VOLUME_MAX
		end
		local fraction = math.clamp(volume / VOLUME_MAX, 0, 1)
		if fraction ~= shownVolume then
			shownVolume = fraction
			setFill(VolumeLine, VolumeHandle, fraction)
		end
		local text = tostring(math.floor(volume * 100 + 0.5)) .. "%"
		if text ~= shownVolumeText then
			shownVolumeText = text
			VolumePercent.Text = text
		end
	end

	local function updateLoop()
		local active = currentSound ~= nil and currentSound.Looped
		if active ~= shownLoop then
			shownLoop = active
			LoopButton.BackgroundTransparency = active and BUTTON_ON or BUTTON_OFF
		end
	end

	local function updatePlayIcon()
		local playing = currentSound ~= nil and currentSound.IsPlaying
		if playing ~= shownPlaying then
			shownPlaying = playing
			PlayButton.Image = playing and ICON_PAUSE or ICON_PLAY
		end
	end

	local function buildBars()
		SoundViewer.ClipsDescendants = true
		for index = 1, BAR_COUNT do
			local frame = Instance.new("Frame")
			frame.Name = "Beat_" .. index
			frame.BackgroundColor3 = BAR_COLOR
			frame.BorderSizePixel = 0
			frame.AnchorPoint = Vector2.new(0.5, 1)
			frame.Position = UDim2.new((index - 0.5) / BAR_COUNT, 0, 1, 0)
			frame.Size = UDim2.new(BAR_FILL / BAR_COUNT, 0, BAR_MIN, 0)
			frame.Parent = SoundViewer
			table.insert(bars, {
				frame = frame,
				value = 0,
				shown = BAR_MIN,
				shape = 1 - 0.45 * (index - 1) / math.max(BAR_COUNT - 1, 1),
				speed = 2 + ((index * 7) % 11) / 11 * 6,
				phase = (index * 2.399) % (math.pi * 2),
			})
		end
	end

	local function updateViewer(dt)
		local sound = currentSound
		local level = 0
		if sound and sound.IsPlaying then
			level = math.clamp(sound.PlaybackLoudness / LOUDNESS_REF, 0, 1)
		end
		smoothLevel += (level - smoothLevel) * math.min(1, dt * (level > smoothLevel and 20 or 6))
		clock += dt
		for _, bar in ipairs(bars) do
			local wave = 0.5 + 0.5 * math.sin(clock * bar.speed + bar.phase)
			local target = smoothLevel * bar.shape * (0.3 + 0.7 * wave)
			bar.value += (target - bar.value) * math.min(1, dt * (target > bar.value and 25 or 8))
			local height = math.max(bar.value, BAR_MIN)
			if math.abs(height - bar.shown) > 0.002 then
				bar.shown = height
				bar.frame.Size = UDim2.new(BAR_FILL / BAR_COUNT, 0, height, 0)
			end
		end
	end

	buildBars()
	paintMute()
	PlayButton.Image = ICON_PLAY
	shownPlaying = false
	LoopButton.Image = ICON_LOOP
	LoopButton.BackgroundTransparency = BUTTON_OFF
	shownLoop = false
	IconSound.Image = DEFAULT_COVER
	setFill(Line, TimeHandle, 0)
	setFill(VolumeLine, VolumeHandle, 0)
	shownProgress = 0
	shownVolume = 0

	PlayButton.Activated:Connect(togglePlay)
	UndoButton.Activated:Connect(function()
		seek(-REWIND_SECONDS)
	end)
	RedoButton.Activated:Connect(function()
		seek(FORWARD_SECONDS)
	end)
	LoopButton.Activated:Connect(toggleLoop)
	MuteButton.Activated:Connect(function()
		muted = not muted
		paintMute()
		applyMute()
	end)

	TimeHandle.InputBegan:Connect(function(input)
		if isPress(input) and not drag then
			beginDrag("time", input)
		end
	end)

	VolumeHandle.InputBegan:Connect(function(input)
		if isPress(input) and not drag then
			beginDrag("volume", input)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if not drag then return end
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			updateDrag(inputGuiPoint(input))
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if drag and (input == drag.input or isPress(input)) then
			endDrag()
		end
	end)

	RunService.Heartbeat:Connect(function(dt)
		if not sectionIsOpen() then return end
		if playerDirty then
			playerDirty = false
			refreshCurrent()
		end
		refreshInfo()
		updateProgress()
		updateVolume()
		updateLoop()
		updatePlayIcon()
		updateViewer(dt)
	end)
end

do
	local PropsSearch = waitDeep(Seccion6, "SearchPropiedadesSound", "TextBox")
