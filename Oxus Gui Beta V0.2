	local function fmtNum(number)
		local text = string.format("%.4f", number)
		text = string.gsub(text, "0+$", "")
		text = string.gsub(text, "%.$", "")
		if text == "" or text == "-0" or text == "-" then
			text = "0"
		end
		return text
	end

	local function serializeValue(value)
		local kind = typeof(value)
		if kind == "number" then
			return fmtNum(value)
		elseif kind == "string" then
			return value
		elseif kind == "Vector3" then
			return fmtNum(value.X) .. ", " .. fmtNum(value.Y) .. ", " .. fmtNum(value.Z)
		elseif kind == "Vector2" then
			return fmtNum(value.X) .. ", " .. fmtNum(value.Y)
		elseif kind == "UDim" then
			return fmtNum(value.Scale) .. ", " .. fmtNum(value.Offset)
		elseif kind == "UDim2" then
			return "{" .. fmtNum(value.X.Scale) .. ", " .. fmtNum(value.X.Offset) .. "}, {" .. fmtNum(value.Y.Scale) .. ", " .. fmtNum(value.Y.Offset) .. "}"
		elseif kind == "CFrame" then
			local rx, ry, rz = value:ToOrientation()
			return fmtNum(value.X) .. ", " .. fmtNum(value.Y) .. ", " .. fmtNum(value.Z) .. ", "
				.. fmtNum(math.deg(rx)) .. ", " .. fmtNum(math.deg(ry)) .. ", " .. fmtNum(math.deg(rz))
		elseif kind == "NumberRange" then
			return fmtNum(value.Min) .. ", " .. fmtNum(value.Max)
		elseif kind == "Rect" then
			return fmtNum(value.Min.X) .. ", " .. fmtNum(value.Min.Y) .. ", " .. fmtNum(value.Max.X) .. ", " .. fmtNum(value.Max.Y)
		elseif kind == "BrickColor" then
			return value.Name
		elseif kind == "NumberSequence" then
			local parts = {}
			for _, keypoint in ipairs(value.Keypoints) do
				table.insert(parts, string.format('"Hora %s Valor %s"', fmtNum(keypoint.Time), fmtNum(keypoint.Value)))
			end
			return "[" .. table.concat(parts, ",") .. "]"
		elseif kind == "ColorSequence" then
			local parts = {}
			for _, keypoint in ipairs(value.Keypoints) do
				local color = keypoint.Value
				table.insert(parts, string.format(
					'"Hora %s Color %d,%d,%d"',
					fmtNum(keypoint.Time),
					math.floor(color.R * 255 + 0.5),
					math.floor(color.G * 255 + 0.5),
					math.floor(color.B * 255 + 0.5)
					))
			end
			return "[" .. table.concat(parts, ",") .. "]"
		end
		return tostring(value)
	end

	local function numbersIn(text)
		local list = {}
		for token in string.gmatch(text, "%-?%d*%.?%d+") do
			local number = tonumber(token)
			if number then
				table.insert(list, number)
			end
		end
		return list
	end

	local function sequenceEntries(text)
		local entries = {}
		for entry in string.gmatch(text, '"([^"]*)"') do
			table.insert(entries, entry)
		end
		if #entries == 0 then
			for entry in string.gmatch(text, "[^;%[%]]+") do
				table.insert(entries, entry)
			end
		end
		return entries
	end

	local function normalizePoints(points)
		if #points == 0 then return nil end
		table.sort(points, function(a, b)
			return a.time < b.time
		end)
		points[1].time = 0
		if #points == 1 then
			table.insert(points, { time = 1, value = points[1].value })
		end
		points[#points].time = 1
		local result = {}
		local last = -1
		for _, point in ipairs(points) do
			if point.time > last then
				table.insert(result, point)
				last = point.time
			end
		end
		if #result < 2 then return nil end
		return result
	end

	local function parseNumberSequence(text)
		local points = {}
		for _, entry in ipairs(sequenceEntries(text)) do
			local numbers = numbersIn(entry)
			if #numbers >= 2 then
				table.insert(points, { time = math.clamp(numbers[1], 0, 1), value = numbers[2] })
			end
		end
		points = normalizePoints(points)
		if not points then return nil end
		local keypoints = {}
		for _, point in ipairs(points) do
			table.insert(keypoints, NumberSequenceKeypoint.new(point.time, point.value))
		end
		return NumberSequence.new(keypoints)
	end

	local function parseColorSequence(text)
		local points = {}
		for _, entry in ipairs(sequenceEntries(text)) do
			local numbers = numbersIn(entry)
			if #numbers >= 4 then
				table.insert(points, {
					time = math.clamp(numbers[1], 0, 1),
					value = Color3.fromRGB(math.clamp(numbers[2], 0, 255), math.clamp(numbers[3], 0, 255), math.clamp(numbers[4], 0, 255)),
				})
			end
		end
		points = normalizePoints(points)
		if not points then return nil end
		local keypoints = {}
		for _, point in ipairs(points) do
			table.insert(keypoints, ColorSequenceKeypoint.new(point.time, point.value))
		end
		return ColorSequence.new(keypoints)
	end

	local function parseValue(text, current)
		local kind = typeof(current)
		if kind == "string" then
			return text
		elseif kind == "BrickColor" then
			return BrickColor.new(text)
		elseif kind == "NumberSequence" then
			return parseNumberSequence(text)
		elseif kind == "ColorSequence" then
			return parseColorSequence(text)
		end
		local n = numbersIn(text)
		if kind == "number" then
			return n[1]
		elseif kind == "Vector3" then
			if #n >= 3 then return Vector3.new(n[1], n[2], n[3]) end
			if #n == 1 then return Vector3.new(n[1], n[1], n[1]) end
		elseif kind == "Vector2" then
			if #n >= 2 then return Vector2.new(n[1], n[2]) end
			if #n == 1 then return Vector2.new(n[1], n[1]) end
		elseif kind == "UDim" then
			if #n >= 2 then return UDim.new(n[1], n[2]) end
		elseif kind == "UDim2" then
			if #n >= 4 then return UDim2.new(n[1], n[2], n[3], n[4]) end
		elseif kind == "CFrame" then
			if #n >= 12 then return CFrame.new(table.unpack(n, 1, 12)) end
			if #n >= 6 then
				return CFrame.new(n[1], n[2], n[3]) * CFrame.fromOrientation(math.rad(n[4]), math.rad(n[5]), math.rad(n[6]))
			end
			if #n >= 3 then return CFrame.new(n[1], n[2], n[3]) * current.Rotation end
		elseif kind == "NumberRange" then
			if #n >= 2 then return NumberRange.new(math.min(n[1], n[2]), math.max(n[1], n[2])) end
			if #n == 1 then return NumberRange.new(n[1]) end
		elseif kind == "Rect" then
			if #n >= 4 then return Rect.new(n[1], n[2], n[3], n[4]) end
		end
		return nil
	end

	local function sameValue(a, b)
		if a == b then return true end
		local kind = typeof(a)
		if kind ~= typeof(b) then return false end
		if kind == "NumberSequence" or kind == "ColorSequence" then
			return serializeValue(a) == serializeValue(b)
		end
		return false
	end

	local function readProp(instance, name)
		if instance:IsA("Model") then
			if name == "Position" then return instance:GetPivot().Position end
			if name == "Orientation" then
				local x, y, z = instance:GetPivot():ToOrientation()
				return Vector3.new(math.deg(x), math.deg(y), math.deg(z))
			end
			if name == "CFrame" then return instance:GetPivot() end
		end
		if string.sub(name, 1, 1) == "@" then
			return instance:GetAttribute(string.sub(name, 2))
		end
		local ok, value = pcall(function()
			return instance[name]
		end)
		if ok then
			return value
		end
		return nil
	end

	local function recordPropertyChange(name, value)
		if historyApplying then return end
		local changes = {}
		for _, instance in ipairs(selectedList) do
			table.insert(changes, { instance = instance, name = name, old = readProp(instance, name), new = value })
		end
		if #changes > 0 then
			table.insert(undoStack, changes)
			if #undoStack > 100 then table.remove(undoStack, 1) end
			table.clear(redoStack)
		end
	end

	local function writeProp(name, value, skipHistory)
		local isAttribute = string.sub(name, 1, 1) == "@"
		local key = isAttribute and string.sub(name, 2) or name
		if not skipHistory then recordPropertyChange(name, value) end
		for _, instance in ipairs(selectedList) do
			pcall(function()
				if isAttribute then
					instance:SetAttribute(key, value)
				elseif instance:IsA("Model") and (key == "Position" or key == "Orientation" or key == "CFrame") then
					local pivot = instance:GetPivot()
					if key == "Position" then
						instance:PivotTo(CFrame.new(value) * pivot.Rotation)
					elseif key == "Orientation" then
						instance:PivotTo(CFrame.new(pivot.Position) * CFrame.fromOrientation(math.rad(value.X), math.rad(value.Y), math.rad(value.Z)))
					else
						instance:PivotTo(value)
					end
				else
					instance[key] = value
				end
			end)
		end
	end

	local function applyHistory(stackFrom, stackTo, useOld)
		local changes = table.remove(stackFrom)
		if not changes then return end
		historyApplying = true
		local reverse = {}
		for _, change in ipairs(changes) do
			if change.kind == "created" then
				local instance = change.instance
				if instance and instance.Parent then
					local parent = instance.Parent
					local pivot
					pcall(function() pivot = instance:GetPivot() end)
					instance.Parent = nil
					table.insert(reverse, {kind = "deleted", instance = instance, parent = parent, pivot = pivot})
				end
			elseif change.kind == "deleted" then
				local restored = change.instance
				if restored and change.parent and change.parent.Parent then
					restored.Parent = change.parent
					if change.pivot then pcall(function() restored:PivotTo(change.pivot) end) end
					table.insert(reverse, {kind = "created", instance = restored})
				end
			elseif change.kind == "transform" then
				local reversedItems = {}
				for _, itemChange in ipairs(change.items) do
					local instance = itemChange.instance
					if instance and instance.Parent then
						local current = {instance = instance, pivot = instance:GetPivot(), size = instance:IsA("BasePart") and instance.Size or nil, scale = instance:IsA("Model") and instance:GetScale() or nil}
						local targetPivot = useOld and itemChange.beforePivot or itemChange.afterPivot
						local targetSize = useOld and itemChange.beforeSize or itemChange.afterSize
						local targetScale = useOld and itemChange.beforeScale or itemChange.afterScale
						pcall(function()
							if instance:IsA("BasePart") and targetSize then instance.Size = targetSize end
							if instance:IsA("Model") and targetScale then instance:ScaleTo(targetScale) end
							instance:PivotTo(targetPivot)
						end)
						local beforePivot, afterPivot = current.pivot, targetPivot
						local beforeSize, afterSize = current.size, targetSize
						local beforeScale, afterScale = current.scale, targetScale
						if useOld then
							beforePivot, afterPivot = targetPivot, current.pivot
							beforeSize, afterSize = targetSize, current.size
							beforeScale, afterScale = targetScale, current.scale
						end
						table.insert(reversedItems, {instance = instance, beforePivot = beforePivot, afterPivot = afterPivot, beforeSize = beforeSize, afterSize = afterSize, beforeScale = beforeScale, afterScale = afterScale})
					end
				end
				table.insert(reverse, {kind = "transform", items = reversedItems})
			elseif change.instance and change.instance.Parent then
				local current = readProp(change.instance, change.name)
				local target = change[useOld and "old" or "new"]
				local reverseOld, reverseNew = target, current
				if not useOld then reverseOld, reverseNew = current, target end
				table.insert(reverse, {instance = change.instance, name = change.name, old = reverseOld, new = reverseNew})
				pcall(function()
					if string.sub(change.name, 1, 1) == "@" then
						change.instance:SetAttribute(string.sub(change.name, 2), target)
					elseif change.instance:IsA("Model") and (change.name == "Position" or change.name == "Orientation" or change.name == "CFrame") then
						local pivot = change.instance:GetPivot()
						if change.name == "Position" then
							change.instance:PivotTo(CFrame.new(target) * pivot.Rotation)
						elseif change.name == "Orientation" then
							change.instance:PivotTo(CFrame.new(pivot.Position) * CFrame.fromOrientation(math.rad(target.X), math.rad(target.Y), math.rad(target.Z)))
						else
							change.instance:PivotTo(target)
						end
					else
						change.instance[change.name] = target
					end
				end)
			end
		end
		historyApplying = false
		if #reverse > 0 then table.insert(stackTo, reverse) end
		propsDirty = true
		viewerDirty = true
		toolsDirty = true
		if refreshToolShared then refreshToolShared() end
	end

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or UserInputService:GetFocusedTextBox() then return end
		local ctrl = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)
		if not ctrl then return end
		if input.KeyCode == Enum.KeyCode.Z then
			applyHistory(undoStack, redoStack, true)
		elseif input.KeyCode == Enum.KeyCode.Y then
			applyHistory(redoStack, undoStack, false)
		end
	end)

	local function readShared(name)
		local first = readProp(selectedList[1], name)
		for index = 2, #selectedList do
			if not sameValue(first, readProp(selectedList[index], name)) then
				return first, true
			end
		end
		return first, false
	end

	local function propertyNamesFor(instance)
		local names = {}
		local seen = {}
		for _, set in ipairs(PROPERTY_SETS) do
			if instance:IsA(set[1]) then
				for _, name in ipairs(set[2]) do
					if not seen[name] then
						seen[name] = true
						table.insert(names, name)
					end
				end
			end
		end
		return names
	end

	local function sharedProperties()
		local list = {}
		local first = selectedList[1]
		if not first then return list end
		for _, name in ipairs(propertyNamesFor(first)) do
			local firstValue = readProp(first, name)
			local kind = KIND_BY_TYPE[typeof(firstValue)]
			if kind then
				local compatible = true
				for index = 2, #selectedList do
					if typeof(readProp(selectedList[index], name)) ~= typeof(firstValue) then
						compatible = false
						break
					end
				end
				if compatible then
					table.insert(list, { name = name, kind = kind })
				end
			end
		end
		local attributeNames = {}
		for attributeName, attributeValue in pairs(first:GetAttributes()) do
			local kind = KIND_BY_TYPE[typeof(attributeValue)]
			if kind and kind ~= "enum" then
				local compatible = true
				for index = 2, #selectedList do
					if typeof(selectedList[index]:GetAttribute(attributeName)) ~= typeof(attributeValue) then
						compatible = false
						break
					end
				end
				if compatible then
					table.insert(attributeNames, attributeName)
				end
			end
		end
		table.sort(attributeNames)
		for _, attributeName in ipairs(attributeNames) do
			table.insert(list, { name = "@" .. attributeName, kind = KIND_BY_TYPE[typeof(first:GetAttribute(attributeName))] })
		end
		return list
	end

	local function describeSelection()
		local count = #selectedList
		if count == 0 then
			return "Propiedades"
		end
		local first = selectedList[1]
		if count == 1 then
			return string.format('Propiedades - %s "%s"', first.ClassName, first.Name)
		end
		local sameClass = true
		local sameName = true
		for index = 2, count do
			local other = selectedList[index]
			if other.ClassName ~= first.ClassName then
				sameClass = false
			end
			if other.Name ~= first.Name then
				sameName = false
			end
		end
		if not sameClass then
			return string.format("Propiedades - %d Elementos", count)
		end
		if sameName then
			return string.format('Propiedades - %s "%s" De %d Objetos', first.ClassName, first.Name, count)
		end
		return string.format("Propiedades - %s De %d Objetos", first.ClassName, count)
	end

	local function toBytes(color)
		return math.floor(color.R * 255 + 0.5), math.floor(color.G * 255 + 0.5), math.floor(color.B * 255 + 0.5)
	end

	local function colorText(color)
		local r, g, b = toBytes(color)
		return string.format("Color: [%d,%d,%d]", r, g, b)
	end

	local function paletteColor(u, v)
		local r = ((1 - u) * EDGE_LEFT.R + u * EDGE_RIGHT.R + (1 - v) * EDGE_TOP.R + v * EDGE_BOTTOM.R) * 0.5
		local g = ((1 - u) * EDGE_LEFT.G + u * EDGE_RIGHT.G + (1 - v) * EDGE_TOP.G + v * EDGE_BOTTOM.G) * 0.5
		local b = ((1 - u) * EDGE_LEFT.B + u * EDGE_RIGHT.B + (1 - v) * EDGE_TOP.B + v * EDGE_BOTTOM.B) * 0.5
		local peak = math.max(r, g, b)
		if peak <= 0 then
			return Color3.new(0, 0, 0)
		end
		return Color3.new(r / peak, g / peak, b / peak)
	end

	local function locateColor(color)
		local peak = math.max(color.R, color.G, color.B)
		if peak <= 0 then
			return nil
		end
		local targetR = color.R / peak
		local targetG = color.G / peak
		local targetB = color.B / peak
		local bestU = 0.5
		local bestV = 0.5
		local best = math.huge
		local function scan(u0, u1, v0, v1, steps)
			for i = 0, steps do
				local u = u0 + (u1 - u0) * i / steps
				for j = 0, steps do
					local v = v0 + (v1 - v0) * j / steps
					local sample = paletteColor(u, v)
					local dr = sample.R - targetR
					local dg = sample.G - targetG
					local db = sample.B - targetB
					local distance = dr * dr + dg * dg + db * db
					if distance < best then
						best = distance
						bestU = u
						bestV = v
					end
				end
			end
		end
		scan(0, 1, 0, 1, 48)
		local span = 1 / 48
		scan(math.max(bestU - span, 0), math.min(bestU + span, 1), math.max(bestV - span, 0), math.min(bestV + span, 1), 24)
		return bestU, bestV, 1 - peak
	end

	local function setBoxes(color)
		local r, g, b = toBytes(color)
		BoxRed.Text = tostring(r)
		BoxGreen.Text = tostring(g)
		BoxBlue.Text = tostring(b)
		BoxHtml.Text = "#" .. string.upper(color:ToHex())
	end

	local function placeKnobs(color)
		local u, v, t = locateColor(color)
		if u then
			colorU = u
			colorV = v
		end
		colorT = t or 1
		PaletteButton.Position = UDim2.new(colorU, 0, colorV, 0)
		TonalKnob.Position = UDim2.new(0.5, 0, colorT, 0)
	end

	local function commitColor(color)
		currentColor = color
		setBoxes(color)
		if activeColor then
			writeProp(activeColor.name, color)
			activeColor.updateDisplay(color)
		end
	end

	local function applyEditor()
		local base = paletteColor(colorU, colorV)
		local factor = 1 - colorT
		local color = Color3.fromRGB(
			math.floor(base.R * factor * 255 + 0.5),
			math.floor(base.G * factor * 255 + 0.5),
			math.floor(base.B * factor * 255 + 0.5)
		)
		commitColor(color)
	end

	local function updateFromPointer(point)
		if not activeColor then return end
		if dragTarget == "palette" then
			local position = PaletteImage.AbsolutePosition
			local size = PaletteImage.AbsoluteSize
			colorU = math.clamp((point.X - position.X) / math.max(size.X, 1), 0, 1)
			colorV = math.clamp((point.Y - position.Y) / math.max(size.Y, 1), 0, 1)
			PaletteButton.Position = UDim2.new(colorU, 0, colorV, 0)
			applyEditor()
		elseif dragTarget == "tonal" then
			local position = TonalBar.AbsolutePosition
			local size = TonalBar.AbsoluteSize
			colorT = math.clamp((point.Y - position.Y) / math.max(size.Y, 1), 0, 1)
			TonalKnob.Position = UDim2.new(0.5, 0, colorT, 0)
			applyEditor()
		end
	end

	local function beginDrag(target, input)
		if not activeColor then return end
		dragTarget = target
		dragInput = input
		updateFromPointer(inputGuiPoint(input))
	end

	local function parseByte(text, fallback)
		local number = tonumber(text)
		if not number then
			return fallback
		end
		return math.clamp(math.floor(number + 0.5), 0, 255)
	end

	local function commitBoxes()
		if not activeColor then return end
		local r, g, b = toBytes(currentColor)
		local color = Color3.fromRGB(parseByte(BoxRed.Text, r), parseByte(BoxGreen.Text, g), parseByte(BoxBlue.Text, b))
		commitColor(color)
		placeKnobs(color)
	end

	local function commitHex()
		if not activeColor then return end
		local text = string.gsub(BoxHtml.Text, "%s", "")
		local ok, color = pcall(Color3.fromHex, text)
		if ok and color then
			commitColor(color)
			placeKnobs(color)
		else
			setBoxes(currentColor)
		end
	end

	deselectColor = function()
		local entry = activeColor
		if not entry then return end
		activeColor = nil
		dragTarget = nil
		dragInput = nil
		entry.textButton.TextColor3 = COLOR_TEXT_IDLE
		PaletteImage.ImageColor3 = PALETTE_OFF
		if HIDE_IDLE_PANELS then
			ColorPanel.Visible = false
		end
	end

	selectColor = function(entry)
		if activeColor == entry then
			deselectColor()
			return
		end
		deselectColor()
		activeColor = entry
		entry.textButton.TextColor3 = COLOR_TEXT_ACTIVE
		PaletteImage.ImageColor3 = PALETTE_ON
		if HIDE_IDLE_PANELS then
			ColorPanel.Visible = true
		end
		currentColor = entry.color
		placeKnobs(entry.color)
		setBoxes(entry.color)
	end

	local function clearOptions()
		for _, option in ipairs(optionButtons) do
			option.connection:Disconnect()
			option.button:Destroy()
		end
		table.clear(optionButtons)
	end

	paintOptions = function()
		local entry = activeSelection
		for _, option in ipairs(optionButtons) do
			local isCurrent = entry ~= nil and not entry.mixed and entry.value == option.item
			option.button.BackgroundTransparency = isCurrent and OPTION_ON or OPTION_OFF
		end
	end

	deselectSelection = function()
		local entry = activeSelection
		if not entry then return end
		activeSelection = nil
		entry.button.BackgroundTransparency = OPTION_OFF
		clearOptions()
		SeleccionsList.Text = ""
		if HIDE_IDLE_PANELS then
			SeleccionsList.Visible = false
		end
	end

	selectSelection = function(entry)
		if activeSelection == entry then
			deselectSelection()
			return
		end
		deselectSelection()
		activeSelection = entry
		entry.button.BackgroundTransparency = OPTION_ON
		SeleccionsList.Text = entry.name
		if HIDE_IDLE_PANELS then
			SeleccionsList.Visible = true
		end
		for index, item in ipairs(entry.enumType:GetEnumItems()) do
			local button = OptionTemplate:Clone()
			button.Name = "Option_" .. item.Name
			button.Text = item.Name
			button.LayoutOrder = index
			button.BackgroundTransparency = OPTION_OFF
			button.Visible = true
			button.Parent = OptionsHolder
			local connection = button.Activated:Connect(function()
				writeProp(entry.name, item)
				entry.refresh()
				paintOptions()
			end)
			table.insert(optionButtons, { button = button, item = item, connection = connection })
		end
		paintOptions()
	end

	local function newRow(template, name, order)
		local frame = template:Clone()
		frame.Name = "Prop_" .. name
		frame.LayoutOrder = order
		frame.Visible = true
		local label = frame:FindFirstChild("NamePropiedad", true)
		if label then
			label.Text = name
		end
		return frame
	end

	local function makeBoolEntry(def, order)
		local frame = newRow(TemplateCasilla, def.name, order)
		local button = frame:FindFirstChild("TrueOrFalseButton", true)
		local entry = { name = def.name, frame = frame, connections = {}, value = false, mixed = false }
		entry.refresh = function()
			local value, mixed = readShared(def.name)
			entry.value = value
			entry.mixed = mixed
			button.BackgroundTransparency = 0
			if mixed then
				button.Text = "-"
				button.TextColor3 = CHECK_MIXED_TEXT
				button.BackgroundColor3 = CHECK_OFF_BG
			elseif value then
				button.Text = "✓"
				button.TextColor3 = CHECK_ON_TEXT
				button.BackgroundColor3 = checkOnBackground
			else
				button.Text = ""
				button.BackgroundColor3 = CHECK_OFF_BG
			end
		end
		table.insert(entry.connections, button.Activated:Connect(function()
			writeProp(def.name, entry.mixed or entry.value ~= true)
			entry.refresh()
		end))
		return entry
	end

	local function makeColorEntry(def, order)
		local frame = newRow(TemplateColor, def.name, order)
		local colorButton = frame:FindFirstChild("ButtonColor", true)
		local textButton = frame:FindFirstChild("TextColorButton", true)
		local entry = {
			name = def.name,
			frame = frame,
			connections = {},
			colorButton = colorButton,
			textButton = textButton,
			color = Color3.new(1, 1, 1),
			mixed = false,
		}
		textButton.TextColor3 = COLOR_TEXT_IDLE
		entry.updateDisplay = function(color)
			entry.color = color
			entry.mixed = false
			colorButton.BackgroundColor3 = color
			textButton.Text = colorText(color)
		end
		entry.refresh = function()
			local value, mixed = readShared(def.name)
			if value == nil then return end
			entry.color = value
			entry.mixed = mixed
			colorButton.BackgroundColor3 = value
			textButton.Text = mixed and "Color: [Varios]" or colorText(value)
		end
		local function toggle()
			selectColor(entry)
		end
		table.insert(entry.connections, textButton.Activated:Connect(toggle))
		table.insert(entry.connections, colorButton.Activated:Connect(toggle))
		return entry
	end

	local function makeEnumEntry(def, order)
		local frame = newRow(TemplateSeleccions, def.name, order)
		local button = frame:FindFirstChild("TextMultipleSelection", true)
		local first = readProp(selectedList[1], def.name)
		local entry = {
			name = def.name,
			frame = frame,
			connections = {},
			button = button,
			enumType = first.EnumType,
			value = first,
			mixed = false,
		}
		button.BackgroundTransparency = OPTION_OFF
		entry.refresh = function()
			local value, mixed = readShared(def.name)
			if value == nil then return end
			entry.value = value
			entry.mixed = mixed
			button.Text = mixed and "Varios" or value.Name
			if activeSelection == entry then
				paintOptions()
			end
		end
		table.insert(entry.connections, button.Activated:Connect(function()
			selectSelection(entry)
		end))
		return entry
	end

	local function makeTextEntry(def, order)
		local frame = newRow(TemplateTxt, def.name, order)
		local box = frame:FindFirstChild("Value", true)
		local entry = { name = def.name, frame = frame, connections = {}, shown = nil }
		box.ClearTextOnFocus = false
		entry.refresh = function()
			if box:IsFocused() then return end
			local value, mixed = readShared(def.name)
			if value == nil then return end
			if mixed then
				entry.shown = ""
				box.Text = ""
				box.PlaceholderText = "Varios"
			else
				local text = serializeValue(value)
				if text ~= entry.shown or box.Text ~= text then
					entry.shown = text
					box.Text = text
				end
			end
		end
		table.insert(entry.connections, box.FocusLost:Connect(function()
			if box.Text ~= entry.shown then
				local current = readProp(selectedList[1], def.name)
				local ok, parsed = pcall(parseValue, box.Text, current)
				if ok and parsed ~= nil then
					writeProp(def.name, parsed)
				end
			end
			entry.shown = nil
			entry.refresh()
		end))
		return entry
	end

	local ROW_MAKERS = {
		bool = makeBoolEntry,
		color = makeColorEntry,
		enum = makeEnumEntry,
		text = makeTextEntry,
	}

	local function applyFilter()
		for _, entry in ipairs(propEntries) do
			local show = propsQuery == "" or string.find(entry.lower, propsQuery, 1, true) ~= nil
			if entry.frame.Visible ~= show then
				entry.frame.Visible = show
			end
		end
	end

	local function clearRows()
		deselectColor()
		deselectSelection()
		for _, entry in ipairs(propEntries) do
			for _, connection in ipairs(entry.connections) do
				connection:Disconnect()
			end
			entry.frame:Destroy()
		end
		table.clear(propEntries)
	end

	local function rebuildProps()
		clearRows()
		PropsTitle.Text = describeSelection()
		if #selectedList == 0 then return end
		for index, def in ipairs(sharedProperties()) do
			local entry = ROW_MAKERS[def.kind](def, index)
			entry.lower = string.lower(def.name)
			entry.frame.Parent = PropsList
			entry.refresh()
			table.insert(propEntries, entry)
		end
		applyFilter()
	end

	local function pollProps(now)
		if #selectedList == 0 then return end
		local interval = #selectedList > 100 and 1 or POLL_INTERVAL
		if now - lastPoll < interval then return end
		lastPoll = now
		for _, entry in ipairs(propEntries) do
			if entry ~= activeColor then
				entry.refresh()
			end
		end
		local title = describeSelection()
		if PropsTitle.Text ~= title then
			PropsTitle.Text = title
		end
	end

	PropsSearch:GetPropertyChangedSignal("Text"):Connect(function()
		propsQuery = string.lower(string.match(PropsSearch.Text, "^%s*(.-)%s*$") or "")
		applyFilter()
	end)

	BoxRed.FocusLost:Connect(commitBoxes)
	BoxGreen.FocusLost:Connect(commitBoxes)
	BoxBlue.FocusLost:Connect(commitBoxes)
	BoxHtml.FocusLost:Connect(commitHex)

	PaletteImage.InputBegan:Connect(function(input)
		if isPress(input) then
			beginDrag("palette", input)
		end
	end)

	PaletteButton.InputBegan:Connect(function(input)
		if isPress(input) then
			beginDrag("palette", input)
		end
	end)

	TonalBar.InputBegan:Connect(function(input)
		if isPress(input) then
			beginDrag("tonal", input)
		end
	end)

	TonalKnob.InputBegan:Connect(function(input)
		if isPress(input) then
			beginDrag("tonal", input)
		end
	end)

	UserInputService.InputBegan:Connect(function(input)
		if not activeColor or not isPress(input) then return end
		local point = inputGuiPoint(input)
		if isOver(activeColor.textButton, point) or isOver(activeColor.colorButton, point) or isOver(ColorPanel, point) then
			return
		end
		for _, descendant in ipairs(ColorPanel:GetDescendants()) do
			if descendant:IsA("GuiObject") and descendant.Visible and isOver(descendant, point) then
				return
			end
		end
		if BoxHtml:IsFocused() then
			commitHex()
		elseif BoxRed:IsFocused() or BoxGreen:IsFocused() or BoxBlue:IsFocused() then
			commitBoxes()
		end
		deselectColor()
	end)

	UserInputService.InputChanged:Connect(function(input)
		if not dragTarget then return end
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			updateFromPointer(inputGuiPoint(input))
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if dragTarget and (input == dragInput or isPress(input)) then
			dragTarget = nil
			dragInput = nil
		end
	end)

	RunService.Heartbeat:Connect(function()
		if not sectionIsOpen() then return end
		if propsDirty then
			propsDirty = false
			rebuildProps()
		end
		pollProps(os.clock())
	end)
end

end
