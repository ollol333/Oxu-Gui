do
local __mergedScriptName = "Console"


local Player = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")
local Gui = PlayerGui:WaitForChild("OxusGuiBeta")
local PrincipalMenu = Gui:WaitForChild("PrincipalMenu")
local Section = PrincipalMenu:WaitForChild("Seccion4")

local Console = Section:WaitForChild("ConsoleSeccion")
local ConsoleTemplate = Console:WaitForChild("MarcLine")

local Events = Section:WaitForChild("EventsSeccion")
local EventTemplate = Events:WaitForChild("MarcEvents")

local ValuesSection = Section:WaitForChild("ValuesSeccion")
local ValueTemplate = ValuesSection:WaitForChild("MarcValues")

local SearchConsole = Section:WaitForChild("SearchConsole")
local SearchEvents = Section:WaitForChild("SearchEvents")
local SearchValues = Section:WaitForChild("SearchValues")

local LocationInput = Section:WaitForChild("UbicationEvent")
local NameInput = Section:WaitForChild("NameEvent")
local ValueInput = Section:WaitForChild("ValueEvent")
local SendButton = Section:WaitForChild("SendButton")

local ValueTypes = {
	BoolValue = true,
	BrickColorValue = true,
	CFrameValue = true,
	Color3Value = true,
	IntValue = true,
	NumberValue = true,
	ObjectValue = true,
	RayValue = true,
	StringValue = true,
	Vector3Value = true
}

local EventTypes = {
	RemoteEvent = true,
	UnreliableRemoteEvent = true,
	BindableEvent = true
}

local ConsoleEntries = {}
local EventEntries = {}
local ValueEntries = {}
local Connections = {}
local Updating = false
local LastScan = 0
local ScanInterval = 2
local SendLocked = false

ConsoleTemplate.Visible = false
EventTemplate.Visible = false
ValueTemplate.Visible = false

local function GetPath(Object)
	local Parts = {}
	local Current = Object

	while Current and Current ~= game do
		table.insert(Parts, 1, Current.Name)
		Current = Current.Parent
	end

	return table.concat(Parts, ".")
end

local function GetValueText(Object)
	local Success, Result = pcall(function()
		if Object:IsA("ObjectValue") then
			return Object.Value and GetPath(Object.Value) or ""
		elseif Object:IsA("BrickColorValue") then
			return tostring(Object.Value)
		elseif Object:IsA("Color3Value") then
			local V = Object.Value
			return string.format("%g, %g, %g", V.R, V.G, V.B)
		elseif Object:IsA("Vector3Value") then
			local V = Object.Value
			return string.format("%g, %g, %g", V.X, V.Y, V.Z)
		elseif Object:IsA("CFrameValue") then
			return tostring(Object.Value)
		elseif Object:IsA("RayValue") then
			return tostring(Object.Value)
		end

		return tostring(Object.Value)
	end)

	return Success and Result or ""
end

local function SetStatus(Text, Color)
	if SendLocked then
		return
	end

	SendLocked = true
	local OldText = SendButton.Text
	local OldColor = SendButton.BackgroundColor3

	SendButton.Text = Text
	SendButton.BackgroundColor3 = Color

	task.delay(0.5, function()
		if SendButton.Parent then
			SendButton.Text = OldText == "Send!" or OldText == "Evento No Encontrado" and "Send Event" or OldText
			SendButton.BackgroundColor3 = OldColor
		end

		SendLocked = false
	end)
end

local function ClearEntries(List)
	for Object, Entry in pairs(List) do
		if Entry and Entry.Parent then
			Entry:Destroy()
		end

		List[Object] = nil
	end
end

local function ApplyFilter(List, Query, GetText)
	Query = string.lower(Query or "")

	for Object, Entry in pairs(List) do
		if Entry and Entry.Parent then
			local Text = string.lower(GetText(Object, Entry))
			Entry.Visible = Query == "" or string.find(Text, Query, 1, true) ~= nil
		end
	end
end


local function AddConsole(Message, MessageType)
	local Entry = ConsoleTemplate:Clone()
	Entry.Name = "ConsoleEntry"
	Entry.Visible = true
	Entry.Parent = Console

	local Line = Entry:FindFirstChild("Line", true)
	local Button = Entry:FindFirstChild("ButtonCopy", true)

	local Type = tostring(MessageType)
	local Text = tostring(Message)
	local Color = Color3.fromRGB(255, 255, 255)

	if Text:match("^%[(RemoteEvent|UnreliableRemoteEvent|BindableEvent)") then
		Color = Color3.fromRGB(255, 170, 0)
	elseif Type:find("Error") then
		Color = Color3.fromRGB(255, 55, 55)
	elseif Type:find("Warning") or Type:find("Warn") then
		Color = Color3.fromRGB(255, 220, 0)
	elseif Type:find("Info") then
		Color = Color3.fromRGB(0, 170, 255)
	end

	if Line then
		Line.Text = "[" .. Type .. "] " .. Text
		Line.TextColor3 = Color

		if Line:IsA("TextBox") then
			local OriginalMessage = Line.Text

			Line:GetPropertyChangedSignal("Text"):Connect(function()
				if Line.Text ~= OriginalMessage then
					Line.Text = OriginalMessage
				end
			end)
		end
	end

	local EventType, EventName, EventPath, EventValue

	for _, EventNameType in ipairs({"RemoteEvent", "UnreliableRemoteEvent", "BindableEvent"}) do
		local Name, Path, Value = Text:match(
			'^%[' .. EventNameType .. '%s+"(.-)"%s+%-%s+Ubication%s+"(.-)"%s*%-%s+Value%s+"(.-)"%]$'
		)

		if Name then
			EventType, EventName, EventPath, EventValue = EventNameType, Name, Path, Value
			break
		end

		Name, Path = Text:match(
			'^%[' .. EventNameType .. '%s+"(.-)"%s+%-%s+Ubication%s+"(.-)"%]$'
		)

		if Name then
			EventType, EventName, EventPath = EventNameType, Name, Path
			break
		end
	end

	if Button then
		Button.Visible = EventType ~= nil

		if EventType then
			Button.Activated:Connect(function()
				LocationInput.Text = EventPath or ""
				NameInput.Text = EventName or ""
				ValueInput.Text = EventValue or ""
			end)
		end
	end

	ConsoleEntries[Entry] = Entry

	ApplyFilter(ConsoleEntries, SearchConsole.Text, function(_, Item)
		local TextObject = Item:FindFirstChild("Line", true)
		return TextObject and TextObject.Text or ""
	end)
end

local function AddEvent(Object)
	if EventEntries[Object] or not EventTypes[Object.ClassName] then
		return
	end

	local Entry = EventTemplate:Clone()
	Entry.Name = "EventEntry"
	Entry.Visible = true
	Entry.Parent = Events

	local NameLabel = Entry:FindFirstChild("Name", true)
	local SelectButton = Entry:FindFirstChild("ButtonInteracct", true)

	if NameLabel then
		NameLabel.Text = Object.ClassName .. ' "' .. Object.Name .. '" - ' .. GetPath(Object)
	end

	EventEntries[Object] = Entry

	if SelectButton then
		SelectButton.Activated:Connect(function()
			if not Object.Parent then
				return
			end

			LocationInput.Text = GetPath(Object)
			NameInput.Text = Object.Name
			ValueInput.Text = ""
		end)
	end
end

local function ParseVector3(Text)
	local X, Y, Z = Text:match("^%s*([%+%-%.%d]+)%s*,%s*([%+%-%.%d]+)%s*,%s*([%+%-%.%d]+)%s*$")

	if X and Y and Z then
		return Vector3.new(tonumber(X), tonumber(Y), tonumber(Z))
	end
end

local function ParseColor3(Text)
	local R, G, B = Text:match("^%s*([%+%-%.%d]+)%s*,%s*([%+%-%.%d]+)%s*,%s*([%+%-%.%d]+)%s*$")

	if R and G and B then
		R, G, B = tonumber(R), tonumber(G), tonumber(B)

		if R and G and B and R >= 0 and R <= 1 and G >= 0 and G <= 1 and B >= 0 and B <= 1 then
			return Color3.new(R, G, B)
		end
	end
end

local function ParseCFrame(Text)
	local Numbers = {}

	for Number in Text:gmatch("[%+%-]?[%d%.]+") do
		table.insert(Numbers, tonumber(Number))
	end

	if #Numbers == 3 then
		return CFrame.new(Numbers[1], Numbers[2], Numbers[3])
	elseif #Numbers == 12 then
		return CFrame.new(table.unpack(Numbers))
	end
end

local function ParseValue(Object, Text)
	local Class = Object.ClassName

	if Class == "StringValue" then
		return Text
	elseif Class == "BoolValue" then
		if Text:lower() == "true" then
			return true
		elseif Text:lower() == "false" then
			return false
		end
	elseif Class == "IntValue" then
		local Number = tonumber(Text)
		if Number and Number % 1 == 0 then
			return Number
		end
	elseif Class == "NumberValue" then
		local Number = tonumber(Text)
		if Number and Number == Number and math.abs(Number) < math.huge then
			return Number
		end
	elseif Class == "BrickColorValue" then
		local Success, Result = pcall(BrickColor.new, Text)
		if Success then
			return Result
		end
	elseif Class == "Color3Value" then
		return ParseColor3(Text)
	elseif Class == "Vector3Value" then
		return ParseVector3(Text)
	elseif Class == "CFrameValue" then
		return ParseCFrame(Text)
	elseif Class == "ObjectValue" then
		if Text == "" then
			return nil
		end

		for _, ObjectFound in ipairs(game:GetDescendants()) do
			if GetPath(ObjectFound) == Text then
				return ObjectFound
			end
		end
	end

	return nil
end

local function AddValue(Object)
	if ValueEntries[Object] or not ValueTypes[Object.ClassName] then
		return
	end

	local Entry = ValueTemplate:Clone()
	Entry.Name = "ValueEntry"
	Entry.Visible = true
	Entry.Parent = ValuesSection

	local NameLabel = Entry:FindFirstChild("Name", true)
	local ValueInputBox = Entry:FindFirstChild("Value", true)

	if NameLabel then
		NameLabel.Text = Object.ClassName .. ' "' .. Object.Name .. '"'
	end

	if not ValueInputBox or not ValueInputBox:IsA("TextBox") then
		Entry:Destroy()
		return
	end

	ValueEntries[Object] = Entry
	ValueInputBox.Text = GetValueText(Object)

	local OriginalText = ValueInputBox.Text
	local Editing = false

	ValueInputBox.FocusLost:Connect(function()
		if Editing or not Object.Parent then
			return
		end

		Editing = true

		local NewValue = ParseValue(Object, ValueInputBox.Text)

		if NewValue ~= nil or Object:IsA("ObjectValue") and ValueInputBox.Text == "" then
			local Success = pcall(function()
				Object.Value = NewValue
			end)

			if Success then
				OriginalText = GetValueText(Object)
			end
		end

		ValueInputBox.Text = OriginalText
		Editing = false
	end)
end

local function Refresh()
	if Updating or not Section.Visible then
		return
	end

	Updating = true

	for _, Object in ipairs(game:GetDescendants()) do
		if EventTypes[Object.ClassName] then
			AddEvent(Object)
		elseif ValueTypes[Object.ClassName] then
			AddValue(Object)
		end
	end

	for Object, Entry in pairs(EventEntries) do
		if not Object.Parent then
			Entry:Destroy()
			EventEntries[Object] = nil
		end
	end

	for Object, Entry in pairs(ValueEntries) do
		if not Object.Parent then
			Entry:Destroy()
			ValueEntries[Object] = nil
		end
	end

	ApplyFilter(EventEntries, SearchEvents.Text, function(Object)
		return Object.ClassName .. " " .. Object.Name .. " " .. GetPath(Object)
	end)

	ApplyFilter(ValueEntries, SearchValues.Text, function(Object)
		return Object.ClassName .. " " .. Object.Name .. " " .. GetPath(Object)
	end)

	Updating = false
end

SearchConsole:GetPropertyChangedSignal("Text"):Connect(function()
	ApplyFilter(ConsoleEntries, SearchConsole.Text, function(_, Entry)
		local Line = Entry:FindFirstChild("Line", true)
		return Line and Line.Text or ""
	end)
end)

SearchEvents:GetPropertyChangedSignal("Text"):Connect(function()
	ApplyFilter(EventEntries, SearchEvents.Text, function(Object)
		return Object.ClassName .. " " .. Object.Name .. " " .. GetPath(Object)
	end)
end)

SearchValues:GetPropertyChangedSignal("Text"):Connect(function()
	ApplyFilter(ValueEntries, SearchValues.Text, function(Object)
		return Object.ClassName .. " " .. Object.Name .. " " .. GetPath(Object)
	end)
end)

LogService.MessageOut:Connect(function(Message, MessageType)
	if not Section.Visible then
		return
	end

	AddConsole(Message, tostring(MessageType):gsub("MessageType%.", ""))
end)

SendButton.Activated:Connect(function()
	if SendLocked then
		return
	end

	local Path = LocationInput.Text
	local Name = NameInput.Text
	local Value = ValueInput.Text
	local Found

	for _, Object in ipairs(game:GetDescendants()) do
		if Object.Name == Name and GetPath(Object) == Path and EventTypes[Object.ClassName] then
			Found = Object
			break
		end
	end

	if not Found then
		SetStatus("Evento No Encontrado", Color3.fromRGB(255, 43, 216))
		return
	end

	if Found:IsA("BindableEvent") then
		local Success = pcall(function()
			Found:Fire(Value)
		end)

		if Success then
			SetStatus("Send!", Color3.fromRGB(0, 187, 255))
		else
			SetStatus("Evento No Encontrado", Color3.fromRGB(255, 43, 216))
		end

		return
	end

	SetStatus("No autorizado", Color3.fromRGB(255, 43, 216))
end)

RunService.Heartbeat:Connect(function()
	if not Section.Visible then
		return
	end

	if os.clock() - LastScan >= ScanInterval then
		LastScan = os.clock()
		Refresh()
	end
end)

Section:GetPropertyChangedSignal("Visible"):Connect(function()
	if Section.Visible then
		Refresh()
	end
end)

Refresh()

end

