State.restoreDesanchore = function()
	if State.desanchoreCharacterConnection then
		State.desanchoreCharacterConnection:Disconnect()
		State.desanchoreCharacterConnection = nil
	end
	for part, connection in pairs(State.desanchorePartConnections) do
		if connection then connection:Disconnect() end
		State.desanchorePartConnections[part] = nil
	end
	for part, anchored in pairs(State.desanchorePartStates) do
		if part and part.Parent and part:IsA("BasePart") then
			part.Anchored = anchored
		end
		State.desanchorePartStates[part] = nil
		State.desanchoreInternalChanges[part] = nil
	end
	State.desanchoreOriginal = nil
end

State.applyDesanchore = function()
	if not character then return end
	local function forceUnanchored(part)
		if not part:IsA("BasePart") then return end
		if State.desanchorePartStates[part] == nil then
			State.desanchorePartStates[part] = part.Anchored
			State.desanchorePartConnections[part] = part:GetPropertyChangedSignal("Anchored"):Connect(function()
				if State.desanchoreInternalChanges[part] then return end
				if not (State.records.Desanchore and powerEnabled(State.records.Desanchore)) then return end
				State.desanchorePartStates[part] = part.Anchored
				if part.Anchored then
					State.desanchoreInternalChanges[part] = true
					part.Anchored = false
					task.defer(function()
						State.desanchoreInternalChanges[part] = nil
					end)
				end
			end)
		end
		if part.Anchored then
			State.desanchoreInternalChanges[part] = true
			part.Anchored = false
			task.defer(function()
				State.desanchoreInternalChanges[part] = nil
			end)
		end
	end
	for _, instance in ipairs(character:GetDescendants()) do
		forceUnanchored(instance)
	end
	if not State.desanchoreCharacterConnection then
		State.desanchoreCharacterConnection = character.DescendantAdded:Connect(function(instance)
			if State.records.Desanchore and powerEnabled(State.records.Desanchore) then
				forceUnanchored(instance)
				for _, descendant in ipairs(instance:GetDescendants()) do
					forceUnanchored(descendant)
				end
			end
		end)
	end
end

local function setHiddenPart(instance)
	if instance:IsA("BasePart") then
		if State.hidlePlayerStates[instance] == nil then
			State.hidlePlayerStates[instance] = instance.LocalTransparencyModifier
		end
		instance.LocalTransparencyModifier = 1
	elseif instance:IsA("Decal") or instance:IsA("Texture") then
		if State.hidlePlayerStates[instance] == nil then
			State.hidlePlayerStates[instance] = instance.Transparency
		end
		instance.Transparency = 1
	elseif instance:IsA("ParticleEmitter") or instance:IsA("Trail") or instance:IsA("Beam")
		or instance:IsA("BillboardGui") or instance:IsA("SurfaceGui") then
		if State.hidlePlayerStates[instance] == nil then
			State.hidlePlayerStates[instance] = instance.Enabled
		end
		instance.Enabled = false
	end
end

local function stopHidlePlayer()
	State.hidlePlayerActive = false
	if State.hidlePlayerConnection then State.hidlePlayerConnection:Disconnect(); State.hidlePlayerConnection = nil end
	for instance, value in pairs(State.hidlePlayerStates) do
		if instance and instance.Parent then
			if instance:IsA("BasePart") then instance.LocalTransparencyModifier = value
			elseif instance:IsA("Decal") or instance:IsA("Texture") then instance.Transparency = value
			elseif instance:IsA("ParticleEmitter") or instance:IsA("Trail") or instance:IsA("Beam")
				or instance:IsA("BillboardGui") or instance:IsA("SurfaceGui") then instance.Enabled = value end
		end
		State.hidlePlayerStates[instance] = nil
	end
end

local function startHidlePlayer()
	stopHidlePlayer()
	if not character then return end
	State.hidlePlayerActive = true
	for _, item in ipairs(character:GetDescendants()) do setHiddenPart(item) end
	State.hidlePlayerConnection = character.DescendantAdded:Connect(function(item)
		if State.hidlePlayerActive then
			setHiddenPart(item)
			task.defer(function()
				if State.hidlePlayerActive and item.Parent then setHiddenPart(item) end
			end)
		end
	end)
end

local function stopSafeZone(restorePosition)
	State.safeZoneActive = false
	if State.safeZoneHeartbeatConnection then State.safeZoneHeartbeatConnection:Disconnect(); State.safeZoneHeartbeatConnection = nil end
	if State.safeZoneHealthConnection then State.safeZoneHealthConnection:Disconnect(); State.safeZoneHealthConnection = nil end
	if State.safeZonePlatform then State.safeZonePlatform:Destroy(); State.safeZonePlatform = nil end
	if restorePosition and State.safeZoneReturnCFrame then teleportRoot(State.safeZoneReturnCFrame) end
	State.safeZoneCFrame, State.safeZoneReturnCFrame, State.safeZoneCenter = nil, nil, nil
end

local function getSafeZoneHealthLimit()
	local value = State.safeZoneHealthBox and tonumber(State.safeZoneHealthBox.Text)
	if not value then return 50 end
	return math.max(0, value)
end

local function startSafeZone()
	if State.safeZoneActive then return end
	local root = getRoot()
	if not root or not humanoid or humanoid.Health > getSafeZoneHealthLimit() then return end
	State.safeZoneReturnCFrame = root.CFrame
	State.safeZoneCenter = root.Position
	local _, boxSize = character:GetBoundingBox()
	local platform = Instance.new("Part")
	platform.Name = "OxusSafeZonePlatform"
	platform.Size = Vector3.new(2500, 1, 2500)
	platform.CFrame = CFrame.new(State.safeZoneCenter.X, 9998.5, State.safeZoneCenter.Z)
	platform.Anchored = true
	platform.CanCollide = true
	platform.CanTouch = true
	platform.CanQuery = true
	platform.Transparency = 1
	platform.Parent = workspace
	State.safeZonePlatform = platform
	State.safeZoneCFrame = CFrame.new(State.safeZoneCenter.X, 9999 + boxSize.Y / 2 + 0.02, State.safeZoneCenter.Z) * root.CFrame.Rotation
	State.safeZoneActive = true
	teleportRoot(State.safeZoneCFrame)
	local function returnBecauseHealed()
		if not State.safeZoneActive then return end
		stopSafeZone(true)
	end
	State.safeZoneHealthConnection = humanoid.HealthChanged:Connect(function(health)
		if State.safeZoneActive and health > getSafeZoneHealthLimit() then returnBecauseHealed() end
	end)
	State.safeZoneHeartbeatConnection = RunService.Heartbeat:Connect(function()
		if not State.safeZoneActive then return end
		local currentRoot = getRoot()
		if not currentRoot then return end
		if humanoid and humanoid.Health > getSafeZoneHealthLimit() then returnBecauseHealed(); return end
		local pos = currentRoot.Position
		if math.abs(pos.X - State.safeZoneCFrame.Position.X) > State.safeZoneRadius
			or math.abs(pos.Z - State.safeZoneCFrame.Position.Z) > State.safeZoneRadius
			or math.abs(pos.Y - State.safeZoneCFrame.Position.Y) > 30 then
			teleportRoot(State.safeZoneCFrame)
		end
	end)
end

local function syncHidlePlayer()
