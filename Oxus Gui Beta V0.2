		end
		binder.onPress = function()
			if not masterOn(record) then
				return
			end
			setNoclip(not State.noclipActive)
			refreshBinder(binder)
		end
	elseif name == "Locate" or name == "AutoRotate" or name == "Desanchore" or name == "HidlePlayer" or name == "SafeZone" or name == "AutoRemovalofEntities" then
