	}

	local propEntries = {}
	local propsQuery = ""
	local activeColor = nil
	local activeSelection = nil
	local optionButtons = {}
	local currentColor = Color3.new(1, 1, 1)
	local colorU = 0.5
	local colorV = 0.5
	local colorT = 0
	local dragTarget = nil
	local dragInput = nil
	local lastPoll = 0

	local deselectColor
	local selectColor
	local deselectSelection
	local selectSelection
