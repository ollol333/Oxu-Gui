	local PROPERTY_SETS = {
		{ "Instance", { "Name", "ClassName", "Archivable" } },
		{ "Sound", {
			"SoundId", "Volume", "PlaybackSpeed", "Looped", "Playing", "TimePosition", "TimeLength",
			"PlaybackLoudness", "RollOffMode", "RollOffMinDistance", "RollOffMaxDistance", "PlayOnRemove",
			"PlaybackRegionsEnabled", "LoopRegion", "PlaybackRegion",
		} },
		{ "SoundGroup", { "Volume" } },
		{ "SoundEffect", { "Enabled", "Priority" } },
