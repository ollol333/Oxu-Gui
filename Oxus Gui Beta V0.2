		aimRestore()
	end,
}

local function followStep()
	if activeLoop or tpBlocked() then return end
	local root = getRoot()
	local humanoid = getHumanoid()
	if not root or not humanoid or humanoid.Health <= 0 then return end

	local targetPart = nearestSelected("Humanoid")
	if not targetPart then return end

	local targetCharacter = targetPart.Parent
	local targetHumanoid = targetCharacter and targetCharacter:FindFirstChildOfClass("Humanoid")
	local delta = targetPart.Position - root.Position
	local flat = Vector3.new(delta.X, 0, delta.Z)
	local distance = delta.Magnitude
	local targetState = targetHumanoid and targetHumanoid:GetState()
	local targetJumping = targetHumanoid and (
		targetState == Enum.HumanoidStateType.Jumping
			or targetState == Enum.HumanoidStateType.Freefall
	)

	if targetJumping and humanoid:GetStateEnabled(Enum.HumanoidStateType.Jumping) then
		humanoid.Jump = true
	end

	local targetLook = targetPart.CFrame.LookVector
	local flatLook = Vector3.new(targetLook.X, 0, targetLook.Z)
	if flatLook.Magnitude > 0.05 then
		local desiredRotation = CFrame.lookAt(root.Position, root.Position + flatLook.Unit)
		root.CFrame = root.CFrame:Lerp(desiredRotation, 1 - math.exp(-8 / 60))
	end

	local tooHighOrLow = math.abs(delta.Y) > 8
	local blocked = flat.Magnitude > CFG.FOLLOW_STOP_DISTANCE and obstacleAhead(root, flat.Unit)
	local cannotReach = tooHighOrLow or blocked

	if distance > CFG.FOLLOW_STOP_DISTANCE then
		if cannotReach then
			local behind = targetPart.CFrame * CFrame.new(0, 0, 3)
			teleportRoot(CFrame.new(behind.Position) * targetPart.CFrame.Rotation)
			humanoid:ChangeState(Enum.HumanoidStateType.Running)
		else
			humanoid:Move(flat.Unit, false)
		end
	else
		humanoid:Move(Vector3.zero, false)
	end
end

