local KIND_BY_TYPE = {
	boolean = "bool",
	Color3 = "color",
	EnumItem = "enum",
	number = "text",
	string = "text",
	Vector3 = "text",
	Vector2 = "text",
}

local function fmtNum(number)
	local text = string.format("%.4f", number)
	text = string.gsub(text, "0+$", "")
	text = string.gsub(text, "%.$", "")
	if text == "" or text == "-0" or text == "-" then
		text = "0"
	end
	return text
end

local function serializeValue(value)
	local kind = typeof(value)
	if kind == "number" then
		return fmtNum(value)
	elseif kind == "string" then
		return value
	elseif kind == "Vector3" then
		return fmtNum(value.X) .. ", " .. fmtNum(value.Y) .. ", " .. fmtNum(value.Z)
	elseif kind == "Vector2" then
		return fmtNum(value.X) .. ", " .. fmtNum(value.Y)
	end
	return tostring(value)
end

local function numbersIn(text)
	local list = {}
	for token in string.gmatch(text, "%-?%d*%.?%d+") do
		local number = tonumber(token)
		if number then
			table.insert(list, number)
		end
	end
	return list
end

local function parseValue(text, current)
	local kind = typeof(current)
	if kind == "string" then
		return text
	end
	local n = numbersIn(text)
	if kind == "number" then
		return tonumber(text) or n[1]
	elseif kind == "Vector3" then
		if #n >= 3 then return Vector3.new(n[1], n[2], n[3]) end
		if #n == 1 then return Vector3.new(n[1], n[1], n[1]) end
	elseif kind == "Vector2" then
		if #n >= 2 then return Vector2.new(n[1], n[2]) end
		if #n == 1 then return Vector2.new(n[1], n[1]) end
	end
	return nil
end

