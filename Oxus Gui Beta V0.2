	if record and powerEnabled(record) then startHidlePlayer() else stopHidlePlayer() end
end

local function syncSafeZone()
	local record = State.records.SafeZone
	local enabled = record and powerEnabled(record)
	if enabled then
		if humanoid and not State.safeZoneMonitorConnection then
			State.safeZoneMonitorConnection = humanoid.HealthChanged:Connect(function(health)
				local currentRecord = State.records.SafeZone
				if not (currentRecord and powerEnabled(currentRecord)) then return end
				if health <= getSafeZoneHealthLimit() and not State.safeZoneActive then
					startSafeZone()
				elseif health > getSafeZoneHealthLimit() and State.safeZoneActive then
					stopSafeZone(true)
				end
			end)
		end
		if humanoid and humanoid.Health <= getSafeZoneHealthLimit() and not State.safeZoneActive then startSafeZone() end
	else
		if State.safeZoneMonitorConnection then State.safeZoneMonitorConnection:Disconnect(); State.safeZoneMonitorConnection = nil end
		if State.safeZoneActive then stopSafeZone(true) end
	end
end

local function getAutoRemovalTarget(root)
	local best, bestDistance = nil, State.autoRemovalRadius
	local seen = {}
	for _, item in ipairs(workspace:GetDescendants()) do
		if item:IsA("Humanoid") and item.Health > 0 then
			local model = item.Parent
			local targetRoot = model and (model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart)
			if model and model ~= character and targetRoot and targetRoot:IsA("BasePart") and not seen[model] then
				seen[model] = true
				local isPlayer = Players:GetPlayerFromCharacter(model) ~= nil
				local allowed = State.autoRemovalMode == "Players And Npc" or (State.autoRemovalMode == "Players" and isPlayer) or (State.autoRemovalMode == "NPCS" and not isPlayer)
				if allowed then
					local distance = (root.Position - targetRoot.Position).Magnitude
					if distance < bestDistance then best, bestDistance = targetRoot, distance end
				end
			end
		end
	end
	return best
end

local function stopAutoRemoval()
	State.autoRemovalActive = false
	if State.autoRemovalConnection then State.autoRemovalConnection:Disconnect(); State.autoRemovalConnection = nil end
end

local function startAutoRemoval()
	stopAutoRemoval()
	State.autoRemovalActive = true
	State.autoRemovalCooldown = 0
	State.autoRemovalConnection = RunService.Heartbeat:Connect(function(dt)
		if not State.autoRemovalActive then return end
		State.autoRemovalCooldown = State.autoRemovalCooldown - dt
		if State.autoRemovalCooldown > 0 then return end
		local root = getRoot()
		if not root then return end
		local target = getAutoRemovalTarget(root)
		State.autoRemovalCooldown = 0.25
		if target then
			local away = root.Position - target.Position
			away = Vector3.new(away.X, 0, away.Z)
			if away.Magnitude < 0.01 then away = Vector3.new(1, 0, 0) else away = away.Unit end
			local destination = target.Position + away * (State.autoRemovalRadius + 15)
			local current = root.CFrame
			teleportRoot(CFrame.new(destination.X, current.Position.Y, destination.Z) * current.Rotation)
		end
	end)
end

local function syncAutoRemoval()
	local record = State.records.AutoRemovalofEntities
	if record and powerEnabled(record) then startAutoRemoval() else stopAutoRemoval() end
end

