local playerSettingsLoaded = false
local playerSettingsLoading = false
local playerSettingsSaveQueued = false
local writingPlayerSettingsValue = false
local playerSettingsDefaults = {}
local playerSettingsNumericDefaults = {}

local function settingsQuote(value)
	return HttpService:JSONEncode(tostring(value or ""))
end

local function settingsUnquote(value)
	value = string.match(value or "", "^%s*(.-)%s*$") or ""
	if string.sub(value, 1, 1) ~= '"' then return value end
	local ok, decoded = pcall(function()
		return HttpService:JSONDecode(value)
	end)
	if ok and type(decoded) == "string" then return decoded end
	return nil
end

local function splitSettingsFields(text)
	local fields = {}
	local buffer = {}
	local quoted = false
	local escaped = false
	for index = 1, #text do
		local char = string.sub(text, index, index)
		if escaped then
			table.insert(buffer, char)
			escaped = false
		elseif char == "\\" and quoted then
			table.insert(buffer, char)
			escaped = true
		elseif char == '"' then
			quoted = not quoted
			table.insert(buffer, char)
		elseif char == "," and not quoted then
			table.insert(fields, table.concat(buffer))
			table.clear(buffer)
		else
			table.insert(buffer, char)
		end
	end
	if #buffer > 0 then table.insert(fields, table.concat(buffer)) end
	return fields
end

local function parsePlayerSettings(source)
	local entries = {}
	if type(source) ~= "string" or #source > 100000 then return entries end
	for block in string.gmatch(source, "%b[]") do
		local body = string.sub(block, 2, -2)
		local fields = {}
		for _, part in ipairs(splitSettingsFields(body)) do
			local key, value = string.match(part, "^%s*([%w_]+)%s*=%s*(.-)%s*$")
			if key and value and value ~= "" then
				if string.sub(value, 1, 1) == '"' then
					local decoded = settingsUnquote(value)
					if decoded ~= nil then fields[key] = decoded end
				else
					fields[key] = value
				end
			end
		end
		local name = fields.Name
		if type(name) == "string" and name ~= "" then
			entries[name] = fields
		end
	end
	return entries
end

local function settingBool(value, fallback)
	if value == "true" or value == true then return true end
	if value == "false" or value == false then return false end
	return fallback
end

local function getPowerTextBoxes(frame)
	local result = {}
	for _, descendant in ipairs(frame:GetDescendants()) do
		if descendant:IsA("TextBox") then
			result[descendant.Name] = result[descendant.Name] or {}
			table.insert(result[descendant.Name], descendant)
		end
	end
	return result
end

local function getPowerFrames()
	local powersFrame = find("PlayerPowers", "ScrollingFrame")
	if not powersFrame then return {} end
	local result = {}
	for _, child in ipairs(powersFrame:GetChildren()) do
		if child:IsA("GuiObject") then
			result[child.Name] = child
		end
	end
	return result
end

local watchedPowerTextBoxes = setmetatable({}, { __mode = "k" })

local function watchPowerTextBoxes(frame)
	for _, descendant in ipairs(frame:GetDescendants()) do
		if descendant:IsA("TextBox") and not watchedPowerTextBoxes[descendant] then
			watchedPowerTextBoxes[descendant] = true
			descendant:GetPropertyChangedSignal("Text"):Connect(function()
				if queueSavePlayerSettings then queueSavePlayerSettings() end
			end)
		end
	end
	frame.DescendantAdded:Connect(function(descendant)
		if descendant:IsA("TextBox") and not watchedPowerTextBoxes[descendant] then
			watchedPowerTextBoxes[descendant] = true
			descendant:GetPropertyChangedSignal("Text"):Connect(function()
				if queueSavePlayerSettings then queueSavePlayerSettings() end
			end)
			task.defer(queueSavePlayerSettings)
		end
	end)
end

local State

local function capturePlayerSettingsDefaults()
	for name, record in pairs(State.records) do
		if not playerSettingsDefaults[name] then
			local defaults = {
				Activated = record.container:GetAttribute("Activated") == true,
				Status = {},
				Keys = {},
				TextBoxes = {},
			}
			for role, binder in pairs(record.binders) do
				defaults.Status[role] = record.armed == true
				defaults.Keys[role] = binder.key and binder.key.Name or ""
			end
			for boxName, boxes in pairs(getPowerTextBoxes(record.frame)) do
				defaults.TextBoxes[boxName] = boxes[1] and boxes[1].Text or ""
			end
			playerSettingsDefaults[name] = defaults
		end
	end
end

local function serializePlayerSettings()
	local output = {}
	for name, record in pairs(State.records) do
		local fields = {
			'Name=' .. settingsQuote(name),
			'Activated=' .. tostring(record.container:GetAttribute("Activated") == true),
		}
		for role, binder in pairs(record.binders) do
			table.insert(fields, "StatusKeybind_" .. role .. "=" .. tostring(record.armed == true))
			table.insert(fields, "Keybind_" .. role .. "=" .. settingsQuote(binder.key and binder.key.Name or ""))
		end
		for boxName, boxes in pairs(getPowerTextBoxes(record.frame)) do
			if #boxes > 0 then
				table.insert(fields, "TextBox_" .. boxName .. "=" .. settingsQuote(boxes[1].Text))
			end
		end
		table.insert(output, "[" .. table.concat(fields, ",") .. "]")
	end

	local numericFields = { 'Name="__Numeric"' }
	for _, name in ipairs(NUMERIC_BOXES) do
		local boxes = numericBoxes[name] or {}
		local value = boxes[1] and boxes[1].Text or ""
		table.insert(numericFields, name .. "=" .. settingsQuote(value))
	end
	table.insert(output, "[" .. table.concat(numericFields, ",") .. "]")
	return table.concat(output, ",")
end

queueSavePlayerSettings = function()
	if not playerSettingsLoaded or playerSettingsLoading or playerSettingsSaveQueued then return end
	playerSettingsSaveQueued = true
	task.delay(0.25, function()
		playerSettingsSaveQueued = false
		if playerSettingsLoaded and not playerSettingsLoading and dataPlayerSettings and dataPlayerSettings.Parent then
			local serialized = serializePlayerSettings()
			if dataPlayerSettings.Value ~= serialized then
				writingPlayerSettingsValue = true
				dataPlayerSettings.Value = serialized
				writingPlayerSettingsValue = false
			end
		end
	end)
end

local function keyCodeFromSetting(value)
	if type(value) ~= "string" or value == "" then return nil end
	local keyName = value
	if #keyName == 1 and keyName:match("%d") then
		local digits = { ["0"]="Zero", ["1"]="One", ["2"]="Two", ["3"]="Three", ["4"]="Four", ["5"]="Five", ["6"]="Six", ["7"]="Seven", ["8"]="Eight", ["9"]="Nine" }
		keyName = digits[keyName]
	end
	local ok, keyCode = pcall(function() return Enum.KeyCode[keyName] end)
	if ok and keyCode and keyCode ~= Enum.KeyCode.Unknown then return keyCode end
	return nil
end

local function restorePlayerSettings(force)
	if (playerSettingsLoaded and not force) or playerSettingsLoading then return end
	playerSettingsLoading = true
	for _, name in ipairs(NUMERIC_BOXES) do
		if playerSettingsNumericDefaults[name] == nil then
			local boxes = numericBoxes[name] or {}
			playerSettingsNumericDefaults[name] = boxes[1] and boxes[1].Text or ""
		end
	end
	local entries = parsePlayerSettings(dataPlayerSettings.Value)

	for name, record in pairs(State.records) do
		local saved = entries[name]
		local defaults = playerSettingsDefaults[name] or {
			Activated = false, Status = {}, Keys = {}, TextBoxes = {},
		}
		if saved then
			local activated = settingBool(saved.Activated, defaults.Activated)
			record.container:SetAttribute("Activated", activated)
			for role, binder in pairs(record.binders) do
				local savedKey = saved["Keybind_" .. role]
				local defaultKey = defaults.Keys[role] or ""
				local keyCode = keyCodeFromSetting(type(savedKey) == "string" and savedKey or "")
				if not keyCode then
					keyCode = keyCodeFromSetting(defaultKey)
				end
				binder.key = keyCode
				local status = settingBool(saved["StatusKeybind_" .. role], defaults.Status[role] == true)
				if status ~= nil then record.armed = status end
			end
			local textBoxes = getPowerTextBoxes(record.frame)
			for boxName, boxes in pairs(textBoxes) do
				local savedText = saved["TextBox_" .. boxName]
				if type(savedText) ~= "string" then
					savedText = defaults.TextBoxes[boxName]
				end
				if type(savedText) == "string" then
					for _, box in ipairs(boxes) do box.Text = savedText end
				end
			end
		else
			record.container:SetAttribute("Activated", defaults.Activated == true)
			for role, binder in pairs(record.binders) do
				binder.key = keyCodeFromSetting(defaults.Keys[role] or "")
				record.armed = defaults.Status[role] == true
			end
			for boxName, boxes in pairs(getPowerTextBoxes(record.frame)) do
				local defaultText = defaults.TextBoxes[boxName]
				if type(defaultText) == "string" then
					for _, box in ipairs(boxes) do box.Text = defaultText end
				end
			end
		end
		for _, binder in pairs(record.binders) do refreshBinder(binder, true) end
	end

	local numeric = entries.__Numeric
	for _, name in ipairs(NUMERIC_BOXES) do
		local savedText = numeric and numeric[name]
		local valid = type(savedText) == "string" and (savedText == "" or tonumber(savedText) ~= nil)
		if valid and savedText ~= "" then
			local numberValue = tonumber(savedText)
			valid = numberValue ~= nil and numberValue == numberValue and math.abs(numberValue) < 1000000
			if valid and name == "Transparency" then
				savedText = tostring(math.clamp(numberValue, 0, 1))
			elseif valid and (name == "Speed" or name == "JumpPower" or name == "Jump" or name == "Scale") then
				valid = numberValue >= 0
			end
		end
		if not valid then
			savedText = playerSettingsNumericDefaults[name] or ""
		end
		for _, box in ipairs(numericBoxes[name] or {}) do
			box.Text = savedText
		end
	end

	playerSettingsLoading = false
	playerSettingsLoaded = true

	for name, record in pairs(State.records) do
		onMasterChanged(name)
	end

	if humanoid then
		for _, name in ipairs(NUMERIC_BOXES) do
			local boxes = numericBoxes[name] or {}
			local value = boxes[1] and tonumber(boxes[1].Text) or nil
			if name ~= "Transparency" then
				applyNumeric(name, value)
			end
		end
	end
	queueSavePlayerSettings()
end

