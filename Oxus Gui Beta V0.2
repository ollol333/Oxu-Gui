local function tangentAttachment(attachment, tangent)
	local x = tangent.Unit
	local helper = math.abs(x.Y) > 0.99 and Vector3.xAxis or Vector3.yAxis
	local z = x:Cross(helper).Unit
	local y = z:Cross(x)
	attachment.CFrame = CFrame.fromMatrix(Vector3.zero, x, y, z)
end

local function trailPoint(state, position)
	local part = Instance.new("Part")
	part.Name = "TrailPoint"
	part.Size = Vector3.new(0.1, 0.1, 0.1)
	part.Transparency = 1
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false
	part.CFrame = CFrame.new(position)
	local attachment = Instance.new("Attachment")
	attachment.Parent = part
	part.Parent = state.folder
	return part, attachment
end

local function trailAdd(state, position)
	local part, attachment = trailPoint(state, position)
	if state.lastPart then
		local step = position - state.lastPosition
		local before = state.prevPosition and (position - state.prevPosition) or step
		tangentAttachment(state.lastAttachment, before)
		tangentAttachment(attachment, step)

		local curve = step.Magnitude * CFG.TRAIL_CURVE_RATIO
		local beam = Instance.new("Beam")
		beam.Name = "TrailBeam"
		beam.Texture = CFG.TRAIL_TEXTURE
		beam.LightInfluence = 1
		beam.LightEmission = 1
		beam.Color = ColorSequence.new(state.color)
		beam.Segments = 25
		beam.Width0 = 4
		beam.Width1 = 4
		beam.FaceCamera = false
		beam.CurveSize0 = curve
		beam.CurveSize1 = -curve
		beam.Attachment0 = state.lastAttachment
		beam.Attachment1 = attachment
		beam.Parent = state.lastPart
		state.prevPosition = state.lastPosition
	else
		state.prevPosition = nil
	end
	state.lastPart = part
	state.lastAttachment = attachment
	state.lastPosition = position
end

local function trailUpdate(state, target, dt)
	local character = target.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid or humanoid.Health <= 0 then return end

	if state.character ~= character then
		state.character = character
		state.lastPart = nil
		state.lastAttachment = nil
		state.lastPosition = nil
		state.prevPosition = nil
	end

	local targetCFrame = root.CFrame
	if not state.lastPart or not state.lastPart.Parent then
		trailAdd(state, targetCFrame.Position)
		state.lastPart.CFrame = targetCFrame
		state.lastPosition = targetCFrame.Position
		return
	end

	local currentCFrame = state.lastPart.CFrame
	local alpha = 1 - math.exp(-12 * math.clamp(dt or 1 / 60, 0, 0.1))
	local smoothCFrame = currentCFrame:Lerp(targetCFrame, alpha)
	state.lastPart.CFrame = smoothCFrame

	local attachment = state.lastAttachment
	if attachment then
		local _, yaw, _ = smoothCFrame:ToOrientation()
		attachment.CFrame = CFrame.Angles(0, yaw, 0)
	end

	local anchorPosition = state.lastPosition or smoothCFrame.Position
	if (smoothCFrame.Position - anchorPosition).Magnitude >= CFG.TRAIL_SPACING then
		local previousPart = state.lastPart
		local previousPosition = smoothCFrame.Position
		local previousAttachment = state.lastAttachment
		local oldAnchor = state.lastPosition

		local part, newAttachment = trailPoint(state, previousPosition)
		part.CFrame = smoothCFrame
		local step = previousPosition - (oldAnchor or previousPosition)
		if step.Magnitude < 0.001 then
			step = smoothCFrame.LookVector
		end
		tangentAttachment(previousAttachment, step)
		tangentAttachment(newAttachment, step)

		local curve = math.clamp(step.Magnitude * CFG.TRAIL_CURVE_RATIO, 1, CFG.TRAIL_SPACING * 0.3)
		local beam = Instance.new("Beam")
		beam.Name = "TrailBeam"
		beam.Texture = CFG.TRAIL_TEXTURE
		beam.LightInfluence = 1
		beam.LightEmission = 1
		beam.Color = ColorSequence.new(state.color)
		beam.Segments = 25
		beam.Width0 = 4
		beam.Width1 = 4
		beam.FaceCamera = false
		beam.CurveSize0 = curve
		beam.CurveSize1 = -curve
		beam.Attachment0 = previousAttachment
		beam.Attachment1 = newAttachment
		beam.Parent = previousPart

		state.prevPosition = oldAnchor
		state.lastPart = part
		state.lastAttachment = newAttachment
		state.lastPosition = previousPosition
	end
end

local function trailRelease(record, target, state)
	record.applied[target] = nil
	state.folder:Destroy()
end

local function trailStep(record)
	local selection = selectedByList[PlayersListEffects]
	for target, state in pairs(record.applied) do
		if not selection[target] or target.Parent ~= Players then
			trailRelease(record, target, state)
		end
	end
	for target in pairs(selection) do
		if target.Parent == Players then
			local state = record.applied[target]
			if not state then
				local folder = Instance.new("Folder")
				folder.Name = tostring(target.UserId)
				folder.Parent = record.trailRoot
				state = {
					folder = folder,
					color = Color3.fromHSV(math.random(), 0.8, 1),
					character = nil,
					lastPart = nil,
					lastAttachment = nil,
					lastPosition = nil,
					prevPosition = nil,
				}
				record.applied[target] = state
			end
			trailUpdate(state, target, 1 / 60)
		end
	end
end

