		"CelestialBodiesShown", "StarCount", "SunTextureId", "SunAngularSize", "MoonTextureId", "MoonAngularSize",
	} },
	{ name = "Bloom", class = "BloomEffect", parent = "Lighting", props = { "Enabled", "Intensity", "Size", "Threshold" } },
	{ name = "Blur", class = "BlurEffect", parent = "Lighting", props = { "Enabled", "Size" } },
	{ name = "ColorCorrection", class = "ColorCorrectionEffect", parent = "Lighting", props = { "Enabled", "Brightness", "Contrast", "Saturation", "TintColor" } },
	{ name = "ColorGrading", class = "ColorGradingEffect", parent = "Lighting", props = { "Enabled", "TonemapperPreset" } },
	{ name = "DepthOfField", class = "DepthOfFieldEffect", parent = "Lighting", props = { "Enabled", "FarIntensity", "FocusDistance", "InFocusRadius", "NearIntensity" } },
	{ name = "SunRays", class = "SunRaysEffect", parent = "Lighting", props = { "Enabled", "Intensity", "Spread" } },
}

local anchored = false
local enforceBudget = ENFORCE_BUDGET

local function newTarget(definition)
	local target = {
		name = definition.name,
		class = definition.class,
		props = definition.props,
		isLighting = definition.isLighting == true,
		inst = nil,
		ghost = nil,
		created = false,
		pending = false,
		baseline = {},
		desired = {},
		written = {},
		warned = {},
		connections = {},
	}
	if definition.parent == "Terrain" then
		target.parentGetter = function()
			return workspace.Terrain
		end
	else
		target.parentGetter = function()
			return Lighting
		end
	end
	return target
end

