	local pivotOffset = root.CFrame:ToObjectSpace(character:GetPivot())
	character:PivotTo(targetCFrame * pivotOffset)
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
end

function trackLastSpawnInstance(instance, char)
	if not (instance:IsA("BasePart") or instance:IsA("Decal") or instance:IsA("Texture")) then
		return
	end
	State.lastSpawnPropertyRecords[instance] = {
		Transparency = instance.Transparency,
		Color = instance:IsA("BasePart") and instance.Color or nil,
		Material = instance:IsA("BasePart") and instance.Material or nil,
	}
	for _, property in ipairs({"Transparency", "Color", "Material"}) do
		if property == "Transparency" or instance:IsA("BasePart") then
			instance:GetPropertyChangedSignal(property):Connect(function()
				if State.lastSpawnApplyingEffect or not instance.Parent or not instance:IsDescendantOf(char) then return end
				local record = State.lastSpawnPropertyRecords[instance]
				if not record then return end
				local ok, value = pcall(function() return instance[property] end)
				if ok then record[property] = value end
			end)
		end
	end
end

function trackLastSpawnProperties(char)
	for _, instance in ipairs(char:GetDescendants()) do
		trackLastSpawnInstance(instance, char)
	end
	char.DescendantAdded:Connect(function(instance)
		trackLastSpawnInstance(instance, char)
	end)
end

function playLastSpawnRespawnEffect(char, targetCFrame, previousRootCFrame)
	State.lastSpawnEffectToken += 1
	local token = State.lastSpawnEffectToken
	local camera = workspace.CurrentCamera
	local cameraStart = camera and camera.CFrame
	local cameraRelative = CFrame.new()
	local snapshots = {}

	for instance, properties in pairs(State.lastSpawnPropertyRecords) do
		if instance.Parent and instance:IsDescendantOf(char) then
			snapshots[instance] = {
				Transparency = properties.Transparency,
				Color = properties.Color,
				Material = properties.Material,
			}
		end
	end

	if camera and cameraStart then
		camera.CameraType = Enum.CameraType.Scriptable
		camera.CFrame = cameraStart
	end

	State.lastSpawnApplyingEffect = true
	for instance in pairs(snapshots) do
		if instance.Parent then
			pcall(function()
				instance.Transparency = 1
				if instance:IsA("BasePart") then
					instance.Color = Color3.new(1, 1, 1)
					instance.Material = Enum.Material.Neon
				end
			end)
		end
	end
	State.lastSpawnApplyingEffect = false

	teleportRoot(targetCFrame)
	local root = char:FindFirstChild("HumanoidRootPart")
	local targetCameraCFrame = State.lastSpawnDeathCameraCFrame or cameraStart

	if camera and cameraStart and targetCameraCFrame then
		task.spawn(function()
			local elapsed = 0
			while elapsed < 1.2 and token == State.lastSpawnEffectToken do
				elapsed += RunService.RenderStepped:Wait()
				camera.CFrame = cameraStart:Lerp(targetCameraCFrame, math.clamp(elapsed / 1.2, 0, 1))
			end
			if token == State.lastSpawnEffectToken then
				camera.CFrame = targetCameraCFrame
				camera.CameraType = Enum.CameraType.Custom
				local newHumanoid = char:FindFirstChildOfClass("Humanoid")
				if newHumanoid then camera.CameraSubject = newHumanoid end
			end
		end)
	end

	task.spawn(function()
		local elapsed = 0
		while elapsed < 0.9 and token == State.lastSpawnEffectToken do
			elapsed += RunService.RenderStepped:Wait()
			local alpha = math.clamp(elapsed / 0.9, 0, 1)
			State.lastSpawnApplyingEffect = true
			for instance, properties in pairs(snapshots) do
				if instance.Parent then
					pcall(function()
						instance.Transparency = 1 - (1 - (properties.Transparency or 0)) * alpha
					end)
				end
			end
			State.lastSpawnApplyingEffect = false
		end

		local colorElapsed = 0
		while colorElapsed < 0.45 and token == State.lastSpawnEffectToken do
			colorElapsed += RunService.RenderStepped:Wait()
			local alpha = math.clamp(colorElapsed / 0.45, 0, 1)
			State.lastSpawnApplyingEffect = true
			for instance, properties in pairs(snapshots) do
				if instance.Parent and instance:IsA("BasePart") and properties.Color then
					pcall(function()
						instance.Color = Color3.new(1, 1, 1):Lerp(properties.Color, alpha)
					end)
				end
			end
			State.lastSpawnApplyingEffect = false
		end

		State.lastSpawnApplyingEffect = true
		for instance, properties in pairs(snapshots) do
			if instance.Parent then
				pcall(function()
					if instance:IsA("BasePart") and properties.Material then
						instance.Material = properties.Material
					end
					if properties.Color and instance:IsA("BasePart") then
						instance.Color = properties.Color
					end
					instance.Transparency = properties.Transparency or 0
				end)
			end
		end
		State.lastSpawnApplyingEffect = false

	end)
end

function bindLastSpawnDeath(char)
	if State.lastSpawnTrackedCharacter == char then return end
	State.lastSpawnTrackedCharacter = char
	trackLastSpawnProperties(char)
	local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 10)
	if not hum then return end
	hum.Died:Connect(function()
		local root = char:FindFirstChild("HumanoidRootPart")
		if root then
			State.lastSpawnDeathCFrame = root.CFrame
