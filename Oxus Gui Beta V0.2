local function configNumbers(value)
	local result = {}
	if type(value) ~= "string" then return nil end
	for number in string.gmatch(value, "[^,]+") do
		local parsed = tonumber(string.match(number, "^%s*(.-)%s*$"))
		if not parsed or parsed ~= parsed or parsed == math.huge or parsed == -math.huge then
			return nil
		end
		table.insert(result, parsed)
	end
	return result
end

local function validEnumItem(enumType, name)
	local ok, item = pcall(function()
		return enumType[name]
	end)
	return ok and item ~= nil
end

local function parseConfig(name, rawValue)
	if type(rawValue) ~= "string" then return nil end
	local value = string.match(rawValue, "^%s*(.-)%s*$")
	if value == "" then return nil end

	if name == "TWEEN_INFO" then
		local parts = string.split(value, ",")
		if #parts ~= 3 then return nil end
		local duration = tonumber(parts[1])
		local styleName = string.match(parts[2], "^%s*(.-)%s*$")
		local directionName = string.match(parts[3], "^%s*(.-)%s*$")
		if not duration or duration ~= duration or duration < 0 or duration > 60 then return nil end
		if not validEnumItem(Enum.EasingStyle, styleName) or not validEnumItem(Enum.EasingDirection, directionName) then return nil end
		return TweenInfo.new(duration, Enum.EasingStyle[styleName], Enum.EasingDirection[directionName])
	elseif name == "INFO_SIZE" then
		local n = configNumbers(value)
		if not n or #n ~= 4 or n[1] < 0 or n[2] < 0 or n[3] < 0 or n[4] < 0 then return nil end
		for _, number in ipairs(n) do if math.abs(number) > 100000 then return nil end end
		return UDim2.new(n[1], n[2], n[3], n[4])
	elseif name == "AVOID_ANGLES" then
		local n = configNumbers(value)
		if not n or #n == 0 then return nil end
		for _, number in ipairs(n) do
			if number < -360 or number > 360 then return nil end
		end
		return n
	elseif name == "AIM_MODES" then
		local result = {}
		for entry in string.gmatch(value, "[^,]+") do
			entry = string.match(entry, "^%s*(.-)%s*$")
			if entry ~= "Humanoid" and entry ~= "Torso" and entry ~= "Head" then return nil end
			table.insert(result, entry)
		end
		if #result == 0 then return nil end
		return result
	elseif name == "HEALTH_GREEN" or name == "HEALTH_YELLOW" or name == "HEALTH_RED"
		or name == "HEALTH_BLACK" or name == "SELECTED_COLOR" or name == "NORMAL_COLOR"
		or name == "GREEN_COLOR" or name == "PINK_COLOR" or name == "WHITE_COLOR"
		or name == "INFO_STROKE_COLOR" then
		local n = configNumbers(value)
		if not n or #n ~= 3 then return nil end
		for _, number in ipairs(n) do
			if number < 0 or number > 255 or number % 1 ~= 0 then return nil end
		end
		return Color3.fromRGB(n[1], n[2], n[3])
	end

	local numeric = tonumber(value)
	if numeric ~= nil then
		if numeric ~= numeric or numeric == math.huge or numeric == -math.huge then return nil end
		local limits = {
			DRIFT_LIMIT = {0.01, 10000},
			VOID_MARGIN = {0, 1000},
			DEFAULT_RADIUS = {0.01, 100000},
			EFFECT_INTERVAL = {0.01, 10},
			AVOID_DEFAULT_RADIUS = {0.01, 100000},
			AVOID_MARGIN = {0, 10000},
			AVOID_MAX_DROP = {0, 10000},
			AVOID_RETRY = {0.01, 60},
			TRAIL_SPACING = {0.01, 10000},
			TRAIL_BREAK = {0.01, 100000},
			TRAIL_CURVE_RATIO = {0, 1},
			FOLLOW_STOP_DISTANCE = {0, 100000},
			HITBOX_MIN = {0, 10},
			HITBOX_MAX = {0, 10},
		}
		local range = limits[name]
		if range and (numeric < range[1] or numeric > range[2]) then return nil end
		if name == "DEFAULT_RADIUS" or name == "AVOID_DEFAULT_RADIUS" then
			return value
		end
		return numeric
	end

	if #value > 200 or string.find(value, "[%c]") then return nil end
	if name == "TRAIL_TEXTURE" and not string.match(value, "^rbxassetid://%d+$") then return nil end
	if name == "RESOURCES_FOLDER" or string.match(name, "^ATTR_") then
		if not string.match(value, "^[%w_]+$") then return nil end
	end
	return value
end

local function ensureConfigValue(name, default)
	local item = CONFIG_DATA:FindFirstChild(name)
	if item and not item:IsA("StringValue") then
		item:Destroy()
		item = nil
	end
	if not item then
		item = Instance.new("StringValue")
		item.Name = name
		item.Value = default
		item.Parent = CONFIG_DATA
	end
	local parsed = parseConfig(name, item.Value)
	if parsed == nil then
		item.Value = default
		parsed = parseConfig(name, default)
	end
	return item, parsed
end

for name, default in pairs(CONFIG_DEFAULTS) do
	local _, parsed = ensureConfigValue(name, default)
	CFG[name] = parsed
end

local templates = {}
local records = { [PlayersListEffects] = {}, [PlayersListTp] = {} }
local listBoxes = { [PlayersListEffects] = PlayerEffectsBox, [PlayersListTp] = PlayerTpBox }
local selectedByList = { [PlayersListEffects] = {}, [PlayersListTp] = {} }
local allMode = { [PlayersListEffects] = false, [PlayersListTp] = false }
local allSnapshot = { [PlayersListEffects] = {}, [PlayersListTp] = {} }
local selectedPlayer = nil
local lastSelectedPlayer = nil
local hoveredPlayer = nil
local displayedPlayer = nil
local lastInfoUpdate = 0
local lastListUpdate = 0
local listDirty = true

for _, list in ipairs({ PlayersListEffects, PlayersListTp }) do
	local template = list:FindFirstChild("PlayerMarc")
	assert(template and template:IsA("Frame"), "Falta el Frame PlayerMarc dentro de " .. list:GetFullName())
	templates[list] = template
