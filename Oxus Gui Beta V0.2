local function pushHistory(change)
	if historyApplying then return end
	table.insert(undoStack, { change })
	if #undoStack > 100 then table.remove(undoStack, 1) end
	table.clear(redoStack)
end

local function cloneForHistory(instance)
	if not instance then return nil end
	local previous = instance.Archivable
	pcall(function() instance.Archivable = true end)
	local ok, copy = pcall(function() return instance:Clone() end)
	pcall(function() instance.Archivable = previous end)
	if not ok then return nil end
	return copy
end

local function recordObjectCreated(instance)
	pushHistory({ kind = "created", instance = instance })
end

local function recordObjectDeleted(instance)
	local snapshot = cloneForHistory(instance)
	if not snapshot then return end
	local pivot
	pcall(function() pivot = instance:GetPivot() end)
	pushHistory({ kind = "deleted", snapshot = snapshot, parent = instance.Parent, pivot = pivot })
end

local function waitDeep(root, name, className)
	local waited = 0
	local warned = false
	while true do
		for _, descendant in ipairs(root:GetDescendants()) do
			if descendant.Name == name and (not className or descendant:IsA(className)) then
				return descendant
			end
		end
		task.wait(0.2)
		waited += 0.2
		if waited >= 5 and not warned then
			warned = true
			warn("OxusGuiBeta: no se encontro " .. name .. " dentro de " .. root:GetFullName())
		end
	end
end

local function findOptional(root, name, className)
	for _, descendant in ipairs(root:GetDescendants()) do
		if descendant.Name == name and descendant:IsA(className) then
			return descendant
		end
	end
	return nil
end

