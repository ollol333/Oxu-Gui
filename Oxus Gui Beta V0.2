local function nearestSelected(mode)
	local root = getRoot()
	if not root then return nil end
	local bestPart, bestDistance = nil, math.huge
	for target in pairs(selectedByList[PlayersListEffects]) do
		local part = target.Parent and targetPartFor(target, mode)
		if part then
			local distance = (part.Position - root.Position).Magnitude
			if distance < bestDistance then
				bestPart, bestDistance = part, distance
			end
		end
	end
	return bestPart
end

local function aimRestore()
	local humanoid = getHumanoid()
	if not humanoid then return end
	local original = humanoid:GetAttribute(CFG.ATTR_AUTOROTATE)
	if original ~= nil then
		humanoid.AutoRotate = original
		humanoid:SetAttribute(CFG.ATTR_AUTOROTATE, nil)
	end
end

local function aimStep(record)
	local root = getRoot()
	local humanoid = getHumanoid()
	if not root or not humanoid or humanoid.Health <= 0 then return end

	local part = nearestSelected(record.mode)
	if not part then
		aimRestore()
		return
	end

	if humanoid:GetAttribute(CFG.ATTR_AUTOROTATE) == nil then
		humanoid:SetAttribute(CFG.ATTR_AUTOROTATE, humanoid.AutoRotate)
	end
	humanoid.AutoRotate = false

	local flat = Vector3.new(part.Position.X - root.Position.X, 0, part.Position.Z - root.Position.Z)
	if flat.Magnitude > 0.05 then
		root.CFrame = CFrame.lookAt(root.Position, root.Position + flat)
	end

	local camera = workspace.CurrentCamera
	if camera then
		camera.CFrame = CFrame.lookAt(camera.CFrame.Position, part.Position)
	end
end

