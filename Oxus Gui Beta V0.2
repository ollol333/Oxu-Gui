local function matchesName(instance, names)
	if type(names) == "table" then
		return table.find(names, instance.Name) ~= nil
	end
	return instance.Name == names
end

local function findDeep(root, names, className)
	for _, descendant in ipairs(root:GetDescendants()) do
		if matchesName(descendant, names) and (not className or descendant:IsA(className)) then
			return descendant
		end
	end
	return nil
end

local function waitDeep(root, names, className, timeout)
	local label = type(names) == "table" and names[1] or names
	local waited = 0
	local warned = false
	while true do
		local found = findDeep(root, names, className)
		if found then
			return found
		end
		task.wait(0.2)
		waited += 0.2
		if timeout and waited >= timeout then
			warn("OxusLightingEditor: no se encontro " .. label .. " dentro de " .. root:GetFullName())
			return nil
		end
		if not timeout and waited >= 5 and not warned then
			warned = true
			warn("OxusLightingEditor: no se encontro " .. label .. " dentro de " .. root:GetFullName())
		end
	end
end

