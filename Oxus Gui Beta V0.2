		{ "CompressorSoundEffect", { "Attack", "GainMakeup", "Ratio", "Release", "Threshold" } },
		{ "DistortionSoundEffect", { "Level" } },
		{ "EchoSoundEffect", { "Delay", "DryLevel", "Feedback", "WetLevel" } },
		{ "EqualizerSoundEffect", { "HighGain", "MidGain", "LowGain" } },
		{ "FlangeSoundEffect", { "Depth", "Mix", "Rate" } },
		{ "PitchShiftSoundEffect", { "Octave" } },
		{ "ReverbSoundEffect", { "DecayTime", "Density", "Diffusion", "DryLevel", "WetLevel" } },
		{ "TremoloSoundEffect", { "Depth", "Duty", "Frequency" } },
	}

	local KIND_BY_TYPE = {
		boolean = "bool",
		EnumItem = "enum",
		number = "text",
		string = "text",
		Vector3 = "text",
		Vector2 = "text",
		UDim = "text",
		UDim2 = "text",
		CFrame = "text",
		NumberRange = "text",
		NumberSequence = "text",
		ColorSequence = "text",
		Rect = "text",
		BrickColor = "text",
		Font = "text",
	}

	local propEntries = {}
	local propsQuery = ""
	local activeSelection = nil
	local optionButtons = {}
	local lastPoll = 0

	local deselectSelection
	local selectSelection
	local paintOptions

	local function fmtNum(number)
		local text = string.format("%.4f", number)
		text = string.gsub(text, "0+$", "")
		text = string.gsub(text, "%.$", "")
		if text == "" or text == "-0" or text == "-" then
			text = "0"
		end
		return text
	end

	local function serializeValue(value)
		local kind = typeof(value)
		if kind == "number" then
			return fmtNum(value)
		elseif kind == "string" then
			return value
		elseif kind == "Vector3" then
			return fmtNum(value.X) .. ", " .. fmtNum(value.Y) .. ", " .. fmtNum(value.Z)
		elseif kind == "Vector2" then
			return fmtNum(value.X) .. ", " .. fmtNum(value.Y)
		elseif kind == "UDim" then
			return fmtNum(value.Scale) .. ", " .. fmtNum(value.Offset)
		elseif kind == "UDim2" then
			return "{" .. fmtNum(value.X.Scale) .. ", " .. fmtNum(value.X.Offset) .. "}, {" .. fmtNum(value.Y.Scale) .. ", " .. fmtNum(value.Y.Offset) .. "}"
		elseif kind == "CFrame" then
			local rx, ry, rz = value:ToOrientation()
			return fmtNum(value.X) .. ", " .. fmtNum(value.Y) .. ", " .. fmtNum(value.Z) .. ", "
				.. fmtNum(math.deg(rx)) .. ", " .. fmtNum(math.deg(ry)) .. ", " .. fmtNum(math.deg(rz))
		elseif kind == "NumberRange" then
			return fmtNum(value.Min) .. ", " .. fmtNum(value.Max)
		elseif kind == "Rect" then
			return fmtNum(value.Min.X) .. ", " .. fmtNum(value.Min.Y) .. ", " .. fmtNum(value.Max.X) .. ", " .. fmtNum(value.Max.Y)
		elseif kind == "BrickColor" then
			return value.Name
		elseif kind == "Font" then
			return value.Family .. ", " .. value.Weight.Name .. ", " .. value.Style.Name
		elseif kind == "NumberSequence" then
			local parts = {}
			for _, keypoint in ipairs(value.Keypoints) do
				table.insert(parts, string.format('"Hora %s Valor %s"', fmtNum(keypoint.Time), fmtNum(keypoint.Value)))
			end
			return "[" .. table.concat(parts, ",") .. "]"
		elseif kind == "ColorSequence" then
			local parts = {}
			for _, keypoint in ipairs(value.Keypoints) do
				local color = keypoint.Value
				table.insert(parts, string.format(
					'"Hora %s Color %d,%d,%d"',
					fmtNum(keypoint.Time),
					math.floor(color.R * 255 + 0.5),
					math.floor(color.G * 255 + 0.5),
					math.floor(color.B * 255 + 0.5)
					))
			end
			return "[" .. table.concat(parts, ",") .. "]"
		end
		return tostring(value)
	end

	local function numbersIn(text)
		local list = {}
		for token in string.gmatch(text, "%-?%d*%.?%d+") do
			local number = tonumber(token)
			if number then
				table.insert(list, number)
			end
		end
		return list
	end

	local function sequenceEntries(text)
		local entries = {}
		for entry in string.gmatch(text, '"([^"]*)"') do
			table.insert(entries, entry)
		end
		if #entries == 0 then
			for entry in string.gmatch(text, "[^;%[%]]+") do
				table.insert(entries, entry)
			end
		end
		return entries
	end

	local function normalizePoints(points)
		if #points == 0 then return nil end
		table.sort(points, function(a, b)
			return a.time < b.time
		end)
		points[1].time = 0
		if #points == 1 then
			table.insert(points, { time = 1, value = points[1].value })
		end
		points[#points].time = 1
		local result = {}
		local last = -1
		for _, point in ipairs(points) do
			if point.time > last then
				table.insert(result, point)
				last = point.time
			end
		end
		if #result < 2 then return nil end
		return result
	end

	local function parseNumberSequence(text)
		local points = {}
		for _, entry in ipairs(sequenceEntries(text)) do
			local numbers = numbersIn(entry)
			if #numbers >= 2 then
				table.insert(points, { time = math.clamp(numbers[1], 0, 1), value = numbers[2] })
			end
		end
		points = normalizePoints(points)
		if not points then return nil end
		local keypoints = {}
		for _, point in ipairs(points) do
			table.insert(keypoints, NumberSequenceKeypoint.new(point.time, point.value))
		end
		return NumberSequence.new(keypoints)
	end

	local function parseColorSequence(text)
		local points = {}
		for _, entry in ipairs(sequenceEntries(text)) do
			local numbers = numbersIn(entry)
			if #numbers >= 4 then
				table.insert(points, {
					time = math.clamp(numbers[1], 0, 1),
					value = Color3.fromRGB(math.clamp(numbers[2], 0, 255), math.clamp(numbers[3], 0, 255), math.clamp(numbers[4], 0, 255)),
				})
			end
		end
		points = normalizePoints(points)
		if not points then return nil end
		local keypoints = {}
		for _, point in ipairs(points) do
			table.insert(keypoints, ColorSequenceKeypoint.new(point.time, point.value))
		end
		return ColorSequence.new(keypoints)
	end

	local function enumOr(enumType, name, fallback)
		local ok, item = pcall(function()
			return enumType[name]
		end)
		if ok and item then
			return item
		end
		return fallback
	end

	local function parseFont(text, current)
		local parts = {}
		for part in string.gmatch(text, "[^,]+") do
			table.insert(parts, (string.gsub(part, "^%s*(.-)%s*$", "%1")))
		end
		local family = parts[1]
		if not family or family == "" then return nil end
		return Font.new(
			family,
			enumOr(Enum.FontWeight, parts[2], current.Weight),
			enumOr(Enum.FontStyle, parts[3], current.Style)
		)
	end

	local function parseValue(text, current)
		local kind = typeof(current)
		if kind == "string" then
			return text
		elseif kind == "BrickColor" then
			return BrickColor.new(text)
		elseif kind == "Font" then
			return parseFont(text, current)
		elseif kind == "NumberSequence" then
			return parseNumberSequence(text)
		elseif kind == "ColorSequence" then
			return parseColorSequence(text)
		end
		local n = numbersIn(text)
		if kind == "number" then
			return n[1]
		elseif kind == "Vector3" then
			if #n >= 3 then return Vector3.new(n[1], n[2], n[3]) end
			if #n == 1 then return Vector3.new(n[1], n[1], n[1]) end
		elseif kind == "Vector2" then
			if #n >= 2 then return Vector2.new(n[1], n[2]) end
			if #n == 1 then return Vector2.new(n[1], n[1]) end
		elseif kind == "UDim" then
			if #n >= 2 then return UDim.new(n[1], n[2]) end
		elseif kind == "UDim2" then
			if #n >= 4 then return UDim2.new(n[1], n[2], n[3], n[4]) end
		elseif kind == "CFrame" then
			if #n >= 12 then return CFrame.new(table.unpack(n, 1, 12)) end
			if #n >= 6 then
				return CFrame.new(n[1], n[2], n[3]) * CFrame.fromOrientation(math.rad(n[4]), math.rad(n[5]), math.rad(n[6]))
			end
			if #n >= 3 then return CFrame.new(n[1], n[2], n[3]) * current.Rotation end
		elseif kind == "NumberRange" then
			if #n >= 2 then return NumberRange.new(math.min(n[1], n[2]), math.max(n[1], n[2])) end
			if #n == 1 then return NumberRange.new(n[1]) end
		elseif kind == "Rect" then
			if #n >= 4 then return Rect.new(n[1], n[2], n[3], n[4]) end
		end
		return nil
	end

	local function sameValue(a, b)
		if a == b then return true end
		local kind = typeof(a)
		if kind ~= typeof(b) then return false end
		if kind == "NumberSequence" or kind == "ColorSequence" or kind == "Font" then
			return serializeValue(a) == serializeValue(b)
		end
		return false
	end

	local function readProp(instance, name)
		if string.sub(name, 1, 1) == "@" then
			return instance:GetAttribute(string.sub(name, 2))
		end
		local ok, value = pcall(function()
			return instance[name]
		end)
		if ok then
			return value
		end
		return nil
	end

	local function writeProp(name, value)
		local isAttribute = string.sub(name, 1, 1) == "@"
		local key = isAttribute and string.sub(name, 2) or name
		for _, instance in ipairs(selectedList) do
			pcall(function()
				if isAttribute then
					instance:SetAttribute(key, value)
				else
					instance[key] = value
				end
			end)
		end
	end

	local function readShared(name)
		local first = readProp(selectedList[1], name)
		for index = 2, #selectedList do
			if not sameValue(first, readProp(selectedList[index], name)) then
				return first, true
			end
		end
		return first, false
	end

	local function propertyNamesFor(instance)
		local names = {}
		local seen = {}
		for _, set in ipairs(PROPERTY_SETS) do
			if instance:IsA(set[1]) then
				for _, name in ipairs(set[2]) do
					if not seen[name] then
						seen[name] = true
						table.insert(names, name)
					end
				end
			end
		end
		return names
	end

	local function sharedProperties()
		local list = {}
		local first = selectedList[1]
		if not first then return list end
		for _, name in ipairs(propertyNamesFor(first)) do
			local firstValue = readProp(first, name)
			local kind = KIND_BY_TYPE[typeof(firstValue)]
			if kind then
				local compatible = true
				for index = 2, #selectedList do
					if typeof(readProp(selectedList[index], name)) ~= typeof(firstValue) then
						compatible = false
						break
					end
				end
				if compatible then
					table.insert(list, { name = name, kind = kind })
				end
			end
		end
		local attributeNames = {}
		for attributeName, attributeValue in pairs(first:GetAttributes()) do
			local kind = KIND_BY_TYPE[typeof(attributeValue)]
			if kind and kind ~= "enum" then
				local compatible = true
				for index = 2, #selectedList do
					if typeof(selectedList[index]:GetAttribute(attributeName)) ~= typeof(attributeValue) then
						compatible = false
						break
					end
				end
				if compatible then
					table.insert(attributeNames, attributeName)
				end
			end
		end
		table.sort(attributeNames)
		for _, attributeName in ipairs(attributeNames) do
			table.insert(list, { name = "@" .. attributeName, kind = KIND_BY_TYPE[typeof(first:GetAttribute(attributeName))] })
		end
		return list
	end

	local function clearOptions()
		for _, option in ipairs(optionButtons) do
			option.connection:Disconnect()
			option.button:Destroy()
		end
		table.clear(optionButtons)
	end

	paintOptions = function()
		local entry = activeSelection
		for _, option in ipairs(optionButtons) do
			local isCurrent = entry ~= nil and not entry.mixed and entry.value == option.item
			option.button.BackgroundTransparency = isCurrent and OPTION_ON or OPTION_OFF
		end
	end

	deselectSelection = function()
		local entry = activeSelection
		if not entry then return end
		activeSelection = nil
		entry.button.BackgroundTransparency = OPTION_OFF
		clearOptions()
		SeleccionsList.Text = ""
		if HIDE_IDLE_PANELS then
			SeleccionsList.Visible = false
		end
	end

	selectSelection = function(entry)
		if activeSelection == entry then
			deselectSelection()
			return
		end
		deselectSelection()
		activeSelection = entry
		entry.button.BackgroundTransparency = OPTION_ON
		SeleccionsList.Text = entry.name
		if HIDE_IDLE_PANELS then
			SeleccionsList.Visible = true
		end
		for index, item in ipairs(entry.enumType:GetEnumItems()) do
			local button = OptionTemplate:Clone()
			button.Name = "Option_" .. item.Name
			button.Text = item.Name
			button.LayoutOrder = index
			button.BackgroundTransparency = OPTION_OFF
			button.Visible = true
			button.Parent = OptionsHolder
			local connection = button.Activated:Connect(function()
				writeProp(entry.name, item)
				entry.refresh()
				paintOptions()
			end)
			table.insert(optionButtons, { button = button, item = item, connection = connection })
		end
		paintOptions()
	end

	local function newRow(template, name, order)
		local frame = template:Clone()
		frame.Name = "Prop_" .. name
		frame.LayoutOrder = order
		frame.Visible = true
		local label = frame:FindFirstChild("NamePropiedad", true)
		if label then
			label.Text = name
		end
		return frame
	end

	local function makeBoolEntry(def, order)
		local frame = newRow(TemplateCasilla, def.name, order)
		local button = frame:FindFirstChild("TrueOrFalseButton", true)
		local entry = { name = def.name, frame = frame, connections = {}, value = false, mixed = false }
		entry.refresh = function()
			local value, mixed = readShared(def.name)
			entry.value = value
			entry.mixed = mixed
			button.BackgroundTransparency = 0
			if mixed then
				button.Text = "-"
				button.TextColor3 = CHECK_MIXED_TEXT
				button.BackgroundColor3 = CHECK_OFF_BG
			elseif value then
				button.Text = "✓"
				button.TextColor3 = CHECK_ON_TEXT
				button.BackgroundColor3 = checkOnBackground
			else
				button.Text = ""
				button.BackgroundColor3 = CHECK_OFF_BG
			end
		end
		table.insert(entry.connections, button.Activated:Connect(function()
			writeProp(def.name, entry.mixed or entry.value ~= true)
			entry.refresh()
		end))
		return entry
	end

	local function makeEnumEntry(def, order)
		local frame = newRow(TemplateSeleccions, def.name, order)
		local button = frame:FindFirstChild("TextMultipleSelection", true)
		local first = readProp(selectedList[1], def.name)
		local entry = {
			name = def.name,
			frame = frame,
			connections = {},
			button = button,
			enumType = first.EnumType,
			value = first,
			mixed = false,
		}
		button.BackgroundTransparency = OPTION_OFF
		entry.refresh = function()
			local value, mixed = readShared(def.name)
			if value == nil then return end
			entry.value = value
			entry.mixed = mixed
			button.Text = mixed and "Varios" or value.Name
			if activeSelection == entry then
				paintOptions()
			end
		end
		table.insert(entry.connections, button.Activated:Connect(function()
			selectSelection(entry)
		end))
		return entry
	end

	local function makeTextEntry(def, order)
		local frame = newRow(TemplateTxt, def.name, order)
		local box = frame:FindFirstChild("Value", true)
		local entry = { name = def.name, frame = frame, connections = {}, shown = nil }
		box.ClearTextOnFocus = false
		entry.refresh = function()
			if box:IsFocused() then return end
			local value, mixed = readShared(def.name)
			if value == nil then return end
			if mixed then
				entry.shown = ""
				box.Text = ""
				box.PlaceholderText = "Varios"
			else
				local text = serializeValue(value)
				if text ~= entry.shown or box.Text ~= text then
					entry.shown = text
					box.Text = text
				end
			end
		end
		table.insert(entry.connections, box.FocusLost:Connect(function()
			if box.Text ~= entry.shown then
				local current = readProp(selectedList[1], def.name)
				local ok, parsed = pcall(parseValue, box.Text, current)
				if ok and parsed ~= nil then
					writeProp(def.name, parsed)
				end
			end
			entry.shown = nil
			entry.refresh()
		end))
		return entry
	end

	local ROW_MAKERS = {
		bool = makeBoolEntry,
		enum = makeEnumEntry,
		text = makeTextEntry,
	}

	local function applyFilter()
		for _, entry in ipairs(propEntries) do
			local show = propsQuery == "" or string.find(entry.lower, propsQuery, 1, true) ~= nil
			if entry.frame.Visible ~= show then
				entry.frame.Visible = show
			end
		end
	end

	local function clearRows()
		deselectSelection()
		for _, entry in ipairs(propEntries) do
			for _, connection in ipairs(entry.connections) do
				connection:Disconnect()
			end
			entry.frame:Destroy()
		end
		table.clear(propEntries)
	end

	local function rebuildProps()
		clearRows()
		if #selectedList == 0 then return end
		for index, def in ipairs(sharedProperties()) do
			local entry = ROW_MAKERS[def.kind](def, index)
			entry.lower = string.lower(def.name)
			entry.frame.Parent = PropsList
			entry.refresh()
			table.insert(propEntries, entry)
		end
		applyFilter()
	end

	local function pollProps(now)
		if #selectedList == 0 then return end
		local interval = #selectedList > 100 and 1 or POLL_INTERVAL
		if now - lastPoll < interval then return end
		lastPoll = now
		for _, entry in ipairs(propEntries) do
			entry.refresh()
		end
	end

	PropsSearch:GetPropertyChangedSignal("Text"):Connect(function()
		propsQuery = string.lower(string.match(PropsSearch.Text, "^%s*(.-)%s*$") or "")
		applyFilter()
	end)

	RunService.Heartbeat:Connect(function()
		if not sectionIsOpen() then return end
		if propsDirty then
			propsDirty = false
			rebuildProps()
		end
		pollProps(os.clock())
	end)
end
end

do
local __mergedScriptName = "Visuals"

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")
local Gui = PlayerGui:WaitForChild("OxusGuiBeta")
local PrincipalMenu = Gui:WaitForChild("PrincipalMenu")
local Seccion7 = PrincipalMenu:WaitForChild("Seccion7")

local Data = Gui:WaitForChild("Data")


local SettingsValue = Data:FindFirstChild("CameraYVisualsSettings")
if not (SettingsValue and SettingsValue:IsA("StringValue")) then
	SettingsValue = Instance.new("StringValue")
	SettingsValue.Name = "CameraYVisualsSettings"
	local suffix = 2
	while Data:FindFirstChild(SettingsValue.Name) do
		SettingsValue.Name = "CameraYVisualsSettings" .. suffix
		suffix += 1
	end
	SettingsValue.Parent = Data
end

local Settings = {}
local SettingHandlers = {}
local ApplyingExternalSettings = false

-- Nombres aceptados: se guardan con una clave canonica para evitar duplicados.
local SettingAliases = {
	CameraOffsetX = "X",
	CameraOffsetY = "Y",
	CameraOffsetZ = "Z",
	CameraMode = "Mode",
	CameraType = "Mode",
	Hide = "HideAll",
}

-- Valores iniciales para que todos los ajustes existan desde el primer inicio.
local DefaultSettings = {
	Zoom = "70",
	X = "0",
	Y = "0",
	Z = "0",
	Mode = "Default",
	Xray = "0",
	HideAll = "0",
	EntityVisual = "0",
	NightVision = "0",
}

local KnownSettings = {
	Zoom = true, X = true, Y = true, Z = true,
	Mode = true, Xray = true, HideAll = true,
	EntityVisual = true, NightVision = true,
}

local function canonicalKey(key)
	key = string.match(tostring(key or ""), "^%s*(.-)%s*$") or ""
	return SettingAliases[key] or key
end

local function normalizeSetting(key, value)
	key = canonicalKey(key)
	if not KnownSettings[key] then
		return nil, nil, false
	end

	value = string.match(tostring(value or ""), "^%s*(.-)%s*$") or ""

	if key == "Zoom" or key == "X" or key == "Y" or key == "Z" then
		if value == "" then
			return key, nil, true
		end
		local number = tonumber(value)
		if not number or number ~= number or math.abs(number) == math.huge then
			return key, nil, true
		end
		if key == "Zoom" then
			if number < 1 or number > 120 then
				return key, nil, true
			end
		elseif number < -1000 or number > 1000 then
			return key, nil, true
		end
		return key, tostring(number), true
	elseif key == "Mode" then
		local modes = {
			Default = true, First = true, Second = true,
			Third = true, Realistic = true,
		}
		if modes[value] then
			return key, value, true
		end
		return key, "Default", true
	else
		local lowered = string.lower(value)
		if lowered == "1" or lowered == "true" then
			return key, "1", true
		elseif lowered == "0" or lowered == "false" then
			return key, "0", true
		end
		-- Un toggle mal formado se apaga solo; no afecta las otras opciones.
		return key, "0", true
	end
end

local function parseSettings(value)
	local parsed = {}
	for key, item in string.gmatch(tostring(value or ""), "([^=;]+)=([^;]*);?") do
		local normalizedKey, normalizedValue, recognized = normalizeSetting(key, item)
		if recognized then
			parsed[normalizedKey] = normalizedValue
		end
	end
	return parsed
end

for key, value in pairs(DefaultSettings) do
	Settings[key] = value
end
for key, value in pairs(parseSettings(SettingsValue.Value)) do
	Settings[key] = value
end

local function serializeSettings(source)
	local entries = {}
	local outputNames = {
		X = "CameraOffsetX",
		Y = "CameraOffsetY",
		Z = "CameraOffsetZ",
		Mode = "CameraType",
	}
	for key, defaultValue in pairs(DefaultSettings) do
		local value = source[key]
		if value == nil or tostring(value) == "" then
			value = defaultValue
		end
		local outputKey = outputNames[key] or key
		table.insert(entries, outputKey .. "=" .. tostring(value))
	end
	table.sort(entries)
	return table.concat(entries, ";")
end

local function saveSettings()
	SettingsValue.Value = serializeSettings(Settings)
end

-- Completa y guarda las claves iniciales que falten en el StringValue.
SettingsValue.Value = serializeSettings(Settings)

local function setSetting(key, value)
	local normalizedKey, normalizedValue, recognized = normalizeSetting(key, value)
	if not recognized then
		return
	end
	Settings[normalizedKey] = normalizedValue
	if not ApplyingExternalSettings then
		saveSettings()
	end
end

local function registerSetting(key, callback)
	SettingHandlers[key] = callback
end

local function applySettingsValue()
	local parsed = parseSettings(SettingsValue.Value)
	for key, defaultValue in pairs(DefaultSettings) do
		if parsed[key] == nil then
			parsed[key] = defaultValue
		end
	end
	ApplyingExternalSettings = true

	-- Cada ajuste se valida por separado. Si uno es incorrecto, solo ese
	-- vuelve a su valor seguro; el resto conserva los valores recibidos.
	for key, callback in pairs(SettingHandlers) do
		local value = parsed[key]
		Settings[key] = value
		local ok, err = pcall(callback, value)
		if not ok then
			warn("CameraYVisualsSettings (" .. key .. "): " .. tostring(err))
		end
	end
	for key, value in pairs(parsed) do
		Settings[key] = value
	end

	local normalized = serializeSettings(Settings)
	if SettingsValue.Value ~= normalized then
		SettingsValue.Value = normalized
	end
	ApplyingExternalSettings = false
end

SettingsValue:GetPropertyChangedSignal("Value"):Connect(function()
	if not ApplyingExternalSettings then
		applySettingsValue()
	end
end)

local function settingNumber(key)
	local value = tonumber(Settings[key])
	if value and value == value then
		return value
	end
	return nil
end

local function settingEnabled(key)
	return Settings[key] == "1" or Settings[key] == "true"
end

local TOGGLE_ON = 0.9
local TOGGLE_OFF = 1

local TOGGLE_IMAGES = {
	Xray = { on = "rbxassetid://133131316068102", off = "rbxassetid://82016937910211" },
	HideAll = { on = "rbxassetid://133131316068102", off = "rbxassetid://82016937910211" },
	EntityVisual = { on = "rbxassetid://133131316068102", off = "rbxassetid://82016937910211" },
	NightVision = { on = "rbxassetid://133131316068102", off = "rbxassetid://82016937910211" },
}

local Shared = {
	spectated = nil,
}

function Shared.viewedCharacter()
	local player = Shared.spectated
	if player then
		local character = player.Character
		if character and character.Parent then
			return character
		end
	end
	return LocalPlayer.Character
end

local function nameMatches(name, wanted)
	if type(wanted) == "table" then
		return table.find(wanted, name) ~= nil
	end
	return name == wanted
end

local function waitDeep(root, name, className)
	local waited = 0
	local warned = false
	while true do
		for _, descendant in ipairs(root:GetDescendants()) do
			if nameMatches(descendant.Name, name) and (not className or descendant:IsA(className)) then
				return descendant
			end
		end
		task.wait(0.2)
		waited += 0.2
		if waited >= 5 and not warned then
			warned = true
			local label = type(name) == "table" and table.concat(name, "/") or name
			warn("OxusGuiSeccion7: no se encontro " .. label .. " dentro de " .. root:GetFullName())
		end
	end
end

local function sameValue(a, b)
	if a == b then return true end
	local kind = typeof(a)
	if kind ~= typeof(b) then return false end
	if kind == "number" then
		return math.abs(a - b) < 1e-4
	elseif kind == "Vector3" then
		return (a - b).Magnitude < 1e-4
	elseif kind == "Color3" then
		return math.abs(a.R - b.R) < 1e-3 and math.abs(a.G - b.G) < 1e-3 and math.abs(a.B - b.B) < 1e-3
	end
	return false
end

local function releaseLock(store, instance)
	local lock = store[instance]
	if not lock then return end
	store[instance] = nil
	lock.connection:Disconnect()
	pcall(function()
		instance[lock.property] = lock.restore
	end)
end

local function ensureLock(store, instance, property, value)
	local lock = store[instance]
	if lock then
		if not sameValue(lock.value, value) then
			lock.value = value
			pcall(function()
				instance[property] = value
			end)
		end
		return lock
	end
	lock = { property = property, value = value, restore = instance[property] }
	lock.connection = instance:GetPropertyChangedSignal(property):Connect(function()
		local current = instance[property]
		if sameValue(current, lock.value) then return end
		lock.restore = current
		pcall(function()
			instance[property] = lock.value
		end)
	end)
	store[instance] = lock
	pcall(function()
		instance[property] = value
	end)
	return lock
end

local function clearStore(store, keep)
	for instance in pairs(store) do
		if instance ~= keep then
			releaseLock(store, instance)
		end
	end
end

local function bindToggle(button, callback, initial)
	local active = initial == true
	local images = TOGGLE_IMAGES[button.Name]
	local function paint()
		button.BackgroundTransparency = active and TOGGLE_ON or TOGGLE_OFF
		if images then
			local image = active and images.on or images.off
			if image ~= "" and button.Image ~= image then
				button.Image = image
			end
		end
	end
	paint()
	callback(active)
	local function setActive(value)
		value = value == true
		if active == value then
			paint()
			return
		end
		active = value
		paint()
		callback(active)
	end
	button.Activated:Connect(function()
		setActive(not active)
	end)
	return setActive
end

local function bindNumberBox(box, minimum, maximum, key, apply)
	box.ClearTextOnFocus = false
	local shown = box.Text
	box.FocusLost:Connect(function()
		local trimmed = string.match(box.Text, "^%s*(.-)%s*$") or ""
		local value = nil
		if trimmed ~= "" then
			value = tonumber(trimmed)
			if value == nil or value ~= value then
				box.Text = shown
				return
			end
			value = math.clamp(value, minimum, maximum)
		end
		shown = value ~= nil and tostring(value) or ""
		box.Text = shown
		setSetting(key, value)
		apply(value)
	end)
end

do
	local SearchBox = waitDeep(Seccion7, "SearchPlayerSpectating", "TextBox")
	local PlayersList = waitDeep(Seccion7, "PlayersList", "ScrollingFrame")
	local PlayerTemplate = waitDeep(PlayersList, "PlayerMarc", "Frame")
	local PreviousButton = waitDeep(Seccion7, "AnteriorJugadorSpectear", "ImageButton")
	local NextButton = waitDeep(Seccion7, "SiguienteJugadorASpectear", "ImageButton")
	local SpectatingLabel = waitDeep(Seccion7, "PlayerSpectatingTxt", "TextLabel")

	local ROW_ON = 0.9
	local ROW_OFF = 1

	local entries = {}
	local query = ""

	PlayerTemplate.Visible = false
	SpectatingLabel.Text = ""

	local function labelFor(player)
		if player.DisplayName ~= player.Name then
			return player.DisplayName .. " (@" .. player.Name .. ")"
		end
		return player.Name
	end

	local function paintEntries()
		for player, entry in pairs(entries) do
			entry.frame.BackgroundTransparency = Shared.spectated == player and ROW_ON or ROW_OFF
		end
	end

	local function setSpectate(player)
		if player ~= nil and not entries[player] then
			player = nil
		end
		Shared.spectated = player
		SpectatingLabel.Text = player and labelFor(player) or ""
		paintEntries()
	end

	local function resort()
		local list = {}
		for _, entry in pairs(entries) do
			table.insert(list, entry)
		end
		table.sort(list, function(a, b)
			return a.sortKey < b.sortKey
		end)
		for index, entry in ipairs(list) do
			entry.frame.LayoutOrder = index
		end
	end

	local function applyFilter()
		for _, entry in pairs(entries) do
			local show = query == "" or string.find(entry.searchKey, query, 1, true) ~= nil
			if entry.frame.Visible ~= show then
				entry.frame.Visible = show
			end
		end
	end

	local function visibleEntries()
		local list = {}
		for _, entry in pairs(entries) do
			if entry.frame.Visible then
				table.insert(list, entry)
			end
		end
		table.sort(list, function(a, b)
			return a.sortKey < b.sortKey
		end)
		return list
	end

	local function cycle(direction)
		local list = visibleEntries()
		local count = #list
		if count == 0 then return end
		local index = 0
		for position, entry in ipairs(list) do
			if entry.player == Shared.spectated then
				index = position
				break
			end
		end
		if index == 0 then
			index = direction > 0 and 1 or count
		else
			index = (index - 1 + direction) % count + 1
		end
		setSpectate(list[index].player)
	end

	local function addEntry(player)
		if player == LocalPlayer or entries[player] then return end
		local frame = PlayerTemplate:Clone()
		frame.Name = "Player_" .. player.Name
		frame.BackgroundTransparency = ROW_OFF
		frame.Visible = true
		local button = frame:FindFirstChild("Button", true)
		local avatar = frame:FindFirstChild("AvatarIcon", true)
		local nameLabel = frame:FindFirstChild("PlayerName", true)
		if nameLabel then
			nameLabel.Text = labelFor(player)
		end
		local entry = {
			player = player,
			frame = frame,
			sortKey = string.lower(player.Name),
			searchKey = string.lower(player.Name .. " " .. player.DisplayName),
		}
		if button then
			entry.connection = button.Activated:Connect(function()
				if Shared.spectated == player then
					setSpectate(nil)
				else
					setSpectate(player)
				end
			end)
		end
		entries[player] = entry
		frame.Parent = PlayersList
		if avatar then
			task.spawn(function()
				local ok, image = pcall(function()
					return Players:GetUserThumbnailAsync(player.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
				end)
				if ok and avatar.Parent then
					avatar.Image = image
				end
			end)
		end
		resort()
		applyFilter()
	end

	local function removeEntry(player)
		local entry = entries[player]
		if not entry then return end
		entries[player] = nil
		if entry.connection then
			entry.connection:Disconnect()
		end
		entry.frame:Destroy()
		if Shared.spectated == player then
			setSpectate(nil)
		end
		resort()
	end

	for _, player in ipairs(Players:GetPlayers()) do
		addEntry(player)
	end
	Players.PlayerAdded:Connect(addEntry)
	Players.PlayerRemoving:Connect(removeEntry)

	SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
		query = string.lower(string.match(SearchBox.Text, "^%s*(.-)%s*$") or "")
		applyFilter()
	end)

	PreviousButton.Activated:Connect(function()
		cycle(-1)
	end)
	NextButton.Activated:Connect(function()
		cycle(1)
	end)
end

do
	local ZoomBox = waitDeep(Seccion7, "Zoom", "TextBox")
	local XBox = waitDeep(Seccion7, "CameraXOffset", "TextBox")
	local YBox = waitDeep(Seccion7, "CameraYOffset", "TextBox")
	local ZBox = waitDeep(Seccion7, "CameraZOffset", "TextBox")
	local ModeButton = waitDeep(Seccion7, "CameraMode", "TextButton")

	local RENDER_NAME = "OxusSeccion7Camera"
	local FIRST_PERSON_DISTANCE = 0.5
	local THIRD_PERSON_DISTANCE = 12
	local SECOND_PERSON_DISTANCE = 8
	local SECOND_PERSON_HEIGHT = 1
	local FOV_MIN = 1
	local FOV_MAX = 120
	local OFFSET_LIMIT = 1000

	local MODES = {
		{ id = "Default", text = "Default" },
		{ id = "First", text = "Primera Persona" },
		{ id = "Second", text = "Segunda Persona" },
		{ id = "Third", text = "Tercera Persona" },
		{ id = "Realistic", text = "Primera Persona (Realista)" },
	}

	local modeIndex = 1
	for index, mode in ipairs(MODES) do
		if mode.id == Settings.Mode then
			modeIndex = index
			break
		end
	end
	local fovValue = settingNumber("Zoom")
	local offsetAxes = { X = settingNumber("X"), Y = settingNumber("Y"), Z = settingNumber("Z") }
	local fovLocks = {}
	local typeLocks = {}
	local subjectLocks = {}
	local minZoomLocks = {}
	local maxZoomLocks = {}
	local offsetState = nil
	local controlled = false
	local recordedCFrame = nil
	local lastApplied = nil
	local hiddenParts = {}
	local hiddenCharacter = nil
	local hiddenStamp = 0

	local function offsetActive()
		return offsetAxes.X ~= nil or offsetAxes.Y ~= nil or offsetAxes.Z ~= nil
	end

	local function desiredOffset(restore)
		return Vector3.new(offsetAxes.X or restore.X, offsetAxes.Y or restore.Y, offsetAxes.Z or restore.Z)
	end

	local function releaseOffset()
		local state = offsetState
		if not state then return end
		offsetState = nil
		state.connection:Disconnect()
		pcall(function()
			state.humanoid.CameraOffset = state.restore
		end)
	end

	local function bindOffset(humanoid)
		local state = offsetState
		if state and state.humanoid == humanoid then
			local desired = desiredOffset(state.restore)
			if not sameValue(state.applied, desired) then
				state.applied = desired
				humanoid.CameraOffset = desired
			end
			return
		end
		releaseOffset()
		state = { humanoid = humanoid, restore = humanoid.CameraOffset }
		state.connection = humanoid:GetPropertyChangedSignal("CameraOffset"):Connect(function()
			local current = humanoid.CameraOffset
			if sameValue(current, desiredOffset(state.restore)) then return end
			state.restore = current
			local desired = desiredOffset(current)
			state.applied = desired
			humanoid.CameraOffset = desired
		end)
		offsetState = state
		local desired = desiredOffset(state.restore)
		state.applied = desired
		humanoid.CameraOffset = desired
	end

	local function showHead()
		for _, part in ipairs(hiddenParts) do
			if part.Parent then
				part.LocalTransparencyModifier = 0
			end
		end
		table.clear(hiddenParts)
		hiddenCharacter = nil
	end

	local function hideHead(character)
		local now = os.clock()
		if hiddenCharacter ~= character or now - hiddenStamp > 0.5 then
			if hiddenCharacter ~= character then
				showHead()
			end
			hiddenCharacter = character
			hiddenStamp = now
			table.clear(hiddenParts)
			for _, descendant in ipairs(character:GetDescendants()) do
				if descendant:IsA("BasePart") and (descendant.Name == "Head" or descendant.Parent:IsA("Accessory")) then
					table.insert(hiddenParts, descendant)
				end
			end
		end
		for _, part in ipairs(hiddenParts) do
			part.LocalTransparencyModifier = 1
		end
	end

	local function sameCFrame(a, b)
		return (a.Position - b.Position).Magnitude < 1e-3 and a.LookVector:Dot(b.LookVector) > 0.99999
	end

	local function setZoom(value)
		local currentMin = minZoomLocks[LocalPlayer] and minZoomLocks[LocalPlayer].value or LocalPlayer.CameraMinZoomDistance
		if currentMin > value then
			ensureLock(minZoomLocks, LocalPlayer, "CameraMinZoomDistance", value)
			ensureLock(maxZoomLocks, LocalPlayer, "CameraMaxZoomDistance", value)
		else
			ensureLock(maxZoomLocks, LocalPlayer, "CameraMaxZoomDistance", value)
			ensureLock(minZoomLocks, LocalPlayer, "CameraMinZoomDistance", value)
		end
	end

	local function computeCFrame(mode, character)
		local head = character:FindFirstChild("Head")
		local root = character:FindFirstChild("HumanoidRootPart")
		local anchor = (head and head:IsA("BasePart") and head)
			or (root and root:IsA("BasePart") and root)
			or character:FindFirstChildWhichIsA("BasePart")
		if not anchor then
			return nil
		end
		local reference = (root and root:IsA("BasePart") and root) or anchor
		local offset = reference.CFrame:VectorToWorldSpace(Vector3.new(offsetAxes.X or 0, offsetAxes.Y or 0, offsetAxes.Z or 0))
		if mode == "Realistic" then
			return anchor.CFrame + offset
		end
		local origin = anchor.Position
		local position = origin + reference.CFrame.LookVector * SECOND_PERSON_DISTANCE + Vector3.new(0, SECOND_PERSON_HEIGHT, 0)
		return CFrame.lookAt(position, origin) + offset
	end

	local function releaseCamera(camera)
		clearStore(typeLocks)
		clearStore(subjectLocks)
		clearStore(minZoomLocks)
		clearStore(maxZoomLocks)
		showHead()
		local subject = camera.CameraSubject
		if subject ~= nil and not subject:IsDescendantOf(Workspace) then
			local character = LocalPlayer.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			if humanoid then
				camera.CameraSubject = humanoid
			end
		end
		if camera.CameraType == Enum.CameraType.Scriptable and recordedCFrame then
			camera.CFrame = recordedCFrame
		end
		recordedCFrame = nil
		lastApplied = nil
		controlled = false
	end

	local function step()
		local camera = Workspace.CurrentCamera
		if not camera then return end

		if fovValue then
			clearStore(fovLocks, camera)
			ensureLock(fovLocks, camera, "FieldOfView", fovValue)
		else
			clearStore(fovLocks)
		end

		local mode = MODES[modeIndex].id
		local scriptable = mode == "Second" or mode == "Realistic"
		local wantsControl = Shared.spectated ~= nil or mode ~= "Default"
		local character = Shared.viewedCharacter()
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")

		if wantsControl then
			if not controlled then
				controlled = true
				recordedCFrame = camera.CFrame
				lastApplied = nil
			end
			clearStore(typeLocks, camera)
			clearStore(subjectLocks, camera)
			ensureLock(typeLocks, camera, "CameraType", scriptable and Enum.CameraType.Scriptable or Enum.CameraType.Custom)
			if scriptable then
				clearStore(subjectLocks)
				clearStore(minZoomLocks)
				clearStore(maxZoomLocks)
				if character then
					local cframe = computeCFrame(mode, character)
					if cframe then
						if lastApplied and not sameCFrame(camera.CFrame, lastApplied) then
							recordedCFrame = camera.CFrame
						end
						camera.CFrame = cframe
						lastApplied = camera.CFrame
					end
					if mode == "Realistic" then
						hideHead(character)
					else
						showHead()
					end
				end
			else
				showHead()
				local subject = humanoid or (character and (character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")))
				if subject then
					ensureLock(subjectLocks, camera, "CameraSubject", subject)
				else
					clearStore(subjectLocks)
				end
				if mode == "First" then
					setZoom(FIRST_PERSON_DISTANCE)
				elseif mode == "Third" then
					setZoom(THIRD_PERSON_DISTANCE)
				else
					clearStore(minZoomLocks)
					clearStore(maxZoomLocks)
				end
			end
		elseif controlled then
			releaseCamera(camera)
		end

		if not scriptable and humanoid and offsetActive() then
			bindOffset(humanoid)
		else
			releaseOffset()
		end
	end

	ModeButton.Text = MODES[modeIndex].text
	ModeButton.Activated:Connect(function()
		modeIndex = modeIndex % #MODES + 1
		ModeButton.Text = MODES[modeIndex].text
		setSetting("Mode", MODES[modeIndex].id)
	end)

	if fovValue then ZoomBox.Text = tostring(fovValue) end
	if offsetAxes.X then XBox.Text = tostring(offsetAxes.X) end
	if offsetAxes.Y then YBox.Text = tostring(offsetAxes.Y) end
	if offsetAxes.Z then ZBox.Text = tostring(offsetAxes.Z) end

	bindNumberBox(ZoomBox, FOV_MIN, FOV_MAX, "Zoom", function(value)
		fovValue = value
	end)
	bindNumberBox(XBox, -OFFSET_LIMIT, OFFSET_LIMIT, "X", function(value)
		offsetAxes.X = value
	end)
	bindNumberBox(YBox, -OFFSET_LIMIT, OFFSET_LIMIT, "Y", function(value)
		offsetAxes.Y = value
	end)
	bindNumberBox(ZBox, -OFFSET_LIMIT, OFFSET_LIMIT, "Z", function(value)
		offsetAxes.Z = value
	end)

	registerSetting("Zoom", function(value)
		fovValue = tonumber(value)
		ZoomBox.Text = value or ""
	end)
	for axis, box in pairs({ X = XBox, Y = YBox, Z = ZBox }) do
		registerSetting(axis, function(value)
			local number = tonumber(value)
			offsetAxes[axis] = number
			box.Text = value or ""
		end)
	end
	registerSetting("Mode", function(value)
		for index, mode in ipairs(MODES) do
			if mode.id == value then
				modeIndex = index
				ModeButton.Text = mode.text
				return
			end
		end
		modeIndex = 1
		ModeButton.Text = MODES[1].text
	end)

	RunService:BindToRenderStep(RENDER_NAME, Enum.RenderPriority.Last.Value, step)

	script.Destroying:Connect(function()
		RunService:UnbindFromRenderStep(RENDER_NAME)
		clearStore(fovLocks)
		releaseOffset()
		local camera = Workspace.CurrentCamera
		if camera and controlled then
			releaseCamera(camera)
		end
		showHead()
	end)
end

do
	local XrayButton = waitDeep(Seccion7, "Xray", "ImageButton")
	local HideButton = waitDeep(Seccion7, "HideAll", "ImageButton")
	local EntityButton = waitDeep(Seccion7, "EntityVisual", "ImageButton")

	local QUEUE_BUDGET = 0.004
	local ENTITY_RANGE = 300
	local VISUAL_INTERVAL = 0.1
	local ENTITY_COLOR = Color3.fromRGB(255, 70, 70)
	local INFO_SIZE = UDim2.new(0, 225, 0, 225)
	local INFO_STROKE_COLOR = Color3.fromRGB(161, 161, 161)

	local livingCount = {}
	local triggerModel = {}
	local queue = {}
	local queued = {}
	local queueFirst = 1
	local queueLast = 0
	local visuals = {}
	local visualClock = 0
	local entityOn = false

	local function isPartTarget(instance)
		return instance:IsA("BasePart") and not instance:IsA("Terrain")
	end

	local function isHideTarget(instance)
		return isPartTarget(instance) or instance:IsA("Decal")
	end

	local xray = {
		active = false,
		store = {},
		property = "Material",
		value = Enum.Material.ForceField,
		applies = isPartTarget,
	}
	local hide = {
		active = false,
		store = {},
		property = "Transparency",
		value = 1,
		applies = isHideTarget,
	}
	local effectList = { xray, hide }

	local function isTrigger(instance)
		return instance:IsA("Humanoid")
			or instance:IsA("AnimationController")
			or instance:IsA("Animator")
			or instance:IsA("Motor6D")
			or instance:IsA("Bone")
	end

	local function modelOf(instance)
		local current = instance.Parent
		while current and current ~= Workspace do
			if current:IsA("Model") then
				return current
			end
			current = current.Parent
		end
		return nil
	end

	local function belongsToEntity(instance)
		local current = instance.Parent
		while current and current ~= Workspace do
			if livingCount[current] then
				return true
			end
			current = current.Parent
		end
		return false
	end

	local function enqueue(instance)
		if queued[instance] then return end
		queued[instance] = true
		queueLast += 1
		queue[queueLast] = instance
	end

	local function syncInstance(instance)
		local inWorkspace = instance:IsDescendantOf(Workspace)
		local entity = nil
		for _, effect in ipairs(effectList) do
			if effect.applies(instance) then
				local existing = effect.store[instance]
				local wanted = effect.active and inWorkspace
				if wanted then
					if entity == nil then
						entity = belongsToEntity(instance)
					end
					wanted = not entity
				end
				if wanted and not existing then
					ensureLock(effect.store, instance, effect.property, effect.value)
				elseif not wanted and existing then
					releaseLock(effect.store, instance)
				end
			end
		end
	end

	local function resyncModel(model)
		local relevant = false
		for _, effect in ipairs(effectList) do
			if effect.active or next(effect.store) ~= nil then
				relevant = true
				break
			end
		end
		if not relevant then return end
		for _, descendant in ipairs(model:GetDescendants()) do
			for _, effect in ipairs(effectList) do
				if effect.applies(descendant) then
					enqueue(descendant)
					break
				end
			end
		end
	end

	local function registerTrigger(instance)
		if triggerModel[instance] then return end
		local model = modelOf(instance)
		if not model then return end
		triggerModel[instance] = model
		local count = (livingCount[model] or 0) + 1
		livingCount[model] = count
		if count == 1 then
			resyncModel(model)
		end
	end

	local function unregisterTrigger(instance)
		local model = triggerModel[instance]
		if not model then return end
		triggerModel[instance] = nil
		local count = (livingCount[model] or 1) - 1
		if count <= 0 then
			livingCount[model] = nil
			resyncModel(model)
		else
			livingCount[model] = count
		end
	end

	local function setEffect(effect, active)
		effect.active = active
		if active then
			for _, descendant in ipairs(Workspace:GetDescendants()) do
				if effect.applies(descendant) then
					enqueue(descendant)
				end
			end
		else
			for instance in pairs(effect.store) do
				enqueue(instance)
			end
		end
	end

	local function isEntityModel(model)
		if not model:IsDescendantOf(Workspace) then
			return false
		end
		if Players:GetPlayerFromCharacter(model) then
			return false
		end
		local current = model.Parent
		while current and current ~= Workspace do
			if livingCount[current] then
				return false
			end
			current = current.Parent
		end
		return true
	end

	local function rootPartOf(model)
		local root = model:FindFirstChild("HumanoidRootPart")
		if root and root:IsA("BasePart") then
			return root
		end
		for _, name in ipairs({ "Torso", "UpperTorso", "LowerTorso" }) do
			local part = model:FindFirstChild(name)
			if part and part:IsA("BasePart") then
				return part
			end
		end
		return model:FindFirstChildWhichIsA("BasePart", true)
	end

	local function createVisual(model, root)
		local highlight = Instance.new("Highlight")
		highlight.Name = "OxusEntityHighlight"
		highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		highlight.FillColor = ENTITY_COLOR
		highlight.FillTransparency = 0.75
		highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
		highlight.OutlineTransparency = 0
		highlight.Adornee = model
		highlight.Parent = model

		local billboard = Instance.new("BillboardGui")
		billboard.Name = "OxusEntityView"
		billboard.Size = INFO_SIZE
		billboard.StudsOffset = Vector3.new(0, 3, 0)
		billboard.AlwaysOnTop = true
		billboard.MaxDistance = math.huge
		billboard.Adornee = root
		billboard.Parent = root

		local label = Instance.new("TextLabel")
		label.Name = "Info"
		label.BackgroundTransparency = 1
		label.Size = UDim2.fromScale(1, 1)
		label.Position = UDim2.fromScale(0, 0)
		label.TextColor3 = Color3.fromRGB(255, 255, 255)
		label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
		label.TextStrokeTransparency = 0.2
		label.TextScaled = true
		label.TextWrapped = true
		label.Font = Enum.Font.Code
		label.TextXAlignment = Enum.TextXAlignment.Left
		label.TextYAlignment = Enum.TextYAlignment.Center
		label.Parent = billboard

		local stroke = Instance.new("UIStroke")
		stroke.Color = INFO_STROKE_COLOR
		stroke.Thickness = 1.5
		stroke.Parent = label

		return { model = model, root = root, highlight = highlight, billboard = billboard, label = label }
	end

	local function destroyVisual(visual)
		visual.highlight:Destroy()
		visual.billboard:Destroy()
	end

	local function clearVisuals()
		for model, visual in pairs(visuals) do
			visuals[model] = nil
			destroyVisual(visual)
		end
	end

	local function updateLabel(visual, origin)
		local model = visual.model
		local root = visual.root
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		local position = root.Position
		local lines = {
			"Name: " .. model.Name,
			string.format("Distance: %.1f studs", (origin - position).Magnitude),
		}
		if humanoid then
			table.insert(lines, string.format("Health: %.0f / %.0f", humanoid.Health, humanoid.MaxHealth))
			table.insert(lines, string.format("WalkSpeed: %.1f", humanoid.WalkSpeed))
		end
		table.insert(lines, string.format("Position: %.1f, %.1f, %.1f", position.X, position.Y, position.Z))
		if humanoid then
			table.insert(lines, "State: " .. humanoid:GetState().Name)
		end
		local text = table.concat(lines, "\n")
		if visual.label.Text ~= text then
			visual.label.Text = text
		end
	end

	local function viewPosition()
		local character = Shared.viewedCharacter()
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root and root:IsA("BasePart") then
			return root.Position
		end
		local camera = Workspace.CurrentCamera
		if camera then
			return camera.CFrame.Position
		end
		return nil
	end

	local function refreshEntities()
		local origin = viewPosition()
		local seen = {}
		if origin then
			for model in pairs(livingCount) do
				if isEntityModel(model) then
					local root = rootPartOf(model)
					if root and (root.Position - origin).Magnitude <= ENTITY_RANGE then
						seen[model] = true
						local visual = visuals[model]
						if visual and (visual.root ~= root or not visual.billboard.Parent or not visual.highlight.Parent) then
							destroyVisual(visual)
							visuals[model] = nil
							visual = nil
						end
						if not visual then
							visual = createVisual(model, root)
							visuals[model] = visual
						end
						updateLabel(visual, origin)
					end
				end
			end
		end
		for model, visual in pairs(visuals) do
			if not seen[model] then
				visuals[model] = nil
				destroyVisual(visual)
			end
		end
	end

	for _, descendant in ipairs(Workspace:GetDescendants()) do
		if isTrigger(descendant) then
			registerTrigger(descendant)
		end
	end

	Workspace.DescendantAdded:Connect(function(instance)
		if isTrigger(instance) then
			registerTrigger(instance)
		end
		for _, effect in ipairs(effectList) do
			if effect.active and effect.applies(instance) then
				enqueue(instance)
				break
			end
		end
	end)

	Workspace.DescendantRemoving:Connect(function(instance)
		if triggerModel[instance] then
			unregisterTrigger(instance)
		end
		for _, effect in ipairs(effectList) do
			if effect.store[instance] then
				releaseLock(effect.store, instance)
			end
		end
	end)

	RunService.Heartbeat:Connect(function(dt)
		if queueFirst <= queueLast then
			local started = os.clock()
			local processed = 0
			while queueFirst <= queueLast do
				local instance = queue[queueFirst]
				queue[queueFirst] = nil
				queueFirst += 1
				queued[instance] = nil
				syncInstance(instance)
				processed += 1
				if processed % 64 == 0 and os.clock() - started > QUEUE_BUDGET then
					break
				end
			end
			if queueFirst > queueLast then
				queueFirst = 1
				queueLast = 0
			end
		end
		if entityOn then
			visualClock += dt
			if visualClock >= VISUAL_INTERVAL then
				visualClock = 0
				refreshEntities()
			end
		end
	end)

	local setXray = bindToggle(XrayButton, function(active)
		setSetting("Xray", active and "1" or "0")
		setEffect(xray, active)
	end, settingEnabled("Xray"))
	local setHide = bindToggle(HideButton, function(active)
		setSetting("HideAll", active and "1" or "0")
		setEffect(hide, active)
	end, settingEnabled("HideAll"))
	local setEntity = bindToggle(EntityButton, function(active)
		setSetting("EntityVisual", active and "1" or "0")
		entityOn = active
		visualClock = VISUAL_INTERVAL
		if not active then
			clearVisuals()
		end
	end, settingEnabled("EntityVisual"))
	registerSetting("Xray", function(value) setXray(value == "1" or value == "true") end)
	registerSetting("HideAll", function(value) setHide(value == "1" or value == "true") end)
	registerSetting("EntityVisual", function(value) setEntity(value == "1" or value == "true") end)

	script.Destroying:Connect(function()
		for _, effect in ipairs(effectList) do
			effect.active = false
			for instance in pairs(effect.store) do
				releaseLock(effect.store, instance)
			end
		end
		clearVisuals()
	end)
end

do
	local NightButton = waitDeep(Seccion7, "NightVision", "ImageButton")

	local NIGHT_AMBIENT = Color3.fromRGB(150, 255, 150)
	local NIGHT_TINT = Color3.fromRGB(140, 255, 140)
	local NIGHT_LIGHT_COLOR = Color3.fromRGB(170, 255, 170)
	local NIGHT_BRIGHTNESS = 2
	local NIGHT_EXPOSURE = 1
	local NIGHT_FOG_END = 100000
	local LIGHT_RANGE = 45
	local LIGHT_BRIGHTNESS = 1.2
	local VIGNETTE_SIZE = 0.28
	local VIGNETTE_TRANSPARENCY = 0.1
	local BASE_BRIGHTNESS = 0.08
	local FLICKER_AMOUNT = 0.02
	local FLICKER_SPEED = 38
	local RELOCK_INTERVAL = 1

	local stores = {}
	local colorEffect = nil
	local bloomEffect = nil
	local overlay = nil
	local light = nil
	local connection = nil
	local nightVisionActive = false
	local clock = 0
	local relockClock = 0

	local function lockOn(instance, property, value)
		local store = stores[property]
		if not store then
			store = {}
			stores[property] = store
		end
		ensureLock(store, instance, property, value)
	end

	local function clearLocks()
		for _, store in pairs(stores) do
			clearStore(store)
		end
	end

	local function applyLighting()
		lockOn(Lighting, "Ambient", NIGHT_AMBIENT)
		lockOn(Lighting, "OutdoorAmbient", NIGHT_AMBIENT)
		lockOn(Lighting, "Brightness", math.max(Lighting.Brightness, NIGHT_BRIGHTNESS))
		lockOn(Lighting, "ExposureCompensation", math.max(Lighting.ExposureCompensation, NIGHT_EXPOSURE))
		lockOn(Lighting, "FogEnd", NIGHT_FOG_END)
		local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
		if atmosphere then
			lockOn(atmosphere, "Density", 0)
			lockOn(atmosphere, "Haze", 0)
		end
	end

	local function buildOverlay()
		local screen = Instance.new("ScreenGui")
		screen.Name = "OxusNightVisionOverlay"
		screen.IgnoreGuiInset = true
		screen.ResetOnSpawn = false
		screen.DisplayOrder = Gui.DisplayOrder - 1
		screen.Parent = PlayerGui

		local function edge(name, size, position, anchor, rotation)
			local frame = Instance.new("Frame")
			frame.Name = name
			frame.BackgroundColor3 = Color3.new(0, 0, 0)
			frame.BorderSizePixel = 0
			frame.Active = false
			frame.Size = size
			frame.Position = position
			frame.AnchorPoint = anchor
			frame.Parent = screen
			local gradient = Instance.new("UIGradient")
			gradient.Rotation = rotation
			gradient.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, VIGNETTE_TRANSPARENCY),
				NumberSequenceKeypoint.new(1, 1),
			})
			gradient.Parent = frame
		end

		edge("Top", UDim2.new(1, 0, VIGNETTE_SIZE, 0), UDim2.fromScale(0, 0), Vector2.new(0, 0), 90)
		edge("Bottom", UDim2.new(1, 0, VIGNETTE_SIZE, 0), UDim2.fromScale(0, 1), Vector2.new(0, 1), 270)
		edge("Left", UDim2.new(VIGNETTE_SIZE, 0, 1, 0), UDim2.fromScale(0, 0), Vector2.new(0, 0), 0)
		edge("Right", UDim2.new(VIGNETTE_SIZE, 0, 1, 0), UDim2.fromScale(1, 0), Vector2.new(1, 0), 180)
		return screen
	end

	local function updateLight()
		local character = Shared.viewedCharacter()
		local head = character and character:FindFirstChild("Head")
		local parent = nil
		if head and head:IsA("BasePart") then
			parent = head
		end
		if light.Parent ~= parent then
			light.Parent = parent
		end
	end

	local function tick(dt)
		clock += dt
		relockClock += dt
		if relockClock >= RELOCK_INTERVAL then
			relockClock = 0
			applyLighting()
		end
		if colorEffect then
			colorEffect.Brightness = BASE_BRIGHTNESS + math.sin(clock * FLICKER_SPEED) * FLICKER_AMOUNT
		end
		updateLight()
	end

	local function enable()
		-- Evita crear otro juego de efectos si NightVision ya esta activo.
		if nightVisionActive then
			return
		end
		nightVisionActive = true

		applyLighting()

		colorEffect = Instance.new("ColorCorrectionEffect")
		colorEffect.Name = "OxusNightVisionColor"
		colorEffect.TintColor = NIGHT_TINT
		colorEffect.Brightness = BASE_BRIGHTNESS
		colorEffect.Contrast = 0.3
		colorEffect.Saturation = -0.7
		colorEffect.Parent = Lighting

		bloomEffect = Instance.new("BloomEffect")
		bloomEffect.Name = "OxusNightVisionBloom"
		bloomEffect.Intensity = 0.4
		bloomEffect.Size = 20
		bloomEffect.Threshold = 1
		bloomEffect.Parent = Lighting

		light = Instance.new("PointLight")
		light.Name = "OxusNightVisionLight"
		light.Color = NIGHT_LIGHT_COLOR
		light.Range = LIGHT_RANGE
		light.Brightness = LIGHT_BRIGHTNESS
		light.Shadows = false

		overlay = buildOverlay()
		clock = 0
		relockClock = 0
		connection = RunService.RenderStepped:Connect(tick)
	end

	local function disable()
		nightVisionActive = false
		if connection then
			connection:Disconnect()
			connection = nil
		end
		clearLocks()
		if colorEffect then
			colorEffect:Destroy()
			colorEffect = nil
		end
		if bloomEffect then
			bloomEffect:Destroy()
			bloomEffect = nil
		end
		if light then
			light:Destroy()
			light = nil
		end
		if overlay then
			overlay:Destroy()
			overlay = nil
		end
	end

	local setNightVision = bindToggle(NightButton, function(active)
		setSetting("NightVision", active and "1" or "0")
		if active then
			enable()
		else
			disable()
		end
	end, settingEnabled("NightVision"))
	registerSetting("NightVision", function(value)
		setNightVision(value == "1" or value == "true")
	end)

	script.Destroying:Connect(disable)
end
end

