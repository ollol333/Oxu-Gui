			State.lastSpawnDeathCameraCFrame = camera and camera.CFrame or nil
			dataLastSpawnPosition.Value = string.format("%.3f,%.3f,%.3f", root.Position.X, root.Position.Y, root.Position.Z)
		end
	end)
end

resolveTeleportPoint = function(result, params)
	local part = result.Instance
	local normal = result.Normal

	if normal.Y > 0.7 or not part:IsA("BasePart") then
		return result.Position
	end

	local cframe = part.CFrame
	if cframe.UpVector.Y < 0.7 then
		return result.Position
	end

	local localPosition = cframe:PointToObjectSpace(result.Position)
	local halfSize = part.Size / 2
	local fromTop = (halfSize.Y - localPosition.Y) / part.Size.Y
	if fromTop > 0.3 or fromTop < -0.01 then
		return result.Position
	end

	local localNormal = cframe:VectorToObjectSpace(normal)
	local inward = localPosition - localNormal * 1.5
	local limitX = math.max(halfSize.X - 0.5, 0)
	local limitZ = math.max(halfSize.Z - 0.5, 0)
	local topPoint = cframe:PointToWorldSpace(
		Vector3.new(math.clamp(inward.X, -limitX, limitX), halfSize.Y, math.clamp(inward.Z, -limitZ, limitZ))
	)

	local downward = workspace:Raycast(topPoint + Vector3.new(0, 4, 0), Vector3.new(0, -8, 0), params)
	if downward and downward.Instance == part then
		return downward.Position
	end
	return topPoint
end

