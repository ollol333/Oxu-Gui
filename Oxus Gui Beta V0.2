local objectTargets = {}
local targetsByName = {}
local allTargets = { lightingTarget }

for _, definition in ipairs(TARGET_DEFS) do
	local target = newTarget(definition)
	table.insert(objectTargets, target)
	table.insert(allTargets, target)
	targetsByName[definition.name] = target
end

local enforceTarget
local ensureInstance

local function warnOnce(target, name, message)
	if target.warned[name] then return end
	target.warned[name] = true
	warn(string.format("OxusLightingEditor: %s.%s - %s", target.name, name, message))
end

local function writeValue(target, name, value)
	local inst = target.inst
	if not inst then return false end
	local ok, err = pcall(function()
		inst[name] = value
	end)
	if not ok then
		warnOnce(target, name, "Roblox no deja cambiar esta propiedad desde un LocalScript (" .. tostring(err) .. ")")
		return false
	end
	local readOk, back = pcall(function()
		return inst[name]
	end)
	if not readOk or back == nil then
		back = value
	end
	local kind = typeof(value)
	if (kind == "EnumItem" or kind == "boolean") and back ~= value then
		target.written[name] = back
		warnOnce(target, name, "Roblox ignoro el valor asignado y la propiedad sigue en " .. tostring(back))
		return false
	end
	target.written[name] = back
	return true, back
end

local function onPropertyChanged(target, name)
	local inst = target.inst
	if not inst then return end
	local ok, value = pcall(function()
		return inst[name]
	end)
	if not ok then return end
	if target.written[name] ~= nil and value == target.written[name] then return end
	target.written[name] = nil
	target.baseline[name] = value
	if anchored then
		local wanted = target.desired[name]
		if wanted ~= nil and value ~= wanted then
			if enforceBudget > 0 then
				enforceBudget -= 1
				writeValue(target, name, wanted)
			else
				target.pending = true
			end
		end
	end
end

local function unbindTarget(target)
	for _, connection in ipairs(target.connections) do
		connection:Disconnect()
	end
	table.clear(target.connections)
	table.clear(target.written)
	target.inst = nil
end

local function bindTarget(target, inst)
	unbindTarget(target)
	target.inst = inst
	table.clear(target.baseline)
	for _, name in ipairs(target.props) do
		if not (target.isLighting and name == "TimeOfDay") then
			local ok, value = pcall(function()
				return inst[name]
			end)
			if ok and KIND_BY_TYPE[typeof(value)] then
				target.baseline[name] = value
				local signalOk, signal = pcall(function()
					return inst:GetPropertyChangedSignal(name)
				end)
				if signalOk then
					table.insert(target.connections, signal:Connect(function()
						onPropertyChanged(target, name)
					end))
				end
			end
		end
	end
end

ensureInstance = function(target)
	if target.isLighting then
		return Lighting
	end
	if target.inst and target.inst.Parent then
		return target.inst
	end
	local parent = target.parentGetter()
	local existing = parent:FindFirstChildOfClass(target.class)
	if existing then
		bindTarget(target, existing)
		target.created = false
		return existing
	end
	local inst = Instance.new(target.class)
	bindTarget(target, inst)
	target.created = true
	inst.Parent = parent
	return inst
end

enforceTarget = function(target)
	if next(target.desired) == nil then return end
	local inst = ensureInstance(target)
	if not inst then return end
	for name, wanted in pairs(target.desired) do
		local ok, current = pcall(function()
			return inst[name]
		end)
		if ok and current ~= wanted then
			writeValue(target, name, wanted)
		end
	end
end

local function enforceAll()
	for _, target in ipairs(allTargets) do
		enforceTarget(target)
	end
end

local function userSet(target, name, value)
	local inst = ensureInstance(target)
	if not inst then return false end
	local ok, back = writeValue(target, name, value)
	if not ok then return false end
	if target.isLighting and name == "TimeOfDay" then
		local clock = Lighting.ClockTime
		target.desired.ClockTime = clock
		target.written.ClockTime = clock
	else
		target.desired[name] = back
	end
	return true
end

local function resetTarget(target)
	if not target.isLighting and target.created and target.inst then
		local inst = target.inst
		unbindTarget(target)
		target.created = false
		table.clear(target.desired)
		table.clear(target.baseline)
		inst:Destroy()
		return
	end
	if target.inst then
		for name in pairs(target.desired) do
			local base = target.baseline[name]
			if base ~= nil then
				writeValue(target, name, base)
			end
		end
	end
	table.clear(target.desired)
end

local function sourceOf(target)
	local inst = target.inst
	if inst and (target.isLighting or inst.Parent) then
		return inst
	end
	if not target.ghost then
		target.ghost = Instance.new(target.class)
	end
	return target.ghost
end

local function readProp(target, name)
	local source = sourceOf(target)
	local ok, value = pcall(function()
		return source[name]
	end)
	if ok then
		return value
	end
	return nil
end

bindTarget(lightingTarget, Lighting)
for _, target in ipairs(objectTargets) do
	local existing = target.parentGetter():FindFirstChildOfClass(target.class)
	if existing then
		bindTarget(target, existing)
	end
end

local function watchParent(parent)
	parent.ChildAdded:Connect(function(child)
		for _, target in ipairs(objectTargets) do
			if not target.inst and target.parentGetter() == parent and child:IsA(target.class) then
				bindTarget(target, child)
				target.created = false
				if anchored then
					enforceTarget(target)
				end
			end
		end
	end)
	parent.ChildRemoved:Connect(function(child)
		for _, target in ipairs(objectTargets) do
			if target.inst == child then
				unbindTarget(target)
				target.created = false
				if anchored and next(target.desired) ~= nil then
					task.defer(function()
						enforceTarget(target)
					end)
				end
			end
		end
	end)
end

