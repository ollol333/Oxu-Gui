			if not masterOn(record) then return end
			record.armed = not record.armed
			syncUtilityPower(name)
			refreshBinder(binder)
		end
	elseif name == "CreatePromptTpPosition" then
		binder.getColor = function()
			if not masterOn(record) then return WHITE_COLOR end
			return WHITE_COLOR
		end
		if role == "create" then
			binder.onPress = function()
				createPromptTeleportPosition(record, binder)
			end
		else
			binder.onPress = function()
				if not masterOn(record) then return end
				deleteLastPromptTeleportPosition(record, binder)
			end
		end
	elseif name == "SaveAndLoadPosition" then
		binder.getColor = function()
			return masterOn(record) and WHITE_COLOR or WHITE_COLOR
