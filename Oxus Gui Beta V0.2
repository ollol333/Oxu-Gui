local TP_VOID_ROOT_MARGIN = 0.01

function getTpVoidGroundOffset()
	local root = getRoot()
	if not (root and character) then
		return 3
	end

	if humanoid and humanoid.RigType == Enum.HumanoidRigType.R15 then
		return humanoid.HipHeight + root.Size.Y / 2
	end

	local leg = character:FindFirstChild("Left Leg") or character:FindFirstChild("Right Leg")
	return (leg and leg.Size.Y or 2) + root.Size.Y / 2
end

function getTpVoidLevels()
	local rootY = workspace.FallenPartsDestroyHeight + TP_VOID_ROOT_MARGIN
	local platformTopY = rootY - getTpVoidGroundOffset()
	return platformTopY, rootY
end

function createTpVoidPlatform()
	destroyTpVoidPlatform()

	local platformHeight = 1
	local platformTopY = getTpVoidLevels()

	local root = getRoot()
	local centerX = root and root.Position.X or 0
	local centerZ = root and root.Position.Z or 0

	local platform = Instance.new("Part")
	platform.Name = "OxusTpVoidPlatform"
	platform.Size = Vector3.new(2500, platformHeight, 2500)
	platform.CFrame = CFrame.new(centerX, platformTopY - platformHeight / 2, centerZ)
	platform.Anchored = true
	platform.CanCollide = true
	platform.CanTouch = true
	platform.CanQuery = true
	platform.Material = Enum.Material.Grass
	platform.Color = Color3.fromRGB(126, 200, 80)
	platform.TopSurface = Enum.SurfaceType.Smooth
	platform.BottomSurface = Enum.SurfaceType.Smooth
	platform.Parent = workspace

	State.tpVoidPlatform = platform

	return platformTopY
end

function teleportToTpVoidCenter()
	local root = getRoot()
	if not root or not character then return end

	local platform = State.tpVoidPlatform
	if not platform then
		createTpVoidPlatform()
		platform = State.tpVoidPlatform
	end
	if not platform then return end

	local platformTopY, rootY = getTpVoidLevels()

	platform.CFrame = CFrame.new(platform.Position.X, platformTopY - platform.Size.Y / 2, platform.Position.Z)

	local targetPosition = Vector3.new(platform.Position.X, rootY + (State.tpVoidDeathOffset or 0), platform.Position.Z)
	local _, yaw = root.CFrame:ToOrientation()

	State.tpVoidCFrame = CFrame.new(targetPosition) * CFrame.Angles(0, yaw, 0)

	teleportRoot(State.tpVoidCFrame)
	State.tpVoidLastPosition = root.Position
end

function stopTpVoid(restorePosition)
	State.tpVoidActive = false
