		walkSpeed = number1(humanoid.WalkSpeed)
		stateName = humanoid:GetState().Name
	end

	return table.concat({
		"PlayerName: " .. displayName(target),
		"Stunds Camera: " .. number1(cameraDistance),
		"Distance: " .. number1(distance),
		string.format("Position: %.1f, %.1f, %.1f", position.X, position.Y, position.Z),
		string.format("Orientation: %.0f°, %.0f°, %.0f°", math.deg(rx), math.deg(ry), math.deg(rz)),
		"Health: " .. health,
		"Speed: " .. number1(root.AssemblyLinearVelocity.Magnitude),
		"WalkSpeed: " .. walkSpeed,
		"JumpHeight: " .. jumpHeight,
		"JumpPower: " .. jumpPower,
		"Autorotate: " .. autoRotate,
		"JumpStatus: " .. jumpStatus,
		"State: " .. stateName,
		"Tool: " .. (tool and tool.Name or "None"),
	}, "\n")
end

