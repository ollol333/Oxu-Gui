function bindCharacter(char)
	local wasFlyMode = State.flyMode
	if State.flyMode then stopFly(false) end
	local wasHitboxViewerActive = State.hitboxViewerActive
	if wasHitboxViewerActive then
		stopHitboxViewer()
	end
	local previousRoot = State.lastSpawnTrackedCharacter and State.lastSpawnTrackedCharacter:FindFirstChild("HumanoidRootPart")
	local previousRootCFrame = previousRoot and previousRoot.CFrame or nil
	if State.restoreDesanchore then State.restoreDesanchore() end
	stopHidlePlayer()
	if State.safeZoneActive then stopSafeZone(false) end
	if State.safeZoneMonitorConnection then State.safeZoneMonitorConnection:Disconnect(); State.safeZoneMonitorConnection = nil end
	character = char
	State.desanchoreOriginal = nil
	dataCharacterName.Value = char.Name
	powersCharacterChanged(char)
	humanoid = char:WaitForChild("Humanoid", 10)
	if humanoid then
		humanoid.Died:Connect(function()
			if State.tpVoidActive then
				State.tpVoidDeathOffset = (State.tpVoidDeathOffset or 0) + 0.05
			end
		end)
	end
	if playerSettingsLoaded and humanoid then
		task.defer(function()
			if character ~= char or not humanoid then return end
			for _, name in ipairs({"Speed", "JumpPower", "Jump", "Scale"}) do
				local boxes = numericBoxes[name] or {}
				local value = boxes[1] and tonumber(boxes[1].Text) or nil
				applyNumeric(name, value)
			end
		end)
	end
	task.defer(function()
		for _, powerName in ipairs({"Locate", "AutoRotate", "Desanchore", "HidlePlayer", "SafeZone", "AutoRemovalofEntities"}) do
			syncUtilityPower(powerName)
		end
	end)
	bindLastSpawnDeath(char)
	local lastSpawnRecord = State.records.LastSpawnPosition
	if lastSpawnRecord and powerEnabled(lastSpawnRecord) and State.lastSpawnDeathCFrame then
		task.spawn(function()
			local root = char:WaitForChild("HumanoidRootPart", 10)
			if character == char and root and powerEnabled(lastSpawnRecord) and State.lastSpawnDeathCFrame then
				playLastSpawnRespawnEffect(char, State.lastSpawnDeathCFrame, previousRootCFrame)
			end
		end)
	end
	if State.tpVoidActive then
		task.defer(function()
			if character == char and getRoot() then
				createTpVoidPlatform()
				teleportToTpVoidCenter()
			end
		end)
	end
	if State.tpLongActive then
		State.tpLongActive = false
		task.defer(function()
			if character == char and getRoot() then
				startTpLong()
			end
		end)
	end
	if wasHitboxViewerActive then
		task.defer(startHitboxViewer)
	end
	if wasFlyMode then
		task.defer(function()
			if character == char then State.updateSpecialPowerStates() end
		end)
	end
	viewerNeedsBuild = true
	refreshAll()

	if player:HasAppearanceLoaded() then
		return
	end

	local waited = 0
	while not player:HasAppearanceLoaded() and waited < 10 do
		task.wait(0.2)
		waited = waited + 0.2
	end

	if character == char then
		viewerNeedsBuild = true
	end
end

