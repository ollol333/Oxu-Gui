local function toBytes(color)
	return math.floor(color.R * 255 + 0.5), math.floor(color.G * 255 + 0.5), math.floor(color.B * 255 + 0.5)
end

local function colorText(color)
	local r, g, b = toBytes(color)
	return string.format("Color: [%d,%d,%d]", r, g, b)
end

local function angleToHue(angle)
	if angle < 270 then
		return angle * 2 / 3
	end
	return 180 + (angle - 270) * 2
end

local function hueToAngle(hue)
	if hue < 180 then
		return hue * 1.5
	end
	return 270 + (hue - 180) / 2
end

local function paletteColor(u, v)
	local dx = (u - 0.5) * 2
	local dy = (v - 0.5) * 2
	local radius = math.min(math.sqrt(dx * dx + dy * dy), 1)
	if radius < 1e-4 then
		return Color3.new(1, 1, 1)
	end
	local angle = math.deg(math.atan2(dy, dx)) % 360
	return Color3.fromHSV(angleToHue(angle) / 360, radius, 1)
end

local function locateColor(color)
	local peak = math.max(color.R, color.G, color.B)
	if peak <= 0 then
		return nil
	end
	local normalized = Color3.new(color.R / peak, color.G / peak, color.B / peak)
	local hue, saturation = normalized:ToHSV()
	local angle = math.rad(hueToAngle(hue * 360))
	local u = 0.5 + 0.5 * saturation * math.cos(angle)
	local v = 0.5 + 0.5 * saturation * math.sin(angle)
	return u, v, 1 - peak
end

local function setBoxes(color)
	local r, g, b = toBytes(color)
	BoxRed.Text = tostring(r)
	BoxGreen.Text = tostring(g)
	BoxBlue.Text = tostring(b)
	BoxHtml.Text = "#" .. string.upper(color:ToHex())
end

local function placeKnobs(color)
	local u, v, t = locateColor(color)
	if u then
		colorU = u
		colorV = v
	end
	colorT = t or 1
	PaletteButton.Position = UDim2.new(colorU, 0, colorV, 0)
	TonalKnob.Position = UDim2.new(0.5, 0, colorT, 0)
end

local function commitColor(color)
	currentColor = color
	setBoxes(color)
	if activeColor then
		activeColor.write(color)
		activeColor.updateDisplay(color)
	end
end

local function applyEditor()
	local base = paletteColor(colorU, colorV)
	local factor = 1 - colorT
	local color = Color3.fromRGB(
		math.floor(base.R * factor * 255 + 0.5),
		math.floor(base.G * factor * 255 + 0.5),
		math.floor(base.B * factor * 255 + 0.5)
	)
	commitColor(color)
end

local function updateFromPointer(point)
	if not activeColor then return end
	if dragTarget == "palette" then
		local position = PaletteImage.AbsolutePosition
		local size = PaletteImage.AbsoluteSize
		colorU = math.clamp((point.X - position.X) / math.max(size.X, 1), 0, 1)
		colorV = math.clamp((point.Y - position.Y) / math.max(size.Y, 1), 0, 1)
		PaletteButton.Position = UDim2.new(colorU, 0, colorV, 0)
		applyEditor()
	elseif dragTarget == "tonal" then
		local position = TonalBar.AbsolutePosition
		local size = TonalBar.AbsoluteSize
		colorT = math.clamp((point.Y - position.Y) / math.max(size.Y, 1), 0, 1)
		TonalKnob.Position = UDim2.new(0.5, 0, colorT, 0)
		applyEditor()
	end
end

local function beginDrag(targetName, input)
	if not activeColor then return end
	dragTarget = targetName
	dragInput = input
	updateFromPointer(inputGuiPoint(input))
end

local function parseByte(text, fallback)
	local number = tonumber(text)
	if not number then
		return fallback
	end
	return math.clamp(math.floor(number + 0.5), 0, 255)
end

local function commitBoxes()
	if not activeColor then return end
	local r, g, b = toBytes(currentColor)
	local color = Color3.fromRGB(parseByte(BoxRed.Text, r), parseByte(BoxGreen.Text, g), parseByte(BoxBlue.Text, b))
	commitColor(color)
	placeKnobs(color)
end

local function commitHex()
	if not activeColor then return end
	local text = string.gsub(BoxHtml.Text, "%s", "")
	local ok, color = pcall(Color3.fromHex, text)
	if ok and color then
		commitColor(color)
		placeKnobs(color)
	else
		setBoxes(currentColor)
	end
end

deselectColor = function()
	local entry = activeColor
	if not entry then return end
	activeColor = nil
	dragTarget = nil
	dragInput = nil
	entry.textButton.TextColor3 = COLOR_TEXT_IDLE
	PaletteImage.ImageColor3 = PALETTE_OFF
	if HIDE_IDLE_PANELS then
		ColorPanel.Visible = false
	end
end

selectColor = function(entry)
	if activeColor == entry then
		deselectColor()
		return
	end
	deselectColor()
	activeColor = entry
	entry.textButton.TextColor3 = COLOR_TEXT_ACTIVE
	PaletteImage.ImageColor3 = PALETTE_ON
	if HIDE_IDLE_PANELS then
		ColorPanel.Visible = true
	end
	currentColor = entry.color
	placeKnobs(entry.color)
	setBoxes(entry.color)
end

local function clearOptions()
	for _, option in ipairs(optionButtons) do
		option.connection:Disconnect()
		option.button:Destroy()
	end
	table.clear(optionButtons)
end

paintOptions = function()
	local entry = activeSelection
	for _, option in ipairs(optionButtons) do
		local isCurrent = entry ~= nil and entry.value == option.item
		option.button.BackgroundTransparency = isCurrent and OPTION_ON or OPTION_OFF
	end
end

deselectSelection = function()
	local entry = activeSelection
	if not entry then return end
	activeSelection = nil
	entry.button.BackgroundTransparency = OPTION_OFF
	clearOptions()
	SeleccionsList.Text = ""
	if HIDE_IDLE_PANELS then
		SeleccionsList.Visible = false
	end
end

selectSelection = function(entry)
	if activeSelection == entry then
		deselectSelection()
		return
	end
	deselectSelection()
	activeSelection = entry
	entry.button.BackgroundTransparency = OPTION_ON
	SeleccionsList.Text = entry.name
	if HIDE_IDLE_PANELS then
		SeleccionsList.Visible = true
	end
	for index, item in ipairs(entry.enumType:GetEnumItems()) do
		local button = OptionTemplate:Clone()
		button.Name = "Option_" .. item.Name
		button.Text = item.Name
		button.LayoutOrder = index
		button.BackgroundTransparency = OPTION_OFF
		button.Visible = true
		button.Active = true
		button.Interactable = true
		button.Parent = OptionsHolder
		local connection = button.Activated:Connect(function()
			entry.write(item)
			entry.refresh()
			paintOptions()
		end)
		table.insert(optionButtons, { button = button, item = item, connection = connection })
	end
	paintOptions()
end

local function newRow(template, name, order)
	local frame = template:Clone()
	frame.Name = string.format("Prop_%03d_%s", order, name)
	frame.LayoutOrder = order
	frame.Visible = true
	local label = frame:FindFirstChild("NamePropiedad", true)
	if label then
		label.Text = name
	end
	return frame
end

local function makeBoolEntry(panel, target, name, order)
	local frame = newRow(panel.templates.bool, name, order)
	local button = frame:FindFirstChild("TrueOrFalseButton", true)
	local entry = { name = name, frame = frame, connections = {}, value = false, panel = panel }
	entry.refresh = function()
		local value = readProp(target, name)
		if value == nil then return end
		entry.value = value
		button.BackgroundTransparency = 0
		if value then
			button.Text = "✓"
			button.TextColor3 = CHECK_ON_TEXT
			button.BackgroundColor3 = panel.checkOnBackground
		else
			button.Text = ""
			button.BackgroundColor3 = CHECK_OFF_BG
		end
	end
	table.insert(entry.connections, button.Activated:Connect(function()
		userSet(target, name, entry.value ~= true)
		entry.refresh()
	end))
	return entry
end

local function makeColorEntry(panel, target, name, order)
	local frame = newRow(panel.templates.color, name, order)
	local colorButton = frame:FindFirstChild("ButtonColor", true)
	local textButton = frame:FindFirstChild("TextColorButton", true)
	local entry = {
		name = name,
		frame = frame,
		connections = {},
		colorButton = colorButton,
		textButton = textButton,
		color = Color3.new(1, 1, 1),
		panel = panel,
	}
	textButton.TextColor3 = COLOR_TEXT_IDLE
	entry.write = function(color)
		userSet(target, name, color)
	end
	entry.updateDisplay = function(color)
		entry.color = color
		colorButton.BackgroundColor3 = color
		textButton.Text = colorText(color)
	end
	entry.refresh = function()
		local value = readProp(target, name)
		if value == nil then return end
		entry.color = value
		colorButton.BackgroundColor3 = value
		textButton.Text = colorText(value)
	end
	local function toggle()
		selectColor(entry)
	end
	table.insert(entry.connections, textButton.Activated:Connect(toggle))
	table.insert(entry.connections, colorButton.Activated:Connect(toggle))
	return entry
end

local function makeEnumEntry(panel, target, name, order)
	local frame = newRow(panel.templates.enum, name, order)
	local button = frame:FindFirstChild("TextMultipleSelection", true)
	local first = readProp(target, name)
	local entry = {
		name = name,
		frame = frame,
		connections = {},
		button = button,
		enumType = first.EnumType,
		value = first,
		panel = panel,
	}
	button.BackgroundTransparency = OPTION_OFF
	entry.write = function(item)
		userSet(target, name, item)
	end
	entry.refresh = function()
		local value = readProp(target, name)
		if value == nil then return end
		entry.value = value
		button.Text = value.Name
		if activeSelection == entry then
			paintOptions()
		end
	end
	table.insert(entry.connections, button.Activated:Connect(function()
		selectSelection(entry)
	end))
	return entry
end

local function makeTextEntry(panel, target, name, order)
	local frame = newRow(panel.templates.text, name, order)
	local box = frame:FindFirstChild("Value", true)
	local entry = { name = name, frame = frame, connections = {}, shown = nil, panel = panel }
	box.ClearTextOnFocus = false
	entry.refresh = function()
		if box:IsFocused() then return end
		local value = readProp(target, name)
		if value == nil then return end
		local text = serializeValue(value)
		if text ~= entry.shown or box.Text ~= text then
			entry.shown = text
			box.Text = text
		end
	end
	table.insert(entry.connections, box.FocusLost:Connect(function()
		if box.Text ~= entry.shown then
			local current = readProp(target, name)
			local ok, parsed = pcall(parseValue, box.Text, current)
			if ok and parsed ~= nil then
				userSet(target, name, parsed)
			end
		end
		entry.shown = nil
		entry.refresh()
	end))
	return entry
end

local ROW_MAKERS = {
	bool = makeBoolEntry,
	color = makeColorEntry,
	enum = makeEnumEntry,
	text = makeTextEntry,
}

local function loadTemplates(list)
	local templates = {
		bool = waitDeep(list, "MarcPropiedadValueCasilla", "Frame"),
		color = waitDeep(list, "MarcPropiedadValueColor", "Frame"),
		enum = waitDeep(list, "MarcPropiedadValueSeleccions", "Frame"),
		text = waitDeep(list, "MarcPropiedadValueTxt", "Frame"),
	}
	for _, template in pairs(templates) do
		template.Visible = false
	end
	return templates
end

local function availableProps(target)
	local source = sourceOf(target)
	local result = {}
	for _, name in ipairs(target.props) do
		local ok, value = pcall(function()
			return source[name]
		end)
		if ok then
			local kind = KIND_BY_TYPE[typeof(value)]
			if kind then
				table.insert(result, { name = name, kind = kind })
			end
		end
	end
	return result
end

local function createPanel(list, searchBox)
	local panel = {
		list = list,
		target = nil,
		entries = {},
		query = "",
		templates = loadTemplates(list),
	}

	local checkButton = waitDeep(panel.templates.bool, "TrueOrFalseButton", "TextButton")
	panel.checkOnBackground = checkButton.BackgroundColor3
	if panel.checkOnBackground == CHECK_OFF_BG then
		panel.checkOnBackground = CHECK_ON_BG
	end

	if not list:FindFirstChildOfClass("UIListLayout") then
		local layout = Instance.new("UIListLayout")
		layout.SortOrder = Enum.SortOrder.LayoutOrder
		layout.Parent = list
	end

	function panel.applyFilter()
		for _, entry in ipairs(panel.entries) do
			local show = panel.query == "" or string.find(entry.lower, panel.query, 1, true) ~= nil
			if entry.frame.Visible ~= show then
				entry.frame.Visible = show
			end
		end
	end

	function panel.setQuery(text)
		panel.query = string.lower(string.match(text, "^%s*(.-)%s*$") or "")
		panel.applyFilter()
	end

	function panel.clear()
		if activeColor and activeColor.panel == panel then
			deselectColor()
		end
		if activeSelection and activeSelection.panel == panel then
			deselectSelection()
		end
		for _, entry in ipairs(panel.entries) do
			for _, connection in ipairs(entry.connections) do
				connection:Disconnect()
			end
			entry.frame:Destroy()
		end
		table.clear(panel.entries)
	end

	function panel.rebuild(target)
		panel.clear()
		panel.target = target
		if not target then return end
		for index, definition in ipairs(availableProps(target)) do
			local entry = ROW_MAKERS[definition.kind](panel, target, definition.name, index)
			entry.lower = string.lower(definition.name)
			entry.frame.Parent = list
			entry.refresh()
			table.insert(panel.entries, entry)
		end
		panel.applyFilter()
	end

	function panel.refresh()
		for _, entry in ipairs(panel.entries) do
			if entry ~= activeColor then
				entry.refresh()
			end
		end
	end

	searchBox:GetPropertyChangedSignal("Text"):Connect(function()
		panel.setQuery(searchBox.Text)
	end)

	return panel
end

