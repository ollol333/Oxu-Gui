function updateClickTeleportMarker()
	local record = State.records.ClickTeleport
	if not (record and powerEnabled(record) and getRoot()) then
		clearClickTeleportMarker()
		return
	end
	if not State.clickTeleportMarker or not State.clickTeleportMarker.Parent then
		State.clickTeleportMarker = createMarkerPart("ClickTeleportMarker", getRoot().CFrame, 1)
		local attachment = Instance.new("Attachment")
		attachment.Name = "AttachVFX"
		attachment.Parent = State.clickTeleportMarker
		createAirEmitter(attachment, 25)
		createEmitter(attachment, "Core1", {
			Texture = "rbxassetid://1084982817", Brightness = 5, LightEmission = 1, LightInfluence = 0,
			Color = Color3.fromRGB(255,255,255), Size = NumberSequence.new(0.5), Lifetime = NumberRange.new(0.3),
			Rate = 150, Rotation = NumberRange.new(0), RotSpeed = NumberRange.new(0), Speed = NumberRange.new(0.001),
			SpreadAngle = Vector2.new(0,0),
		})
	end
	local camera = workspace.CurrentCamera
	if not camera then return end
	local mouse = UserInputService:GetMouseLocation()
	local ray = camera:ViewportPointToRay(mouse.X, mouse.Y)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = {character, State.clickTeleportMarker}
	params.IgnoreWater = true
	local result = workspace:Raycast(ray.Origin, ray.Direction * 5000, params)
	if result then
		local point = resolveTeleportPoint(result, params)
		State.clickTeleportMarker.CFrame = CFrame.new(point + Vector3.new(0,0.05,0))
	else
		State.clickTeleportMarker.CFrame = getRoot().CFrame
	end
end

function teleportRoot(targetCFrame)
