RunService.Heartbeat:Connect(function(dt)
	if not antiFlyingEnabled() or not humanoid or humanoid.Health <= 0 then
		State.antiFlyingJumpStartY = nil
		State.antiFlyingUpwardTime = 0
		return
	end
	local root = getRoot()
	if not root then return end
	local state = humanoid:GetState()
	if humanoid.FloorMaterial ~= Enum.Material.Air then
		State.antiFlyingJumpStartY = root.Position.Y
		State.antiFlyingUpwardTime = 0
		return
	end
	if not State.antiFlyingJumpStartY then
		State.antiFlyingJumpStartY = root.Position.Y
	end
	local velocity = root.AssemblyLinearVelocity
	if velocity.Y > 8 then
		State.antiFlyingUpwardTime += dt
	else
		State.antiFlyingUpwardTime = math.max(0, State.antiFlyingUpwardTime - dt * 2)
	end
	if velocity.Y > 65 or root.Position.Y > State.antiFlyingJumpStartY + 20 or State.antiFlyingUpwardTime > 1.2 then
		root.AssemblyLinearVelocity = Vector3.new(velocity.X, math.min(velocity.Y, 0), velocity.Z)
		if root.Position.Y > State.antiFlyingJumpStartY + 20 then
			State.antiFlyingJumpStartY = root.Position.Y - 20
		end
		State.antiFlyingUpwardTime = 0
	end
end)

function clickTeleport(input)
	local record = State.records.ClickTeleport
	if not (record and powerEnabled(record)) then
		return
	end

	local root = getRoot()
	local camera = workspace.CurrentCamera
	if not (root and camera and character) then
		return
	end

	local ray
	if input.UserInputType == Enum.UserInputType.Touch then
		ray = camera:ScreenPointToRay(input.Position.X, input.Position.Y)
	else
		local mouse = UserInputService:GetMouseLocation()
		ray = camera:ViewportPointToRay(mouse.X, mouse.Y)
	end

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character }
	params.IgnoreWater = true

	local result = workspace:Raycast(ray.Origin, ray.Direction * 5000, params)
	if not result then
		return
	end

	local point = resolveTeleportPoint(result, params)
	local boxCFrame, boxSize = character:GetBoundingBox()
	local feetOffset = root.Position.Y - (boxCFrame.Position.Y - boxSize.Y / 2)

	teleportRoot(CFrame.new(point.X, point.Y + feetOffset + 0.1, point.Z) * root.CFrame.Rotation)
	flashBinder(record.binders.toggle)
end

local readPromptKey

function createPromptTeleportPosition(record, binder)
	if not masterOn(record) then return end
	local root = getRoot()
	if not root then return end
	local frame = record.frame
	local nameBox = findIn(frame, "NameButton", "TextBox") or findIn(frame, "NameButton", "TextLabel") or findIn(frame, "NameButton", "TextButton")
	local promptName = nameBox and string.match(nameBox.Text or "", "^%s*(.-)%s*$") or ""
	if promptName == "" then promptName = "TP" end
	local targetCFrame = root.CFrame
	local marker = createMarkerPart("PromptTeleportPosition", targetCFrame * CFrame.new(0, -2, 0), 1)
	createSaveLoadDecoration(marker)
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "PromptTeleportPositionPrompt"
	prompt.ActionText = "Teleport"
	prompt.ObjectText = promptName
	prompt.HoldDuration = 0
	local distanceSet = pcall(function() prompt.MaxActivationDistance = math.huge end)
	if not distanceSet or prompt.MaxActivationDistance ~= math.huge then
		prompt.MaxActivationDistance = 1000000000
	end
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = readPromptKey(findIn(frame, "KeyActivationPrompt", "TextBox")) or Enum.KeyCode.E
	prompt.Enabled = masterOn(record)
	prompt.Parent = marker
	local entry = { part = marker, prompt = prompt, cframe = targetCFrame }
	table.insert(State.promptTeleportParts, entry)
	prompt.Triggered:Connect(function()
		if masterOn(record) and prompt.Enabled and entry.cframe then
			teleportRoot(entry.cframe)
		end
	end)
	flashBinder(binder)
end

function deleteLastPromptTeleportPosition(record, binder)
	local entry = table.remove(State.promptTeleportParts)
	if entry then
		if entry.prompt then entry.prompt:Destroy() end
		if entry.part then entry.part:Destroy() end
		flashBinder(binder)
	end
end

function makeBinder(name, role, record, button)
	local binder = {
		button = button,
		stroke = button:FindFirstChildOfClass("UIStroke"),
		key = nil,
