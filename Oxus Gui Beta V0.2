function createEmitter(parent, name, config)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = name
	emitter.Texture = config.Texture or ""
	emitter.Brightness = config.Brightness or 1
	emitter.LightEmission = config.LightEmission or 0
	emitter.LightInfluence = config.LightInfluence or 0
	emitter.Color = ColorSequence.new(config.Color or Color3.new(1, 1, 1))
	emitter.Size = config.Size or NumberSequence.new(1)
	emitter.Transparency = config.Transparency or NumberSequence.new(0)
	emitter.Lifetime = config.Lifetime or NumberRange.new(1)
	emitter.Rate = config.Rate or 0
	emitter.Rotation = config.Rotation or NumberRange.new(0)
	emitter.RotSpeed = config.RotSpeed or NumberRange.new(0)
	emitter.Speed = config.Speed or NumberRange.new(0.001)
	emitter.SpreadAngle = config.SpreadAngle or Vector2.new(0, 0)
	emitter.ZOffset = config.ZOffset or 0
	if config.Orientation then
		emitter.Orientation = config.Orientation
	end
	emitter.Squash = config.Squash or NumberSequence.new(0)
	if config.Flipbook then
		emitter.FlipbookLayout = Enum.ParticleFlipbookLayout.Grid4x4
		emitter.FlipbookMode = Enum.ParticleFlipbookMode.OneShot
		emitter.FlipbookStartRandom = false
		emitter.FlipbookFramerate = NumberRange.new(0)
		pcall(function() emitter.FlipbookBlendFrames = true end)
	end
	emitter.Parent = parent
	return emitter
end

